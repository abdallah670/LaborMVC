@model LaborBLL.ModelVM.UserProfileDisplayViewModel
@{
    ViewData["Title"] = "User Details";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="admin-user-details fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-person-badge me-2"></i>User Details</h2>
            <p class="text-muted mb-0">View detailed user information</p>
        </div>
        <a asp-action="Users" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i>Back to Users
        </a>
    </div>

    <div class="row g-4">
        <!-- User Profile Card -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <!-- Profile Picture -->
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="Profile" class="rounded-circle mb-3" style="width: 120px; height: 120px; object-fit: cover; border: 3px solid var(--primary-color);">
                    }
                    else
                    {
                        <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 120px; height: 120px; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; font-size: 2.5rem; font-weight: 600;">
                            @(Model.FirstName?.FirstOrDefault())@(Model.LastName?.FirstOrDefault())
                        </div>
                    }

                    <h4 class="mb-1">@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted mb-3">@Model.Email</p>

                    <!-- Role Badges -->
                    <div class="mb-3">
                        @if (Model.IsAdmin)
                        {
                            <span class="badge bg-danger me-1"><i class="bi bi-shield-fill me-1"></i>Admin</span>
                        }
                        @if (Model.IsWorker)
                        {
                            <span class="badge bg-primary me-1"><i class="bi bi-tools me-1"></i>Worker</span>
                        }
                        @if (Model.IsPoster)
                        {
                            <span class="badge bg-success me-1"><i class="bi bi-clipboard-plus me-1"></i>Poster</span>
                        }
                    </div>

                    <!-- Verification Status -->
                    <div class="mb-3">
                        @if (Model.IDVerified)
                        {
                            <span class="badge bg-success"><i class="bi bi-patch-check-fill me-1"></i>ID Verified</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-exclamation-triangle me-1"></i>Not Verified</span>
                        }
                    </div>

                    <!-- Rating -->
                    <div class="mb-3">
                        @if (Model.AverageRating.HasValue)
                        {
                            <div class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= Math.Round(Model.AverageRating.Value) ? "-fill" : "")"></i>
                                }
                                <span class="ms-2 text-dark">@Model.AverageRating.Value.ToString("0.0")</span>
                            </div>
                            <small class="text-muted">(@Model.TotalRatingsCount reviews)</small>
                        }
                        else
                        {
                            <span class="text-muted">No ratings yet</span>
                        }
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2">
                        <a asp-action="EditRoles" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-person-gear me-1"></i>Edit Roles
                        </a>
                        @if (Model.Id != currentUserId && !Model.IsAdmin)
                        {
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-user-id="@Model.Id" data-user-name="@Model.FirstName @Model.LastName">
                                <i class="bi bi-trash me-1"></i>Delete User
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- User Information -->
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Contact Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Email</label>
                            <p class="mb-0">
                                <i class="bi bi-envelope me-2"></i>@Model.Email
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Phone</label>
                            <p class="mb-0">
                                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                {
                                    <i class="bi bi-telephone me-2"></i>@Model.PhoneNumber
                                }
                                else
                                {
                                    <span class="text-muted">Not provided</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Location</label>
                            <p class="mb-0">
                                @if (!string.IsNullOrEmpty(Model.Location))
                                {
                                    <i class="bi bi-geo-alt me-2"></i>@Model.Location
                                }
                                else
                                {
                                    <span class="text-muted">Not provided</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Country</label>
                            <p class="mb-0">
                                @if (!string.IsNullOrEmpty(Model.Country))
                                {
                                    <i class="bi bi-globe me-2"></i>@Model.Country
                                }
                                else
                                {
                                    <span class="text-muted">Not provided</span>
                                }
                            </p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.LocationUrl))
                        {
                            <div class="col-12">
                                <label class="text-muted small">Location URL</label>
                                <p class="mb-0">
                                    <a href="@Model.LocationUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-map me-1"></i>View on Map
                                    </a>
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Bio & Skills -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>About</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small">Bio</label>
                        <p class="mb-0">
                            @if (!string.IsNullOrEmpty(Model.Bio))
                            {
                                @Model.Bio
                            }
                            else
                            {
                                <span class="text-muted">No bio provided</span>
                            }
                        </p>
                    </div>
                    <div>
                        <label class="text-muted small">Skills</label>
                        <div>
                            @if (!string.IsNullOrEmpty(Model.Skills))
                            {
                                var skills = Model.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries);
                                @foreach (var skill in skills)
                                {
                                    <span class="badge bg-light text-dark me-1 mb-1">@skill.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">No skills listed</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Information -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Account Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Member Since</label>
                            <p class="mb-0">
                                <i class="bi bi-calendar me-2"></i>@Model.MemberSince.ToString("MMMM dd, yyyy")
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">User ID</label>
                            <p class="mb-0">
                                @Model.Id
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Health Panel -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-shield-exclamation me-2"></i>Account Health</h5>
                    @{
                        var healthBadgeClass = Model.AccountHealthStatus switch
                        {
                            "Critical" => "bg-danger",
                            "Warning" => "bg-warning",
                            "Suspended" => "bg-dark",
                            _ => "bg-success"
                        };
                    }
                    <span class="badge @healthBadgeClass">@Model.AccountHealthStatus</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="text-center p-3 border rounded">
                                <h4 class="@(Model.ActiveStrikes > 0 ? "text-danger" : "text-success") mb-1">@Model.ActiveStrikes</h4>
                                <small class="text-muted">Active Strikes</small>
                                @if (Model.ActiveStrikes >= 2)
                                {
                                    <div class="text-danger small mt-1"><i class="bi bi-exclamation-triangle"></i> Near suspension</div>
                                }
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 border rounded">
                                <h4 class="@(Model.NoShowCount > 0 ? "text-warning" : "text-success") mb-1">@Model.NoShowCount</h4>
                                <small class="text-muted">No-Shows</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 border rounded">
                                <h4 class="@(Model.RecentCancellations > 2 ? "text-warning" : "text-muted") mb-1">@Model.RecentCancellations</h4>
                                <small class="text-muted">Cancellations (30d)</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 border rounded">
                                <h4 class="@(Model.UnacknowledgedPenalties > 0 ? "text-warning" : "text-success") mb-1">@Model.UnacknowledgedPenalties</h4>
                                <small class="text-muted">Unacknowledged</small>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Suspended</span>
                                <span class="@(Model.IsSuspended ? "text-danger fw-bold" : "text-muted")">
                                    @(Model.IsSuspended ? "Yes" : "No")
                                    @if (Model.SuspensionEndDate.HasValue)
                                    {
                                        <span class="small"> (until @Model.SuspensionEndDate.Value.ToString("MMM dd"))</span>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Posting Restricted</span>
                                <span class="@(Model.IsPostingRestricted ? "text-warning fw-bold" : "text-success")">
                                    @(Model.IsPostingRestricted ? "Yes" : "No")
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Acceptance Restricted</span>
                                <span class="@(Model.IsAcceptanceRestricted ? "text-warning fw-bold" : "text-success")">
                                    @(Model.IsAcceptanceRestricted ? "Yes" : "No")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Admin Actions -->
                    <div class="mt-3 pt-3 border-top">
                        <h6 class="mb-2"><i class="bi bi-gear me-1"></i>Admin Actions</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#strikeModal">
                                <i class="bi bi-exclamation-circle me-1"></i>Add Strike
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#suspendModal">
                                <i class="bi bi-pause-circle me-1"></i>Suspend
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#restrictPostingModal">
                                <i class="bi bi-slash-circle me-1"></i>Restrict Posting
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#restrictAcceptanceModal">
                                <i class="bi bi-x-circle me-1"></i>Restrict Acceptance
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Penalty History -->
            @if (Model.PenaltyHistory != null && Model.PenaltyHistory.Any())
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Penalty History</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Severity</th>
                                        <th>Reason</th>
                                        <th>Expires</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var penalty in Model.PenaltyHistory.OrderByDescending(p => p.AppliedAt))
                                    {
                                        <tr>
                                            <td class="small">@penalty.AppliedAt.ToString("MMM dd, yyyy")</td>
                                            <td><span class="badge bg-secondary">@penalty.Type</span></td>
                                            <td><span class="badge bg-@(penalty.Severity == "Severe" ? "danger" : penalty.Severity == "Moderate" ? "warning" : "info")">@penalty.Severity</span></td>
                                            <td class="small">@penalty.Reason</td>
                                            <td class="small">@(penalty.ExpiresAt?.ToString("MMM dd, yyyy") ?? "-")</td>
                                            <td>
                                                @if (penalty.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Expired</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!penalty.IsAcknowledged)
                                                {
                                                    <form asp-action="AcknowledgePenalty" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="penaltyId" value="@penalty.Id" />
                                                        <input type="hidden" name="userId" value="@Model.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success">Acknowledge</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Worker Statistics -->
            @if (Model.IsWorker)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Worker Statistics</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="text-center">
                                    <h3 class="text-primary mb-1">@Model.CompletedJobsAsWorker</h3>
                                    <small class="text-muted">Completed Jobs</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-center">
                                    <h3 class="text-success mb-1">$@Model.TotalEarnings.ToString("N2")</h3>
                                    <small class="text-muted">Total Earnings</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-center">
                                    <h3 class="text-warning mb-1">@Model.TotalRatingsCount</h3>
                                    <small class="text-muted">Total Reviews</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Poster Statistics -->
            @if (Model.IsPoster)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-clipboard-plus me-2"></i>Poster Statistics</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="text-center">
                                    <h3 class="text-primary mb-1">@Model.TasksPosted</h3>
                                    <small class="text-muted">Tasks Posted</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-center">
                                    <h3 class="text-info mb-1">@Model.TotalHires</h3>
                                    <small class="text-muted">Total Hires</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-center">
                                    <h3 class="text-danger mb-1">$@Model.TotalSpent.ToString("N2")</h3>
                                    <small class="text-muted">Total Spent</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Ratings List -->
            @if (Model.RecentRatings != null && Model.RecentRatings.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-star me-2"></i>Recent Reviews</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var rating in Model.RecentRatings.OrderByDescending(r => r.CreatedAt).Take(10))
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-warning mb-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi bi-star@(i <= rating.Score ? "-fill" : "")"></i>
                                            }
                                            <span class="ms-2 text-dark">@rating.Score.ToString("0.0")</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(rating.comment))
                                        {
                                            <p class="mb-1">@rating.comment</p>
                                        }
                                        <small class="text-muted">
                                            <a href="@Url.Action("ProfilePoster", "Booking", new { id = rating.RaterId })">From User</a>
                                            • @rating.CreatedAt.ToString("MMM dd, yyyy")
                                        </small>
                                    </div>
                                    <a href="@Url.Action("Details", "Booking", new { id = rating.bookingId })" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-link-45deg"></i> Booking
                                    </a>
                                </div>
                            </div>
                        }
                        @if (Model.TotalRatingsCount > 10)
                        {
                            <p class="text-muted text-center mb-0">
                                And @((Model.TotalRatingsCount - 10)) more reviews...
                            </p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the user <strong id="deleteUserName"></strong>?</p>
                <p class="text-muted small mb-0">This action will soft-delete the user account. The user will no longer be able to access the system.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" asp-action="DeleteUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteUserId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete User
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Strike Modal -->
<div class="modal fade" id="strikeModal" tabindex="-1" aria-labelledby="strikeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="strikeModalLabel"><i class="bi bi-exclamation-circle me-2"></i>Add Strike</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddStrike" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Reason for strike</label>
                        <input type="text" name="reason" class="form-control" required placeholder="e.g., No-show, Late cancellation" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Related Task ID (optional)</label>
                        <input type="number" name="taskId" class="form-control" placeholder="Task ID" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Add Strike</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Suspend Modal -->
<div class="modal fade" id="suspendModal" tabindex="-1" aria-labelledby="suspendModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark">
                <h5 class="modal-title" id="suspendModalLabel"><i class="bi bi-pause-circle me-2"></i>Suspend User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SuspendUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Suspension Duration (days)</label>
                        <select name="days" class="form-select">
                            <option value="1">1 day</option>
                            <option value="3">3 days</option>
                            <option value="7" selected>7 days</option>
                            <option value="14">14 days</option>
                            <option value="30">30 days</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason for suspension</label>
                        <input type="text" name="reason" class="form-control" required placeholder="Reason for suspension" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Suspend User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Restrict Posting Modal -->
<div class="modal fade" id="restrictPostingModal" tabindex="-1" aria-labelledby="restrictPostingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger">
                <h5 class="modal-title" id="restrictPostingModalLabel"><i class="bi bi-slash-circle me-2"></i>Restrict Posting</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RestrictPosting" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Restriction Duration (days)</label>
                        <select name="days" class="form-select">
                            <option value="7" selected>7 days</option>
                            <option value="14">14 days</option>
                            <option value="30">30 days</option>
                            <option value="60">60 days</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason for restriction</label>
                        <input type="text" name="reason" class="form-control" required placeholder="Reason for restriction" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Restrict Posting</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Restrict Acceptance Modal -->
<div class="modal fade" id="restrictAcceptanceModal" tabindex="-1" aria-labelledby="restrictAcceptanceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="restrictAcceptanceModalLabel"><i class="bi bi-x-circle me-2"></i>Restrict Task Acceptance</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RestrictAcceptance" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Restriction Duration (days)</label>
                        <select name="days" class="form-select">
                            <option value="7" selected>7 days</option>
                            <option value="14">14 days</option>
                            <option value="30">30 days</option>
                            <option value="60">60 days</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason for restriction</label>
                        <input type="text" name="reason" class="form-control" required placeholder="Reason for restriction" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Restrict Acceptance</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var userId = button.getAttribute('data-user-id');
            var userName = button.getAttribute('data-user-name');
            
            document.getElementById('deleteUserId').value = userId;
            document.getElementById('deleteUserName').textContent = userName;
        });
    </script>
}
