@model IEnumerable<LaborDAL.Entities.IDVerification>
@using LaborDAL.Enums

@{
    ViewData["Title"] = "ID Verifications";
    var currentFilter = ViewBag.CurrentFilter as string ?? "pending";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-id-card me-2"></i>ID Verifications
        </h2>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Pending</h6>
                            <h3 class="mb-0">@ViewBag.PendingCount</h3>
                        </div>
                        <i class="fas fa-clock fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Approved</h6>
                            <h3 class="mb-0">@ViewBag.ApprovedCount</h3>
                        </div>
                        <i class="fas fa-check-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Rejected</h6>
                            <h3 class="mb-0">@ViewBag.RejectedCount</h3>
                        </div>
                        <i class="fas fa-times-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="IdVerifications" method="get" class="row g-3">
                <input type="hidden" name="filter" value="@currentFilter" />
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" 
                               placeholder="Search by name, email, document number or User ID..." 
                               value="@ViewBag.SearchTerm">
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                {
                    <div class="col-12">
                        <a href="@Url.Action("IdVerifications", new { filter = currentFilter })" class="text-muted small">
                            <i class="fas fa-times-circle me-1"></i>Clear search results
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == "pending" ? "active" : "")" href="@Url.Action("IdVerifications", new { filter = "pending", search = ViewBag.SearchTerm })">
                        <i class="fas fa-clock me-1"></i> Pending
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == "approved" ? "active" : "")" href="@Url.Action("IdVerifications", new { filter = "approved", search = ViewBag.SearchTerm })">
                        <i class="fas fa-check-circle me-1"></i> Approved
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == "rejected" ? "active" : "")" href="@Url.Action("IdVerifications", new { filter = "rejected", search = ViewBag.SearchTerm })">
                        <i class="fas fa-times-circle me-1"></i> Rejected
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No @currentFilter verifications found</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Document Type</th>
                                <th>Document Number</th>
                                <th>Country</th>
                                <th>Submitted</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        <a href="@Url.Action("UserDetails", new { id = item.UserId })" class="text-decoration-none fw-bold">
                                            @(item.User != null ? $"{item.User.FirstName} {item.User.LastName}" : item.UserId)
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@item.DocumentType</span>
                                    </td>
                                    <td>@item.DocumentNumber</td>
                                    <td>@item.DocumentCountry</td>
                                    <td>@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case VerificationStatus.Pending:
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case VerificationStatus.InReview:
                                                <span class="badge bg-info">In Review</span>
                                                break;
                                            case VerificationStatus.Approved:
                                                <span class="badge bg-success">Approved</span>
                                                break;
                                            case VerificationStatus.Rejected:
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("ReviewIdVerification", new { id = item.Id })" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye me-1"></i>Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
