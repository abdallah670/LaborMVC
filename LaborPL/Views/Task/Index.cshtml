@model LaborBLL.ModelVM.TaskSearchViewModel
@using LaborDAL.Enums
@{
    ViewData["Title"] = "Browse Tasks";
}

@section Scripts {
    <script src="~/js/locationService.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchForm = document.getElementById('taskSearchForm');
            const locationInput = document.getElementById('locationInput');
            const latitudeInput = document.getElementById('latitudeInput');
            const longitudeInput = document.getElementById('longitudeInput');
            const radiusInput = document.getElementById('radiusInput');
            
            searchForm.addEventListener('submit', async function(e) {
                const location = locationInput.value.trim();
                if (location && !latitudeInput.value && !longitudeInput.value) {
                    e.preventDefault();
                    try {
                        const result = await LocationService.geocode(location);
                        if (result.success) {
                            latitudeInput.value = result.latitude;
                            longitudeInput.value = result.longitude;
                        }
                    } catch (error) { console.error('Geocoding error:', error); }
                    searchForm.submit();
                }
            });
            
            locationInput.addEventListener('input', function() {
                latitudeInput.value = '';
                longitudeInput.value = '';
            });
        });
    </script>
}

<div class="dashboard-container fade-in py-4">
    <div class="lm-dashboard-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="lm-dashboard-title">Explore Opportunities</h1>
            <p class="text-muted mb-0">Find the perfect task that matches your skills and location.</p>
        </div>
        @if (User.IsInRole("Poster") || User.IsInRole("Both"))
        {
            <a asp-action="Create" class="btn btn-primary lg shadow-sm px-4">
                <i class="bi bi-plus-circle me-2"></i>Post a Task
            </a>
        }
    </div>

    <!-- Modern Search Card -->
    <div class="lm-card mb-4 p-4">
        <form id="taskSearchForm" asp-action="Index" method="get">
            <input type="hidden" id="latitudeInput" name="Latitude" value="@Model.Latitude">
            <input type="hidden" id="longitudeInput" name="Longitude" value="@Model.Longitude">
            
            <div class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label smaller fw-bold text-muted text-uppercase mb-2">Search Query</label>
                    <div class="input-group lm-input-group border rounded-3 overflow-hidden">
                        <span class="input-group-text bg-white border-0 ps-3"><i class="bi bi-search text-primary"></i></span>
                        <input type="text" name="Keyword" class="form-control border-0 bg-white py-2" placeholder="What are you looking for?" value="@Model.Keyword">
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <label class="form-label smaller fw-bold text-muted text-uppercase mb-2">Category</label>
                    <select name="Category" class="form-select lm-form-select border rounded-3 py-2">
                        <option value="">All Disciplines</option>
                        @foreach (TaskCategory category in Enum.GetValues(typeof(TaskCategory)))
                        {
                            <option value="@((int)category)" selected="@(Model.Category == category ? "selected" : null)">
                                @category.ToString()
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label smaller fw-bold text-muted text-uppercase mb-2">Location Strategy</label>
                    <div class="input-group lm-input-group border rounded-3 overflow-hidden">
                        <span class="input-group-text bg-white border-0 ps-3"><i class="bi bi-geo-alt text-success"></i></span>
                        <input type="text" id="locationInput" name="Location" class="form-control border-0 bg-white py-2" placeholder="City or Zip Code" value="@Model.Location">
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                        <i class="bi bi-funnel me-2"></i>Apply Filters
                    </button>
                </div>
            </div>

            <div class="collapse mt-3" id="advancedFilters">
                <div class="row g-3 pt-3 border-top border-dashed">
                    <div class="col-md-3 col-6">
                        <label class="form-label smaller fw-bold text-muted text-uppercase mb-2">Min Budget</label>
                        <div class="input-group lm-input-group border rounded-3 overflow-hidden">
                            <span class="input-group-text bg-white border-0 ps-3 fs-xs">$</span>
                            <input type="number" name="MinBudget" class="form-control border-0 bg-white py-2" placeholder="0" value="@Model.MinBudget">
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label smaller fw-bold text-muted text-uppercase mb-2">Max Budget</label>
                        <div class="input-group lm-input-group border rounded-3 overflow-hidden">
                            <span class="input-group-text bg-white border-0 ps-3 fs-xs">$</span>
                            <input type="number" name="MaxBudget" class="form-control border-0 bg-white py-2" placeholder="Any" value="@Model.MaxBudget">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label smaller fw-bold text-muted text-uppercase mb-2">Sort Order</label>
                        <select name="SortBy" class="form-select lm-form-select border rounded-3 py-2">
                            <option value="newest" selected="@(Model.SortBy == "newest" ? "selected" : null)">Newest Listed</option>
                            <option value="budget_high" selected="@(Model.SortBy == "budget_high" ? "selected" : null)">Highest Payout</option>
                            <option value="budget_low" selected="@(Model.SortBy == "budget_low" ? "selected" : null)">Lowest Payout</option>
                            <option value="distance" selected="@(Model.SortBy == "distance" ? "selected" : null)">Nearest First</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label smaller fw-bold text-muted text-uppercase mb-2">Distance (km)</label>
                        <input type="number" id="radiusInput" name="RadiusKm" class="form-control border rounded-3 py-2" placeholder="Any range" value="@Model.RadiusKm">
                    </div>
                </div>
                
                <div class="d-flex gap-4 mt-3">
                    <div class="form-check lm-filter-check">
                        <input class="form-check-input" type="checkbox" name="IsRemote" id="remoteCheck" value="true" @(Model.IsRemote == true ? "checked" : "")>
                        <label class="form-check-label smaller fw-bold text-muted" for="remoteCheck">Remote Only</label>
                    </div>
                    <div class="form-check lm-filter-check">
                        <input class="form-check-input" type="checkbox" name="IsUrgent" id="urgentCheck" value="true" @(Model.IsUrgent == true ? "checked" : "")>
                        <label class="form-check-label smaller fw-bold text-muted" for="urgentCheck">Urgent Tasks</label>
                    </div>
                </div>
            </div>

            <div class="text-center mt-3">
                <button class="btn btn-link text-muted smaller fw-bold text-decoration-none p-0" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                    <span class="show-text">More Filters <i class="bi bi-chevron-down ms-1"></i></span>
                    <span class="hide-text d-none">Fewer Filters <i class="bi bi-chevron-up ms-1"></i></span>
                </button>
            </div>
        </form>
    </div>

    <!-- Results Control -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light-soft text-muted px-2 py-1 fs-xs fw-bold">@Model.TotalCount MATCHES</span>
            <span class="text-muted fs-xs">Showing Page @Model.Page of @Model.TotalPages</span>
        </div>
    </div>

    @if (Model.Results.Any())
    {
        <div class="row g-4">
            @foreach (var task in Model.Results)
            {
                <div class="col-md-6 col-xl-4 scale-in">
                    @await Html.PartialAsync("_TaskCard", task)
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center lm-pagination gap-1">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link rounded-circle border-0 bg-light shadow-sm" href="@Url.Action("Index", new { Keyword = Model.Keyword, Category = Model.Category, MinBudget = Model.MinBudget, MaxBudget = Model.MaxBudget, Location = Model.Location, RadiusKm = Model.RadiusKm, IsRemote = Model.IsRemote, IsUrgent = Model.IsUrgent, SortBy = Model.SortBy, Page = Model.Page - 1 })">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link rounded-circle border-0 shadow-sm px-3" href="@Url.Action("Index", new { Keyword = Model.Keyword, Category = Model.Category, MinBudget = Model.MinBudget, MaxBudget = Model.MaxBudget, Location = Model.Location, RadiusKm = Model.RadiusKm, IsRemote = Model.IsRemote, IsUrgent = Model.IsUrgent, SortBy = Model.SortBy, Page = i })">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link rounded-circle border-0 bg-light shadow-sm" href="@Url.Action("Index", new { Keyword = Model.Keyword, Category = Model.Category, MinBudget = Model.MinBudget, MaxBudget = Model.MaxBudget, Location = Model.Location, RadiusKm = Model.RadiusKm, IsRemote = Model.IsRemote, IsUrgent = Model.IsUrgent, SortBy = Model.SortBy, Page = Model.Page + 1 })">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="lm-card text-center py-5 shadow-sm fade-in">
            <div class="bg-light-soft text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                <i class="bi bi-search glass-icon display-4 opacity-50"></i>
            </div>
            <h3 class="fw-bold mb-2">No matching tasks found</h3>
            <p class="text-muted mx-auto mb-4" style="max-width: 400px;">Try adjusting your filters, clearing keywords, or searching in a wider radius to see more opportunities.</p>
            <a asp-action="Index" class="btn btn-outline-primary px-4 fw-bold shadow-sm">
                <i class="bi bi-arrow-counterclockwise me-2"></i>Reset All Filters
            </a>
        </div>
    }
</div>

<style>
    .lm-pagination .page-link { color: #6c757d; transition: all 0.2s; }
    .lm-pagination .page-item.active .page-link { background-color: var(--lm-primary); color: white; }
    .lm-pagination .page-link:hover { transform: translateY(-2px); }
    
    #advancedFilters.show ~ .text-center .show-text { display: none; }
    #advancedFilters.show ~ .text-center .hide-text { display: inline !important; }
    
    .border-dashed { border-style: dashed !important; }
    .lm-filter-check .form-check-input:checked { background-color: var(--lm-primary); border-color: var(--lm-primary); }
</style>
