@model LaborBLL.ModelVM.TaskDetailsViewModel
@using LaborDAL.Enums
@using System.Security.Claims
@using TaskStatus = LaborDAL.Enums.TaskStatus
@{
    ViewData["Title"] = Model.Title;
}

<div class="dashboard-container fade-in py-4">
    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Premium Task Header -->
            <div class="lm-card p-0 mb-4 overflow-hidden shadow-sm border-0">
                <div class="bg-primary-soft p-4 border-bottom">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary px-3 py-2 rounded-pill">@Model.CategoryDisplay</span>
                            @if (Model.IsUrgent)
                            {
                                <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-lightning-fill me-1"></i>Urgent</span>
                            }
                            @if (Model.IsRemote)
                            {
                                <span class="badge bg-info px-3 py-2 rounded-pill"><i class="bi bi-wifi me-1"></i>Remote</span>
                            }
                            <span class="badge @GetStatusBadgeClass(Model.Status) px-3 py-2 rounded-pill">@Model.StatusDisplay</span>
                        </div>
                        <div class="d-flex gap-2">
                            @if (Model.CanEdit)
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-white btn-sm shadow-sm rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i>Modify
                                </a>
                            }
                            @if (Model.CanDelete)
                            {
                                <button type="button" class="btn btn-white btn-sm text-danger shadow-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                    <i class="bi bi-trash me-1"></i>Remove
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="p-4 p-md-5">
                    <h1 class="lm-dashboard-title mb-4">@Model.Title</h1>
                    
                    <!-- Poster Info & Key Metadata -->
                    <div class="row g-4 mb-5">
                        <div class="col-md-7">
                            <div class="d-flex align-items-center gap-3 p-3 bg-light-soft rounded-4 border border-white">
                                @if (!string.IsNullOrEmpty(Model.Poster?.ProfilePicture))
                                {
                                    <img src="@Model.Poster.ProfilePicture" alt="" class="rounded-circle shadow-sm" style="width: 56px; height: 56px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px; font-weight: 700; font-size: 1.2rem;">
                                        @(Model.Poster?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                    </div>
                                }
                                <div>
                                    <p class="mb-0 smaller text-muted text-uppercase fw-bold ls-1">Commissioned By</p>
                                    <h6 class="mb-1 fw-bold">@Model.Poster?.Name</h6>
                                    @if (Model.Poster?.Rating.HasValue == true)
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem; opacity: @(i <= Math.Round(Model.Poster.Rating.Value) ? "1" : "0.3")"></i>
                                            }
                                            <span class="smaller fw-bold text-dark ms-1">@Model.Poster.Rating.Value.ToString("0.0")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="d-flex flex-column gap-2 h-100 justify-content-center text-md-end">
                                <p class="mb-0 text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i>Posted on @Model.CreatedAt.ToString("MMM dd, yyyy")
                                </p>
                                <p class="mb-0 text-muted small">
                                    <i class="bi bi-eye me-1"></i>@Model.ViewCount people viewed this
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Description Section -->
                    <div class="mb-5">
                        <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-text-left text-primary"></i> Task Description
                        </h5>
                        <div class="text-body-secondary lh-lg" style="font-size: 0.95rem;">
                            @Html.Raw(Model.Description?.Replace("\n", "<br/>"))
                        </div>
                    </div>

                    <!-- Task Specifications Grid -->
                    <div class="mb-5">
                        <h5 class="fw-bold mb-4 d-flex align-items-center gap-2">
                            <i class="bi bi-grid-1x2 text-primary"></i> Core Specifications
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-6 col-xl-4">
                                <div class="p-3 bg-light-soft rounded-4 border border-white h-100">
                                    <p class="smaller text-muted text-uppercase fw-bold mb-2">Budget Model</p>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-cash-stack text-success fs-5"></i>
                                        <div>
                                            <h6 class="mb-0 fw-bold">$@Model.Budget.ToString("N2")</h6>
                                            <small class="text-muted">@Model.BudgetTypeDisplay</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-xl-4">
                                <div class="p-3 bg-light-soft rounded-4 border border-white h-100">
                                    <p class="smaller text-muted text-uppercase fw-bold mb-2">Capacity</p>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-people text-primary fs-5"></i>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@Model.WorkersNeeded Professionals</h6>
                                            <small class="text-muted">Total needed</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @if (Model.StartDate.HasValue)
                            {
                                <div class="col-md-6 col-xl-4">
                                    <div class="p-3 bg-light-soft rounded-4 border border-white h-100">
                                        <p class="smaller text-muted text-uppercase fw-bold mb-2">Timeline</p>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-calendar-event text-info fs-5"></i>
                                            <div>
                                                <h6 class="mb-0 fw-bold">Starts @Model.StartDate.Value.ToString("MMM dd")</h6>
                                                <small class="text-muted">@Model.StartDate.Value.ToString("hh:mm tt")</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!Model.IsRemote)
                            {
                                <div class="col-md-6 col-xl-4">
                                    <div class="p-3 bg-light-soft rounded-4 border border-white h-100">
                                        <p class="smaller text-muted text-uppercase fw-bold mb-2">Deployment Hub</p>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-geo-alt text-danger fs-5"></i>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@Model.City</h6>
                                                <small class="text-muted">@Model.Country</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.RequiredSkills))
                            {
                                <div class="col-12">
                                    <div class="p-3 bg-light-soft rounded-4 border border-white">
                                        <p class="smaller text-muted text-uppercase fw-bold mb-2">Required Expertise</p>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var skill in Model.RequiredSkills.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="badge bg-white text-dark shadow-sm border px-3 py-2 rounded-pill">
                                                    <i class="bi bi-patch-check text-primary me-1"></i>@skill.Trim()
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Map Section -->
                    @if (!Model.IsRemote && Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        <div class="mb-5">
                            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-map text-primary"></i> Geographical Location
                            </h5>
                            <div class="position-relative">
                                <div id="taskMap" class="rounded-4 shadow-sm" style="height: 350px; border: 4px solid #fff;"></div>
                                <div class="position-absolute bottom-0 start-0 m-3 z-index-1">
                                    <div class="bg-white p-2 rounded-3 shadow-lg border small fw-bold">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Location
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Apply CTA for Workers -->
                    @if (Model.CanApply && Model.Status == TaskStatus.Open)
                    {
                        <div class="p-4 p-md-5 bg-primary rounded-4 text-white shadow-lg overflow-hidden position-relative">
                            <div class="position-relative z-index-1">
                                <h3 class="fw-bold mb-2">Ready to contribute?</h3>
                                <p class="opacity-75 mb-4 max-w-500">Submit your professional proposal to @Model.Poster?.Name and start your journey with this task.</p>
                                <a asp-controller="Application" asp-action="Create" asp-route-taskId="@Model.Id" class="btn btn-white btn-lg px-5 py-3 fw-bold shadow-sm rounded-pill transition-all">
                                    <i class="bi bi-rocket-takeoff me-2"></i>Submit Application
                                </a>
                            </div>
                            <i class="bi bi-briefcase position-absolute top-50 end-0 translate-middle-y opacity-10" style="font-size: 10rem; margin-right: -2rem;"></i>
                        </div>
                    }
                    else if (Model.HasApplied)
                    {
                        <div class="p-4 bg-info-soft rounded-4 border border-info-subtle d-flex align-items-center gap-3">
                            <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-check-lg fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-info-emphasis">Application Submitted</h6>
                                <p class="mb-0 smaller text-info-emphasis opacity-75">You've successfully sent your interest. Await the poster's evaluation.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Applications List for Poster -->
            @if (Model.Applications.Any())
            {
                <div class="lm-card p-0 overflow-hidden shadow-sm border-0 mt-4">
                    <div class="bg-light-soft p-4 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-person-lines-fill text-primary me-2"></i>Applications
                            </h5>
                            <span class="badge bg-white text-primary border rounded-pill px-3 py-2 fw-bold shadow-sm">
                                @Model.Applications.Count Total
                            </span>
                        </div>
                    </div>
                    <div class="p-4 p-md-5">
                        <div class="row g-4">
                            @foreach (var app in Model.Applications)
                            {
                                <div class="col-12">
                                    <div class="p-4 border rounded-4 bg-white shadow-hover transition-all">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <a asp-controller="Account" asp-action="Profile" asp-route-id="@app.WorkerId" class="text-decoration-none">
                                                    @if (!string.IsNullOrEmpty(app.WorkerProfilePicture))
                                                    {
                                                        <img src="@app.WorkerProfilePicture" alt="" class="rounded-circle shadow-sm" style="width: 64px; height: 64px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px; font-weight: 700; font-size: 1.4rem;">
                                                            @(app.WorkerName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                                        </div>
                                                    }
                                                </a>
                                                <div>
                                                    <h5 class="mb-1 fw-bold">
                                                        <a asp-controller="Account" asp-action="Profile" asp-route-id="@app.WorkerId" class="text-dark hover-primary text-decoration-none">
                                                            @app.WorkerName
                                                        </a>
                                                    </h5>
                                                    @if (app.WorkerRating.HasValue)
                                                    {
                                                        <div class="d-flex align-items-center gap-1 mb-2">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="bi bi-star-fill text-warning" style="font-size: 0.7rem; opacity: @(i <= Math.Round(app.WorkerRating.Value) ? "1" : "0.3")"></i>
                                                            }
                                                            <span class="small text-muted ms-1">(@app.WorkerRating.Value.ToString("0.0"))</span>
                                                        </div>
                                                    }
                                                    <span class="badge @GetApplicationStatusBadgeClass(app.Status) rounded-pill px-3">@app.StatusDisplay</span>
                                                </div>
                                            </div>
                                            <div class="text-md-end">
                                                <h4 class="text-primary fw-bold mb-0">$@app.ProposedBudget.ToString("N2")</h4>
                                                @if (app.EstimatedHours.HasValue)
                                                {
                                                    <p class="mb-0 text-muted small">@app.EstimatedHours.Value Estimated Hours</p>
                                                }
                                                <p class="mb-0 text-muted smaller">@app.CreatedAt.ToString("MMM dd")</p>
                                            </div>
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(app.Message))
                                        {
                                            <div class="mt-4 p-3 bg-light rounded-4 border-start border-primary border-4">
                                                <p class="mb-0 text-body-secondary small italic px-2">"@app.Message"</p>
                                            </div>
                                        }

                                        @if (app.Status == ApplicationStatus.Pending && Model.Status == TaskStatus.Open && Model.Poster?.Id == User.FindFirstValue(ClaimTypes.NameIdentifier))
                                        {
                                            <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                                                <form asp-controller="Application" asp-action="Accept" asp-route-id="@app.Id" method="post" class="flex-grow-1">
                                                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">
                                                        <i class="bi bi-check-lg me-2"></i>Accept Application
                                                    </button>
                                                </form>
                                                <form asp-controller="Application" asp-action="Reject" asp-route-id="@app.Id" method="post" class="flex-grow-1">
                                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold">
                                                        <i class="bi bi-x-lg me-2"></i>Decline
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar Actions & Stats -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 1.5rem;">
                <!-- Call to Action Card -->
                <div class="lm-card mb-4 shadow-sm border-0">
                    <div class="p-4">
                        @if (Model.CanApply && Model.Status == TaskStatus.Open)
                        {
                            <a asp-controller="Application" asp-action="Create" asp-route-taskId="@Model.Id" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-3">
                                <i class="bi bi-send-fill me-2"></i>Submit Interest
                            </a>
                        }
                        
                        @if (Model.Status == TaskStatus.Accepted && Model.AssignedWorker != null)
                        {
                            <div class="p-3 bg-success-soft rounded-4 border border-success-subtle mb-3">
                                <p class="smaller text-success-emphasis text-uppercase fw-bold mb-3 ls-1">Assigned Executive</p>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(Model.AssignedWorker?.ProfilePicture))
                                    {
                                        <img src="@Model.AssignedWorker.ProfilePicture" alt="" class="rounded-circle shadow-sm" style="width: 48px; height: 48px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-weight: 700;">
                                            @(Model.AssignedWorker?.Name?.FirstOrDefault().ToString().ToUpper() ?? "W")
                                        </div>
                                    }
                                    <div>
                                        <h6 class="mb-0 fw-bold">@Model.AssignedWorker?.Name</h6>
                                        <div class="d-flex align-items-center gap-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi bi-star-fill text-warning" style="font-size: 0.6rem; opacity: @(i <= Math.Round(Model.AssignedWorker?.Rating ?? 0) ? "1" : "0.3")"></i>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <p class="text-muted smaller mt-3 mb-0">
                                    <i class="bi bi-clock-history me-1"></i>Joined @Model.AssignedAt?.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                        }

                        <div class="task-engagement pt-2">
                            <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light mb-2">
                                <span class="text-muted smaller fw-bold text-uppercase"><i class="bi bi-eye me-2"></i>Visibility</span>
                                <span class="fw-bold">@Model.ViewCount</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light mb-2">
                                <span class="text-muted smaller fw-bold text-uppercase"><i class="bi bi-file-earmark-person me-2"></i>Applicants</span>
                                <span class="fw-bold">@Model.ApplicationCount</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Similar Tasks Widget -->
                @{
                    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                    var isPoster = Model.Poster?.Id == currentUserId;
                }
                @if (!isPoster)
                {
                    <div class="lm-card p-0 overflow-hidden shadow-sm border-0" id="similarTasksCard">
                        <div class="bg-light-soft p-3 border-bottom">
                            <h6 class="fw-bold mb-0">
                                <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Similar Opportunities
                            </h6>
                        </div>
                        <div class="p-0" id="similarTasksContainer">
                            <div class="p-4 text-center" id="similarTasksLoading">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                <p class="text-muted smaller mt-2 mb-0">Curating matches...</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modern Delete Confirmation -->
@if (Model.CanDelete)
{
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="p-4 p-md-5 text-center">
                    <div class="bg-danger-soft text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 80px; height: 80px;">
                        <i class="bi bi-exclamation-triangle fs-1"></i>
                    </div>
                    <h3 class="fw-bold mb-2">Delete this task?</h3>
                    <p class="text-muted mb-5">This action is irreversible. All applications and data associated with "<span class="fw-bold text-dark">@Model.Title</span>" will be purged.</p>
                    
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light-soft flex-fill py-3 rounded-pill fw-bold" data-bs-dismiss="modal">Keep Task</button>
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex-fill">
                            <button type="submit" class="btn btn-danger w-100 py-3 rounded-pill fw-bold">Confirm Deletion</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (!Model.IsRemote && Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const lat = @Model.Latitude.Value; const lng = @Model.Longitude.Value;
                const map = L.map('taskMap', { zoomControl: false }).setView([lat, lng], 15);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
                L.marker([lat, lng]).addTo(map).bindPopup('@Model.Location').openPopup();
                L.control.zoom({ position: 'bottomright' }).addTo(map);
            });
        </script>
    }

    @if (!isPoster)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() { loadSimilarTasks(); });
            async function loadSimilarTasks() {
                const container = document.getElementById('similarTasksContainer');
                try {
                    const response = await fetch('@Url.Action("SimilarTasks", "Task", new { taskId = Model.Id })');
                    const result = await response.json();
                    if (result.success && result.data && result.data.length > 0) {
                        let html = '<div class="list-group list-group-flush">';
                        result.data.forEach(function(task) {
                            html += `
                                <a href="/Task/Details/${task.id}" class="list-group-item list-group-item-action p-3 border-0 border-bottom">
                                    <div class="d-flex justify-content-between mb-1">
                                        <h6 class="mb-0 fw-bold text-dark small overflow-hidden text-nowrap text-truncate" style="max-width: 180px;">${escapeHtml(task.title)}</h6>
                                        <span class="text-primary fw-bold smaller">$${task.budget.toLocaleString()}</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between opacity-75">
                                        <span class="smaller"><i class="bi bi-geo-alt me-1"></i>${escapeHtml(task.city || 'Remote')}</span>
                                        <span class="smaller"><i class="bi bi-people me-1"></i>${task.applicationCount}</span>
                                    </div>
                                </a>`;
                        });
                        container.innerHTML = html + '</div>';
                    } else {
                        container.innerHTML = '<div class="p-4 text-center text-muted small"><i class="bi bi-info-circle me-1"></i>No similar tasks found</div>';
                    }
                } catch (e) { container.innerHTML = '<div class="p-4 text-center text-danger small">Failed to load recommendations</div>'; }
            }
            function escapeHtml(text) { if (!text) return ''; const div = document.createElement('div'); div.textContent = text; return div.innerHTML; }
        </script>
    }
}

@functions {
    string GetStatusBadgeClass(TaskStatus status) => status switch {
        TaskStatus.Open => "bg-success-soft text-success",
        TaskStatus.Accepted => "bg-info-soft text-info",
        TaskStatus.InProgress => "bg-warning-soft text-warning",
        TaskStatus.Completed => "bg-primary-soft text-primary",
        TaskStatus.Cancelled => "bg-secondary-soft text-secondary",
        _ => "bg-light text-muted"
    };
    string GetApplicationStatusBadgeClass(ApplicationStatus status) => status switch {
        ApplicationStatus.Pending => "bg-warning-soft text-warning",
        ApplicationStatus.Accepted => "bg-success-soft text-success",
        ApplicationStatus.Rejected => "bg-danger-soft text-danger",
        _ => "bg-light text-muted"
    };
}
}