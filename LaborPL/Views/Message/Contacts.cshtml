@model List<ContactViewModel>
@{
    ViewData["Title"] = "Contacts";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-chat-dots-fill me-2"></i>Messages</h5>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-chat fs-1"></i>
                    <p class="mt-3">No conversations yet</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var contact in Model)
                    {
                        <a asp-controller="Message" asp-action="Chat" asp-route-OtherUserId="@contact.OtherUserId"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle me-3">
                                    @contact.FullName?.FirstOrDefault()
                                </div>
                                <div>
                                    <strong>@contact.FullName</strong>
                                    <p class="text-muted mb-0 small">@contact.LastMessage</p>
                                </div>
                            </div>
                            <div class="text-end">
                                <small class="text-muted">@contact.LastMessageAt?.ToString("hh:mm tt")</small>
                                @if (contact.UnreadCount > 0)
                                {
                                    <span class="badge bg-primary rounded-pill d-block mt-1">@contact.UnreadCount</span>
                                }
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.2rem;
    }
</style>