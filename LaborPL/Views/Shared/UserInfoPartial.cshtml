@inject UserManager<AppUser> userManager
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var user = userManager.FindByIdAsync(userId).Result;
    var rating = user?.AverageRating ?? 0m;
}

@if (user != null)
{
    <div class="lm-profile-toggle" id="userProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
        {
            <img src="@user.ProfilePictureUrl" alt="Profile" class="lm-nav-avatar" />
        }
        else
        {
            <div class="navbar-profile-placeholder lm-nav-avatar d-flex align-items-center justify-content-center bg-primary text-white fw-bold">
                <span>@(user.FirstName?.FirstOrDefault())@(user.LastName?.FirstOrDefault())</span>
            </div>
        }
        <div class="d-none d-md-block">
            <div class="lm-nav-user-name">@user.FirstName @user.LastName</div>
            <div class="lm-nav-rating">
                <i class="bi bi-star-fill"></i>
                <span>@rating.ToString("0.0")</span>
            </div>
        </div>
    </div>
}