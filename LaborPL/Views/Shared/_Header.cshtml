    <header>
        <nav class="navbar navbar-expand-lg lm-navbar">
            <div class="container-fluid px-md-5">
                <a class="lm-navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-rocket-takeoff-fill"></i>
                    <span class="d-none d-sm-inline">Labor Marketplace</span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 ps-lg-4">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="lm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-grid-1x2"></i> Dashboard
                                </a>
                            </li>
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="lm-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-lock"></i> Admin
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2">
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Overview</a></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="RedesignProgress"><i class="bi bi-magic me-2"></i>Redesign Tracker</a></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>User Management</a></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="IdVerifications"><i class="bi bi-patch-check me-2"></i>Verifications</a></li>
                                        <li><hr class="dropdown-divider opacity-50"></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="Disputes"><i class="bi bi-exclamation-triangle me-2"></i>Disputes</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Poster"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="lm-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-plus-square"></i> Tasks
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-lg rounded-4 p-2 mt-2">
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Task" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>Post New</a></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Task" asp-action="MyTasks"><i class="bi bi-list-check me-2"></i>My Posts</a></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Application" asp-action="ByPoster"><i class="bi bi-person-lines-fill me-2"></i>Applications</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Worker"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="lm-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-tools"></i> Work
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-lg rounded-4 p-2 mt-2">
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Task" asp-action="Index"><i class="bi bi-search me-2"></i>Browse Market</a></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Application" asp-action="ByWorker"><i class="bi bi-file-earmark-text me-2"></i>My Bids</a></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Booking" asp-action="Dashboard"><i class="bi bi-calendar-check me-2"></i>Engagements</a></li>
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="lm-nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="lm-nav-link" href="/#categories">Marketplace</a>
                            </li>
                            <li class="nav-item">
                                <a class="lm-nav-link" href="/#how-it-works">How it Works</a>
                            </li>
                        }
                    </ul>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Global Search Bar (Visible on desktop) -->
                        <form class="d-none d-lg-flex mx-auto position-relative" style="max-width: 400px; flex: 1; z-index: 1050;" asp-controller="Task" asp-action="Index" method="get">
                            <div class="input-group lm-header-search shadow-sm rounded-pill bg-white border overflow-hidden" style="height: 42px;">
                                <span class="input-group-text bg-transparent border-0 ps-3">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="text" name="Keyword" class="form-control border-0 bg-transparent py-2" style="font-size: 0.9rem;" placeholder="Search tasks..." aria-label="Search">
                                <button class="btn btn-primary px-3 rounded-pill m-1" style="height: 32px; width: 50px; display: flex; align-items: center; justify-content: center;" type="submit">Go</button>
                            </div>
                        </form>
                    }
                </div>

                <!-- Profile Actions (Outside collapse to keep visible on mobile) -->
                <div class="lm-nav-actions ms-auto ms-lg-3 d-flex align-items-center" style="flex-shrink: 0; z-index: 1060; overflow: visible;">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @await Html.PartialAsync("_ChatFloatingIcon")

                        <div class="dropdown ms-2">
                            @await Html.PartialAsync("UserInfoPartial")
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-3" style="min-width: 240px;">
                                <li class="px-3 py-2 border-bottom mb-2 d-md-none">
                                    <p class="mb-0 fw-bold">User Menu</p>
                                </li>
                                <li><a class="dropdown-item rounded-3 py-2" asp-controller="Account" asp-action="MyProfile"><i class="bi bi-person-badge me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" asp-controller="Payment" asp-action="MyPaymentHistory"><i class="bi bi-wallet2 me-2"></i>Payment History</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" asp-controller="Rating" asp-action="GetMyRate" asp-route-userId="@User.FindFirstValue(ClaimTypes.NameIdentifier)"><i class="bi bi-star me-2"></i>My Ratings</a></li>
                                <li><hr class="dropdown-divider opacity-50"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item rounded-3 py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-link lm-nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-primary rounded-pill px-4" asp-controller="Account" asp-action="Register">Join Now</a>
                    }
                </div>
            </div>
        </nav>
    </header>
