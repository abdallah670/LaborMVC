<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Labor Marketplace</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Design System CSS -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LaborPL.styles.css" asp-append-version="true" />

    <!-- Theme Initialization (Anti-Flash) -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem("theme") || "light";
            document.documentElement.setAttribute("data-theme", savedTheme);
        })();
    </script>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Header Navigation Partial -->
    @await Html.PartialAsync("_Header")

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            <!-- Global Alerts (Processed by ui-notifications.js) -->
            @if (TempData["Message"] != null || TempData["SuccessMessage"] != null)
            {
                <div id="global-success-message" data-message="@(TempData["Message"] ?? TempData["SuccessMessage"])" class="d-none"></div>
            }

            @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
            {
                <div id="global-error-message" data-message="@(TempData["Error"] ?? TempData["ErrorMessage"])" class="d-none"></div>
            }

            @if (TempData["Warning"] != null || TempData["WarningMessage"] != null)
            {
                <div id="global-warning-message" data-message="@(TempData["Warning"] ?? TempData["WarningMessage"])" class="d-none"></div>
            }

            @if (TempData["Info"] != null || TempData["InfoMessage"] != null)
            {
                <div id="global-info-message" data-message="@(TempData["Info"] ?? TempData["InfoMessage"])" class="d-none"></div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Footer Partial -->
    @await Html.PartialAsync("_Footer")

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ui-notifications.js" asp-append-version="true"></script>
    <script src="~/js/theme-switcher.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- SignalR Connection -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <!-- Extracted Realtime Chat Script -->
    <script src="~/js/realtime-chat.js" asp-append-version="true"></script>
</body>
</html>
