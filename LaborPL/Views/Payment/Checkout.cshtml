    @model CheckoutViewModel

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Checkout</h4>
                    </div>
                    <div class="card-body">
                        <p class="mb-3">Amount to Pay: <strong>$@Model.Amount</strong></p>

                        <!-- فورم الكارت من Stripe -->
                        <div class="mb-3">
                            <label for="card-element" class="form-label">Card Details</label>
                            <div id="card-element" class="form-control"></div>
                            <div id="card-errors" class="text-danger mt-2"></div>
                        </div>

                        <button id="pay-button" class="btn btn-primary w-100">Pay Now</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://js.stripe.com/v3/"></script>
        <script>
                    var stripe = Stripe('@Model.PubishableKey');
            var elements = stripe.elements();
            var card = elements.create('card', { hidePostalCode: true });
            card.mount('#card-element');

            card.on('change', function(event) {
                var displayError = document.getElementById('card-errors');
                displayError.textContent = event.error ? event.error.message : '';
            });

            document.getElementById('pay-button').addEventListener('click', async function () {
                var clientSecret = '@Model.ClientSecret';

                // ✅ تحقق إن ClientSecret موجود
                if (!clientSecret || clientSecret.trim() === '') {
                    document.getElementById('card-errors').textContent = 'Payment session expired. Please refresh the page.';
                    return;
                }

                        const { error, paymentIntent } = await stripe.confirmCardPayment(clientSecret, {
            payment_method: { card: card },
            setup_future_usage: null
        });

                if (error) {
                    document.getElementById('card-errors').textContent = error.message;
                       } else {
            // ✅ استنى 3 ثواني عشان الـ Webhook يوصل ويحدث الـ DB
            document.getElementById('pay-button').textContent = 'Processing...';
            document.getElementById('pay-button').disabled = true;
            setTimeout(function() {
                window.location.href = '/Payment/Status?bookingId=@Model.BookingId';
            }, 3000);
        }
            });
      
        </script>
    }