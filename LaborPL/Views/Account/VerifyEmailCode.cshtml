@model LaborBLL.ModelVM.VerifyEmailCodeViewModel
@{
    ViewData["Title"] = "Verify Email";
    Layout = "_Layout";
}

<div class="auth-container fade-in">
    <div class="auth-card">
        <div class="lm-card p-4">
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info p-2 small mb-3">
                    <i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
                </div>
            }

            <div class="text-center mb-4">
                <div class="email-icon-pulse mb-3 d-inline-block">
                    <i class="bi bi-envelope-open-fill fs-1 text-primary"></i>
                </div>
                <h4 class="fw-bold mb-1">Verify Your Email</h4>
                <p class="text-muted small">
                    We've sent a 6-digit code to:<br />
                    <span class="text-dark fw-bold">@Model.Email</span>
                </p>
            </div>

            <form asp-action="VerifyEmailCode" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="ResendCooldownSeconds" id="cooldownSeconds" />

                <div class="mb-4 text-center">
                    <label asp-for="Code" class="form-label text-uppercase small fw-bold mb-3">Verification Code</label>
                    <input asp-for="Code" 
                           class="form-control lm-otp-input" 
                           placeholder="000000" 
                           maxlength="6"
                           inputmode="numeric"
                           pattern="\d{6}"
                           autocomplete="one-time-code" />
                    <span asp-validation-for="Code" class="text-danger smaller d-block mt-2"></span>
                </div>

                <div class="mb-4 form-check d-flex justify-content-center">
                    <input asp-for="RememberMe" class="form-check-input me-2" />
                    <label asp-for="RememberMe" class="form-check-label small">Remember this browser</label>
                </div>

                <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-primary lg">
                        Verify and Continue
                    </button>
                </div>
            </form>

            <div class="text-center">
                <p class="smaller text-muted mb-2">Didn't receive the code?</p>
                <button type="button" id="resendBtn" class="btn btn-outline-primary btn-sm px-4" onclick="resendCode()">
                    <span id="resendText">Resend Code</span>
                </button>
                <p id="countdownText" class="smaller text-muted mt-2" style="display: none;">
                    Resend available in <span id="countdown" class="fw-bold">60</span>s
                </p>
            </div>

            <div class="border-top mt-4 pt-3 text-center">
                <p class="smaller text-muted mb-0">
                    Entered the wrong email? 
                    <a asp-action="Register" class="fw-bold text-decoration-none">Register again</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let countdownInterval;
        const cooldownInput = document.getElementById('cooldownSeconds');
        const resendBtn = document.getElementById('resendBtn');
        const resendText = document.getElementById('resendText');
        const countdownText = document.getElementById('countdownText');
        const countdownSpan = document.getElementById('countdown');

        // Get initial cooldown from model
        let cooldownSeconds = parseInt(cooldownInput?.value || '0');

        document.addEventListener('DOMContentLoaded', function() {
            // Auto-focus the code input
            const codeInput = document.querySelector('input[name="Code"]');
            if (codeInput) {
                codeInput.focus();
            }

            // Start countdown if needed
            if (cooldownSeconds > 0) {
                startCountdown(cooldownSeconds);
            }
        });

        function startCountdown(seconds) {
            cooldownSeconds = seconds;
            resendBtn.disabled = true;
            resendText.textContent = 'Please wait...';
            countdownText.style.display = 'block';
            countdownSpan.textContent = seconds;

            countdownInterval = setInterval(function() {
                cooldownSeconds--;
                countdownSpan.textContent = cooldownSeconds;

                if (cooldownSeconds <= 0) {
                    clearInterval(countdownInterval);
                    resendBtn.disabled = false;
                    resendText.textContent = 'Resend Code';
                    countdownText.style.display = 'none';
                }
            }, 1000);
        }

        function resendCode() {
            const userId = document.querySelector('input[name="UserId"]').value;

            // Disable button immediately
            resendBtn.disabled = true;
            resendText.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending...';

            // Get antiforgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/Account/ResendEmailVerificationCode', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `userId=${encodeURIComponent(userId)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Show success message
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success alert-dismissible fade show mt-3 p-2 small';
                    alertDiv.innerHTML = `
                        <i class="bi bi-check-circle-fill me-2"></i>${data.message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    `;
                    document.querySelector('.lm-card').insertBefore(alertDiv, document.querySelector('form'));

                    // Start 60 second countdown
                    startCountdown(60);
                } else {
                    // Show error message
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-warning alert-dismissible fade show mt-3 p-2 small';
                    alertDiv.innerHTML = `
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>${data.message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    `;
                    document.querySelector('.lm-card').insertBefore(alertDiv, document.querySelector('form'));

                    // Re-enable button
                    resendBtn.disabled = false;
                    resendText.textContent = 'Resend Code';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                resendBtn.disabled = false;
                resendText.textContent = 'Resend Code';

                // Show error message
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3 p-2 small';
                alertDiv.innerHTML = `
                    <i class="bi bi-x-circle-fill me-2"></i>Failed to resend code.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.querySelector('.lm-card').insertBefore(alertDiv, document.querySelector('form'));
            });
        }

        // Auto-advance input - allow only digits
        document.querySelector('input[name="Code"]').addEventListener('input', function(e) {
            this.value = this.value.replace(/\D/g, '');
        });
    </script>
}
