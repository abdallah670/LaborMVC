@{
    ViewData["Title"] = "Verify Phone Number";
}

<div class="auth-container fade-in">
    <div class="auth-card">
        <div class="lm-card p-4">
            @Html.AntiForgeryToken()
            
            <!-- Step 1: Enter Phone Number -->
            <div id="step1">
                <div class="text-center mb-4">
                    <div class="bg-primary-soft p-3 rounded-circle d-inline-block mb-3">
                        <i class="bi bi-phone fs-2 text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Secure Your Account</h4>
                    <p class="text-muted small">Verify your phone number to enable important features</p>
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase small fw-bold">Region</label>
                    <select class="form-select" id="countryCode">
                        <option value="+20" selected>Egypt (+20)</option>
                        <option value="+966">Saudi Arabia (+966)</option>
                        <option value="+971">UAE (+971)</option>
                        <option value="+965">Kuwait (+965)</option>
                        <option value="+974">Qatar (+974)</option>
                        <option value="+973">Bahrain (+973)</option>
                        <option value="+968">Oman (+968)</option>
                        <option value="+962">Jordan (+962)</option>
                        <option value="+961">Lebanon (+961)</option>
                        <option value="+1">USA (+1)</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label for="phoneNumber" class="form-label text-uppercase small fw-bold">Phone Number</label>
                    <input type="tel" class="form-control form-control-lg" id="phoneNumber" 
                           placeholder="10xxxxxxxx" maxlength="15">
                    <div class="smaller text-muted mt-2">Enter your digits without the leading zero if applicable</div>
                </div>

                <div id="step1Error" class="alert alert-danger p-2 small d-none mb-3"></div>

                <div class="d-grid">
                    <button type="button" class="btn btn-primary lg" id="btnSendCode">
                        Send Verification Code
                    </button>
                    <a href="@Url.Action("MyProfile")" class="btn btn-link btn-sm text-muted mt-2">
                        Cancel
                    </a>
                </div>
            </div>

            <!-- Step 2: Enter Verification Code -->
            <div id="step2" class="d-none">
                <div class="text-center mb-4">
                    <div class="bg-primary-soft p-3 rounded-circle d-inline-block mb-3">
                        <i class="bi bi-shield-lock-fill fs-2 text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Enter Code</h4>
                    <p class="text-muted small">We've sent a 6-digit code to:<br><span id="phoneDisplay" class="fw-bold text-dark"></span></p>
                </div>
                
                <div class="mb-4 text-center">
                    <input type="text" class="form-control lm-otp-input" 
                           id="verificationCode" placeholder="000000" maxlength="6">
                </div>
                
                <div id="step2Error" class="alert alert-danger p-2 small d-none mb-3"></div>
                
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary lg" id="btnVerifyCode">
                        Verify and Proceed
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnResendCode" disabled>
                        Resend Code <span id="resendCountdown" class="fw-bold"></span>
                    </button>
                </div>
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-link btn-sm text-muted" id="btnChangeNumber">
                        Wrong number? Change it
                    </button>
                </div>
            </div>

            <!-- Step 3: Success -->
            <div id="step3" class="d-none">
                <div class="text-center py-4">
                    <div class="bg-success-soft p-4 rounded-circle d-inline-block mb-4">
                        <i class="bi bi-check-lg display-4 text-success"></i>
                    </div>
                    <h4 class="fw-bold text-success mb-2">Verified!</h4>
                    <p class="text-muted mb-4">Your phone remains secure and verified.</p>
                    <div class="d-grid">
                        <a href="@Url.Action("MyProfile")" class="btn btn-primary">
                            Finish and Return
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let currentPhone = '';
            let currentCountryCode = '';
            let resendTimer = null;
            const RESEND_DELAY = 60; // seconds

            // Get the anti-forgery token
            function getAntiForgeryToken() {
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                return token ? token.value : '';
            }

            // Start countdown timer for resend button
            function startResendCountdown() {
                const btnResend = document.getElementById('btnResendCode');
                const countdownSpan = document.getElementById('resendCountdown');
                let seconds = RESEND_DELAY;

                btnResend.disabled = true;
                countdownSpan.textContent = `(${seconds}s)`;

                if (resendTimer) {
                    clearInterval(resendTimer);
                }

                resendTimer = setInterval(function() {
                    seconds--;
                    if (seconds > 0) {
                        countdownSpan.textContent = `(${seconds}s)`;
                    } else {
                        clearInterval(resendTimer);
                        btnResend.disabled = false;
                        countdownSpan.textContent = '';
                    }
                }, 1000);
            }

            // Step 1: Send verification code
            async function sendVerificationCode() {
                const countryCode = document.getElementById('countryCode').value;
                const phoneNumber = document.getElementById('phoneNumber').value.trim();
                const errorDiv = document.getElementById('step1Error');
                const btn = document.getElementById('btnSendCode');
                
                // Validate phone number
                if (!phoneNumber || phoneNumber.length < 8) {
                    errorDiv.textContent = 'Please enter a valid phone number';
                    errorDiv.classList.remove('d-none');
                    return false;
                }

                currentPhone = phoneNumber;
                currentCountryCode = countryCode;
                
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending...';

                try {
                    const response = await fetch('@Url.Action("SendPhoneVerification")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getAntiForgeryToken()
                        },
                        body: JSON.stringify({
                            phoneNumber: phoneNumber,
                            countryCode: countryCode
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        document.getElementById('step1').classList.add('d-none');
                        document.getElementById('step2').classList.remove('d-none');
                        document.getElementById('phoneDisplay').textContent = currentCountryCode + currentPhone;
                        errorDiv.classList.add('d-none');
                        
                        // Start the resend countdown
                        startResendCountdown();
                        return true;
                    } else {
                        errorDiv.textContent = result.message || 'Failed to send code. Please try again.';
                        errorDiv.classList.remove('d-none');
                        return false;
                    }
                } catch (error) {
                    console.error('Error:', error);
                    errorDiv.textContent = 'An error occurred. Please try again.';
                    errorDiv.classList.remove('d-none');
                    return false;
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send me-2"></i>Send Verification Code';
                }
            }

            // Resend verification code
            async function resendVerificationCode() {
                const errorDiv = document.getElementById('step2Error');
                const btn = document.getElementById('btnResendCode');

                if (!currentPhone || !currentCountryCode) {
                    errorDiv.textContent = 'Phone number information is missing. Please go back and try again.';
                    errorDiv.classList.remove('d-none');
                    return;
                }

                btn.disabled = true;
                const originalText = btn.innerHTML;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending...';

                try {
                    const response = await fetch('@Url.Action("SendPhoneVerification")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getAntiForgeryToken()
                        },
                        body: JSON.stringify({
                            phoneNumber: currentPhone,
                            countryCode: currentCountryCode
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        errorDiv.classList.add('d-none');
                        // Show success message temporarily
                        const successDiv = document.createElement('div');
                        successDiv.className = 'alert alert-success';
                        successDiv.textContent = 'New verification code sent!';
                        errorDiv.parentNode.insertBefore(successDiv, errorDiv);
                        setTimeout(() => successDiv.remove(), 3000);
                        
                        // Restart countdown
                        startResendCountdown();
                    } else {
                        errorDiv.textContent = result.message || 'Failed to resend code. Please try again.';
                        errorDiv.classList.remove('d-none');
                        btn.disabled = false;
                    }
                } catch (error) {
                    console.error('Error:', error);
                    errorDiv.textContent = 'An error occurred. Please try again.';
                    errorDiv.classList.remove('d-none');
                    btn.disabled = false;
                } finally {
                    btn.innerHTML = originalText;
                }
            }

            // Step 2: Verify code
            async function verifyCode() {
                const code = document.getElementById('verificationCode').value.trim();
                const errorDiv = document.getElementById('step2Error');

                if (!code || code.length !== 6) {
                    errorDiv.textContent = 'Please enter the 6-digit verification code';
                    errorDiv.classList.remove('d-none');
                    return;
                }

                const btn = document.getElementById('btnVerifyCode');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Verifying...';

                try {
                    const response = await fetch('@Url.Action("VerifyPhone")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getAntiForgeryToken()
                        },
                        body: JSON.stringify({ code: code })
                    });

                    const result = await response.json();

                    if (result.success) {
                        document.getElementById('step2').classList.add('d-none');
                        document.getElementById('step3').classList.remove('d-none');
                        
                        // Clear timer
                        if (resendTimer) {
                            clearInterval(resendTimer);
                        }
                    } else {
                        errorDiv.textContent = result.message || 'Invalid code. Please try again.';
                        errorDiv.classList.remove('d-none');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    errorDiv.textContent = 'An error occurred. Please try again.';
                    errorDiv.classList.remove('d-none');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Verify Code';
                }
            }

            // Event listeners
            document.getElementById('btnSendCode').addEventListener('click', sendVerificationCode);
            document.getElementById('btnResendCode').addEventListener('click', resendVerificationCode);
            document.getElementById('btnVerifyCode').addEventListener('click', verifyCode);
            
            document.getElementById('btnChangeNumber').addEventListener('click', function() {
                document.getElementById('step2').classList.add('d-none');
                document.getElementById('step1').classList.remove('d-none');
                document.getElementById('verificationCode').value = '';
                
                // Clear timer
                if (resendTimer) {
                    clearInterval(resendTimer);
                }
                
                // Reset resend button
                const btnResend = document.getElementById('btnResendCode');
                btnResend.disabled = true;
                document.getElementById('resendCountdown').textContent = '';
            });

            // Allow Enter key to submit
            document.getElementById('phoneNumber').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    sendVerificationCode();
                }
            });

            document.getElementById('verificationCode').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    verifyCode();
                }
            });
        });
    </script>
}