@using LaborDAL.Enums

@{
    ViewData["Title"] = "ID Verification";
}

<div class="container py-4 fade-in">
    <div class="row g-4 justify-content-center">
        <div class="col-lg-7">
            <div class="lm-card p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary-soft p-3 rounded-circle me-3">
                        <i class="bi bi-person-badge fs-3 text-primary"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">ID Verification</h4>
                        <p class="text-muted small mb-0">Secure your account and gain trust within the community</p>
                    </div>
                </div>

                <!-- Verification Status -->
                <div id="verificationStatus" class="mb-4">
                    <div class="text-center p-4 border rounded-3 bg-light-subtle">
                        <div class="spinner-border text-primary spinner-border-sm mb-2" role="status"></div>
                        <p class="small text-muted mb-0">Checking verification status...</p>
                    </div>
                </div>

                <!-- Verification Form -->
                <form id="idVerificationForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small fw-bold">Document Type</label>
                            <select class="form-select" id="documentType" name="DocumentType" required>
                                <option value="">Choose type...</option>
                                <option value="Passport">Passport</option>
                                <option value="NationalID">National ID Card</option>
                                <option value="DriversLicense">Driver's License</option>
                                <option value="ResidencePermit">Residence Permit</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small fw-bold">Document Number</label>
                            <input type="text" class="form-control" id="documentNumber" name="DocumentNumber"
                                   required placeholder="e.g. A1234567" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-uppercase small fw-bold">Issuing Country</label>
                        <select class="form-select" id="documentCountry" name="DocumentCountry" required>
                            <option value="">Select country...</option>
                            <option value="Egypt">Egypt</option>
                            <option value="Saudi Arabia">Saudi Arabia</option>
                            <option value="UAE">UAE</option>
                            <option value="Kuwait">Kuwait</option>
                            <option value="Qatar">Qatar</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="row g-4 mb-4">
                        <!-- Front Document Upload -->
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small fw-bold">Front Side</label>
                            <div class="upload-zone border rounded-3 p-3 text-center bg-light-subtle position-relative">
                                <input type="file" class="form-control form-control-sm mb-2" id="frontDocument" name="frontDocument"
                                       accept="image/jpeg,image/png,image/jpg" required />
                                <div id="frontPreview" class="d-none mt-2">
                                    <img src="" alt="Front" class="img-fluid rounded border" style="max-height: 120px;" />
                                </div>
                                <div class="smaller text-muted mt-1">Clear photo required</div>
                            </div>
                        </div>

                        <!-- Back Document Upload -->
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small fw-bold">Back Side (Optional)</label>
                            <div class="upload-zone border rounded-3 p-3 text-center bg-light-subtle position-relative">
                                <input type="file" class="form-control form-control-sm mb-2" id="backDocument" name="backDocument"
                                       accept="image/jpeg,image/png,image/jpg" />
                                <div id="backPreview" class="d-none mt-2">
                                    <img src="" alt="Back" class="img-fluid rounded border" style="max-height: 120px;" />
                                </div>
                                <div class="smaller text-muted mt-1">Both sides preferred</div>
                            </div>
                        </div>
                    </div>

                    <!-- Selfie Capture Area -->
                    <div class="mb-4">
                        <label class="form-label text-uppercase small fw-bold">Verification Selfie</label>
                        <div class="lm-card bg-light border-0 p-3 mb-3">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-info-circle-fill text-primary me-2"></i>
                                <span class="small">Hold your ID next to your face in good lighting.</span>
                            </div>
                            
                            <button type="button" class="btn btn-outline-primary btn-sm w-100 mb-2" id="btnOpenCamera">
                                <i class="bi bi-camera-fill me-2"></i>Capture Selfie Now
                            </button>
                            
                            <input type="hidden" id="capturedSelfieData" />
                            <input type="file" class="d-none" id="selfie" name="selfie" accept="image/jpeg,image/png,image/jpg" />
                            
                            <div id="selfiePreview" class="d-none text-center mt-3">
                                <div class="position-relative d-inline-block">
                                    <img src="" alt="Selfie" class="rounded border shadow-sm" style="max-height: 150px;" />
                                    <button type="button" class="btn btn-sm btn-danger rounded-circle position-absolute top-0 end-0 m-n2 shadow" id="btnRemoveSelfie">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                                <div class="text-success smaller mt-2"><i class="bi bi-check-circle-fill me-1"></i>Ready for submission</div>
                            </div>
                        </div>
                    </div>

                    <div id="submitError" class="alert alert-danger d-none p-2 small mb-3"></div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary lg" id="submitBtn">
                            Submit Documents
                        </button>
                        <a href="@Url.Action("MyProfile")" class="btn btn-link btn-sm text-muted">
                            Cancel and Return
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Information Column -->
        <div class="col-lg-4">
            <div class="lm-card p-4 h-100">
                <h5 class="fw-bold mb-4">Benefits of Verification</h5>
                
                <div class="d-flex mb-4">
                    <div class="text-success me-3"><i class="bi bi-shield-check fs-4"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Trust Badge</h6>
                        <p class="text-muted smaller mb-0">Get a verification badge on your public profile immediately.</p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="text-primary me-3"><i class="bi bi-briefcase fs-4"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Priority Selection</h6>
                        <p class="text-muted smaller mb-0">Clients are 3x more likely to hire verified professionals.</p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="text-warning me-3"><i class="bi bi-lightning-charge fs-4"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Fast-Track Payouts</h6>
                        <p class="text-muted smaller mb-0">Verified accounts benefit from faster transaction processing.</p>
                    </div>
                </div>

                <hr class="my-4 opacity-50">

                <div class="bg-primary-soft p-3 rounded-3">
                    <h6 class="fw-bold small text-uppercase mb-2">Privacy Note</h6>
                    <p class="smaller mb-0 opacity-75">Your documents are encrypted and used solely for identification. We never share your ID data.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal remains mostly similar but follows design system -->
<div class="modal fade" id="cameraModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body p-0 overflow-hidden rounded-3">
                <div class="position-relative" style="background: #000; min-height: 400px;">
                    <video id="cameraVideo" autoplay playsinline class="w-100 h-100" style="object-fit: cover;"></video>
                    <canvas id="cameraCanvas" class="d-none"></canvas>
                    
                    <div id="cameraLoading" class="position-absolute inset-0 d-flex align-items-center justify-content-center bg-black">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                    
                    <div id="cameraError" class="position-absolute inset-0 d-none align-items-center justify-content-center bg-black text-white text-center p-4">
                        <div>
                            <i class="bi bi-camera-video-off fs-1 mb-3"></i>
                            <p class="mb-0">Please enable camera access</p>
                        </div>
                    </div>
                    
                    <div id="captureOverlay" class="position-absolute inset-0 d-none bg-black">
                        <img id="capturedImage" class="w-100 h-100" style="object-fit: contain;" />
                    </div>

                    <!-- Close Button -->
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3" data-bs-dismiss="modal"></button>
                </div>

                <div class="p-4 text-center bg-white">
                    <div id="cameraInstructions" class="small text-muted mb-4 px-3">
                        Align your face and ID within the frame and ensure good lighting.
                    </div>
                    
                    <div id="captureControls">
                        <button type="button" class="btn btn-primary rounded-circle p-0" id="btnCapture" style="width: 64px; height: 64px;">
                            <i class="bi bi-camera fs-3"></i>
                        </button>
                    </div>
                    
                    <div id="confirmControls" class="d-none">
                        <div class="d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary w-50" id="btnRetake">
                                Try Again
                            </button>
                            <button type="button" class="btn btn-success w-50" id="btnConfirmCapture">
                                Use Photo
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Camera stream reference
        let cameraStream = null;
        let capturedImageData = null;

        document.addEventListener('DOMContentLoaded', function() {
            checkVerificationStatus();
            setupImagePreviews();
            setupFormSubmission();
            setupCameraFunctionality();
        });

        function checkVerificationStatus() {
            fetch('@Url.Action("IdVerificationStatus")')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        updateStatusUI(data.status);
                    }
                })
                .catch(() => {
                    document.getElementById('verificationStatus').innerHTML = 
                        '<div class="alert alert-warning">Unable to check verification status.</div>';
                });
        }

        function updateStatusUI(status) {
            let statusHtml = '';

            if (status.hasSubmitted) {
                const alertClass = status.status === 'Approved' ? 'alert-success' : 
                                  status.status === 'Rejected' ? 'alert-danger' : 'alert-info';
                const icon = status.status === 'Approved' ? 'bi-check-circle-fill' : 
                            status.status === 'Rejected' ? 'bi-x-circle-fill' : 'bi-clock-fill';

                statusHtml = `
                    <div class="alert ${alertClass}">
                        <h5><i class="bi ${icon}"></i> Verification Status: ${status.status}</h5>
                        <p class="mb-1">Submitted: ${new Date(status.submittedAt).toLocaleDateString()}</p>
                        ${status.rejectionReason ? `<p class="mb-0 text-danger"><strong>Reason:</strong> ${status.rejectionReason}</p>` : ''}
                    </div>
                `;

                // Hide form if approved or pending
                if (status.status === 'Approved' || status.status === 'Pending' || status.status === 'InReview') {
                    document.getElementById('idVerificationForm').style.display = 'none';
                }
            } else {
                statusHtml = '<div class="alert alert-info"><i class="bi bi-info-circle"></i> Please complete the form below to verify your identity.</div>';
            }

            document.getElementById('verificationStatus').innerHTML = statusHtml;
        }

        function setupImagePreviews() {
            document.getElementById('frontDocument').addEventListener('change', function() {
                previewImage(this, 'frontPreview');
            });
            document.getElementById('backDocument').addEventListener('change', function() {
                previewImage(this, 'backPreview');
            });
        }

        function previewImage(input, previewId) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById(previewId);
                    preview.classList.remove('d-none');
                    preview.querySelector('img').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // ============================================
        // CAMERA FUNCTIONALITY
        // ============================================
        function setupCameraFunctionality() {
            const btnOpenCamera = document.getElementById('btnOpenCamera');
            const btnCapture = document.getElementById('btnCapture');
            const btnRetake = document.getElementById('btnRetake');
            const btnConfirmCapture = document.getElementById('btnConfirmCapture');
            const btnRemoveSelfie = document.getElementById('btnRemoveSelfie');
            const cameraModal = document.getElementById('cameraModal');

            // Open camera modal
            btnOpenCamera.addEventListener('click', function() {
                const modal = new bootstrap.Modal(cameraModal);
                modal.show();
                startCamera();
            });

            // Capture photo
            btnCapture.addEventListener('click', capturePhoto);

            // Retake photo
            btnRetake.addEventListener('click', retakePhoto);

            // Confirm capture
            btnConfirmCapture.addEventListener('click', confirmCapture);

            // Remove selfie
            btnRemoveSelfie.addEventListener('click', removeSelfie);

            // Stop camera when modal is closed
            cameraModal.addEventListener('hidden.bs.modal', stopCamera);
        }

        async function startCamera() {
            const video = document.getElementById('cameraVideo');
            const loadingDiv = document.getElementById('cameraLoading');
            const errorDiv = document.getElementById('cameraError');

            // Reset UI
            loadingDiv.classList.remove('d-none');
            errorDiv.classList.add('d-none');
            errorDiv.classList.remove('d-flex');
            document.getElementById('captureOverlay').classList.add('d-none');
            document.getElementById('captureControls').classList.remove('d-none');
            document.getElementById('confirmControls').classList.add('d-none');
            document.getElementById('cameraInstructions').classList.remove('d-none');

            try {
                // Request front camera with ideal settings
                const constraints = {
                    video: {
                        facingMode: 'user', // Front camera
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    },
                    audio: false
                };

                cameraStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = cameraStream;

                // Wait for video to be ready
                video.onloadedmetadata = function() {
                    loadingDiv.classList.add('d-none');
                    video.play();
                };
            } catch (error) {
                console.error('Camera error:', error);
                loadingDiv.classList.add('d-none');
                errorDiv.classList.remove('d-none');
                errorDiv.classList.add('d-flex');
            }
        }

        function stopCamera() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
                cameraStream = null;
            }
            const video = document.getElementById('cameraVideo');
            video.srcObject = null;
        }

        function capturePhoto() {
            const video = document.getElementById('cameraVideo');
            const canvas = document.getElementById('cameraCanvas');
            const captureOverlay = document.getElementById('captureOverlay');
            const capturedImage = document.getElementById('capturedImage');

            // Set canvas size to match video
            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;

            // Draw video frame to canvas
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            // Get image data
            capturedImageData = canvas.toDataURL('image/jpeg', 0.9);

            // Show captured image
            capturedImage.src = capturedImageData;
            captureOverlay.classList.remove('d-none');

            // Switch controls
            document.getElementById('captureControls').classList.add('d-none');
            document.getElementById('confirmControls').classList.remove('d-none');
            document.getElementById('cameraInstructions').classList.add('d-none');
        }

        function retakePhoto() {
            const captureOverlay = document.getElementById('captureOverlay');
            captureOverlay.classList.add('d-none');

            // Switch controls back
            document.getElementById('captureControls').classList.remove('d-none');
            document.getElementById('confirmControls').classList.add('d-none');
            document.getElementById('cameraInstructions').classList.remove('d-none');

            capturedImageData = null;
        }

        function confirmCapture() {
            if (!capturedImageData) return;

            // Store in hidden input
            document.getElementById('capturedSelfieData').value = capturedImageData;

            // Create a File object from the data URL and set it to the file input
            const byteString = atob(capturedImageData.split(',')[1]);
            const mimeString = capturedImageData.split(',')[0].split(':')[1].split(';')[0];
            const ab = new ArrayBuffer(byteString.length);
            const ia = new Uint8Array(ab);
            for (let i = 0; i < byteString.length; i++) {
                ia[i] = byteString.charCodeAt(i);
            }
            const blob = new Blob([ab], { type: mimeString });
            const file = new File([blob], 'selfie.jpg', { type: 'image/jpeg' });

            // Create a DataTransfer to set the file
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            document.getElementById('selfie').files = dataTransfer.files;

            // Show preview
            const preview = document.getElementById('selfiePreview');
            preview.classList.remove('d-none');
            preview.querySelector('img').src = capturedImageData;

            // Update button text
            document.getElementById('btnOpenCamera').innerHTML = '<i class="bi bi-camera-fill me-2"></i>Retake Selfie';

            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('cameraModal'));
            modal.hide();
        }

        function removeSelfie() {
            // Clear file input
            document.getElementById('selfie').value = '';
            document.getElementById('capturedSelfieData').value = '';
            capturedImageData = null;

            // Hide preview
            document.getElementById('selfiePreview').classList.add('d-none');

            // Reset button
            document.getElementById('btnOpenCamera').innerHTML = '<i class="bi bi-camera-fill me-2"></i>Take Selfie';
        }

        function setupFormSubmission() {
            document.getElementById('idVerificationForm').addEventListener('submit', async function(e) {
                e.preventDefault();

                const submitBtn = document.getElementById('submitBtn');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Uploading...';

                try {
                    // Upload files first
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                    
                    const frontFile = document.getElementById('frontDocument').files[0];
                    const backFile = document.getElementById('backDocument').files[0];
                    const selfieFile = document.getElementById('selfie').files[0];

                    if (!frontFile) {
                        throw new Error('Front document is required');
                    }

                    formData.append('frontDocument', frontFile);
                    if (backFile) formData.append('backDocument', backFile);
                    if (selfieFile) formData.append('selfie', selfieFile);

                    // Upload files
                    const uploadResponse = await fetch('/api/upload/id-documents', {
                        method: 'POST',
                        body: formData
                    });

                    const uploadResult = await uploadResponse.json();

                    if (!uploadResult.success) {
                        throw new Error(uploadResult.message || 'Failed to upload documents');
                    }

                    // Now submit verification request
                    const requestData = {
                        DocumentType: document.getElementById('documentType').value,
                        DocumentNumber: document.getElementById('documentNumber').value,
                        DocumentCountry: document.getElementById('documentCountry').value,
                        FrontDocumentUrl: uploadResult.data.frontUrl,
                        BackDocumentUrl: uploadResult.data.backUrl,
                        SelfieUrl: uploadResult.data.selfieUrl
                    };

                    const response = await fetch('@Url.Action("SubmitIdVerification")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify(requestData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        document.getElementById('idVerificationForm').style.display = 'none';
                        document.getElementById('verificationStatus').innerHTML = `
                            <div class="alert alert-success">
                                <h5><i class="bi bi-check-circle-fill"></i> Submitted Successfully!</h5>
                                <p>Your ID verification has been submitted and is pending review. We'll notify you once it's processed.</p>
                            </div>
                        `;
                    } else {
                        throw new Error(result.message || 'Failed to submit verification');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    document.getElementById('submitError').classList.remove('d-none');
                    document.getElementById('submitError').textContent = error.message || 'An error occurred. Please try again.';
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-upload me-2"></i>Submit for Verification';
                }
            });
        }
    </script>
}
