@model LaborBLL.ModelVM.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="auth-container fade-in">
    <div class="auth-card">
        <div class="lm-card p-4 pb-3">
            <div class="text-center mb-4">
                <div class="bg-primary-soft p-3 rounded-circle d-inline-block mb-3">
                    <i class="bi bi-shield-lock fs-2 text-primary"></i>
                </div>
                <h4 class="fw-bold mb-1">Reset Password</h4>
                <p class="text-muted small">Create a new password for your account.</p>
            </div>
            
            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger smaller mb-3"></div>

                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label text-uppercase small fw-bold">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="NewPassword" class="form-control border-start-0 ps-1" type="password" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger smaller"></span>
                    <div class="form-text smaller text-muted">
                        Password must be at least 6 characters long.
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label text-uppercase small fw-bold">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-1" type="password" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger smaller"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary lg">
                        <i class="bi bi-check-circle me-2"></i>Reset Password
                    </button>
                </div>
            </form>

            <div class="border-top mt-4 pt-3 text-center">
                <p class="smaller text-muted mb-0">
                    Remember your password? 
                    <a asp-action="Login" class="text-primary fw-bold text-decoration-none ms-1">Sign In</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
