@model LaborBLL.ModelVM.UserProfileDisplayViewModel
@{
    ViewData["Title"] = "Upload Profile Picture";
}

<div class="auth-container fade-in">
    <div class="auth-card">
        <div class="lm-card p-4">
            <div class="text-center mb-4">
                <i class="bi bi-camera-fill fs-1 text-primary mb-2"></i>
                <h4 class="fw-bold">Update Profile Photo</h4>
                <p class="text-muted small">Choose a photo that clearly shows your face</p>
            </div>

            <div class="text-center mb-4">
                <div class="position-relative d-inline-block p-1 border rounded-circle">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" 
                             alt="Current Profile" 
                             class="rounded-circle"
                             style="width: 120px; height: 120px; object-fit: cover;"
                             id="current-picture" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                             style="width: 120px; height: 120px;"
                             id="current-picture-placeholder">
                            <i class="bi bi-person-fill text-muted opacity-50" style="font-size: 60px;"></i>
                        </div>
                    }
                </div>
            </div>

            <form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" id="uploadForm">
                <div class="mb-4">
                    <label for="profilePicture" class="form-label text-uppercase small fw-bold">Select Image File</label>
                    <input type="file" 
                           class="form-control" 
                           id="profilePicture" 
                           name="profilePicture"
                           accept="image/jpeg,image/png,image/gif"
                           required />
                    <div class="form-text smaller mt-2">
                        <i class="bi bi-info-circle me-1"></i>
                        JPG, PNG, GIF • Max 5MB
                    </div>
                </div>

                <!-- Preview Container -->
                <div id="previewContainer" class="text-center mb-4 d-none">
                    <div class="small fw-bold text-uppercase text-primary mb-2">New Photo Preview</div>
                    <div class="p-1 border border-primary rounded-circle d-inline-block">
                        <img id="imagePreview" class="rounded-circle" 
                             style="width: 120px; height: 120px; object-fit: cover;" />
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger p-2 small mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                    </div>
                }

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary" id="btnUpload">
                        <i class="bi bi-cloud-upload me-1"></i>Save Changes
                    </button>
                    <a href="@Url.Action("MyProfile", "Account")" class="btn btn-link btn-sm text-muted">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fileInput = document.getElementById('profilePicture');
            const previewContainer = document.getElementById('previewContainer');
            const imagePreview = document.getElementById('imagePreview');
            const uploadForm = document.getElementById('uploadForm');
            const btnUpload = document.getElementById('btnUpload');

            // Show preview when file is selected
            fileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                
                if (file) {
                    // Validate file size (5MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert('File size exceeds 5MB. Please choose a smaller image.');
                        fileInput.value = '';
                        previewContainer.classList.add('d-none');
                        return;
                    }

                    // Show preview
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imagePreview.src = e.target.result;
                        previewContainer.classList.remove('d-none');
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Form submission with loading state
            uploadForm.addEventListener('submit', function() {
                if (fileInput.files.length > 0) {
                    btnUpload.disabled = true;
                    btnUpload.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';
                }
            });
        });
    </script>
}
