@model LaborBLL.ModelVM.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="auth-container fade-in">
    <div class="auth-card">
        <div class="lm-card p-4 pb-3">
            <div class="text-center mb-4">
                <div class="bg-warning-soft p-3 rounded-circle d-inline-block mb-3">
                    <i class="bi bi-key fs-2 text-warning"></i>
                </div>
                <h4 class="fw-bold mb-1">Forgot Password?</h4>
                <p class="text-muted small">Enter your email and we'll send you instructions to reset your password.</p>
            </div>
            
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger smaller mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label text-uppercase small fw-bold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control border-start-0 ps-1" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger smaller"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary lg">
                        <i class="bi bi-send me-2"></i>Send Reset Link
                    </button>
                </div>
            </form>

            <div class="border-top mt-4 pt-3 text-center">
                <p class="smaller text-muted mb-0">
                    Remember your password? 
                    <a asp-action="Login" class="text-primary fw-bold text-decoration-none ms-1">Sign In</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
