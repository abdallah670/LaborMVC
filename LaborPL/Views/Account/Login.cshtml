@model LaborBLL.ModelVM.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="auth-container fade-in">
    <div class="auth-card">
        <div class="lm-card p-4 pb-3">
            <div class="text-center mb-4">
                <div class="bg-primary-soft p-3 rounded-circle d-inline-block mb-3">
                    <i class="bi bi-person-circle fs-2 text-primary"></i>
                </div>
                <h4 class="fw-bold mb-1">Welcome Back</h4>
                <p class="text-muted small">Access your Labor Marketplace account</p>
            </div>
            
            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger smaller mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-uppercase small fw-bold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control border-start-0 ps-1" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger smaller"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label text-uppercase small fw-bold mb-0">Password</label>
                        <a asp-action="ForgotPassword" class="smaller text-primary fw-bold text-decoration-none">Forgot?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-shield-lock"></i>
                        </span>
                        <input asp-for="Password" class="form-control border-start-0 ps-1" type="password" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger smaller"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label smaller text-muted">Keep me signed in</label>
                    </div>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary lg">
                        Sign In
                    </button>
                </div>
            </form>

            <div class="border-top mt-4 pt-3 text-center">
                <p class="smaller text-muted mb-0">
                    Don't have an account? 
                    <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-primary fw-bold text-decoration-none ms-1">Create an account</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
