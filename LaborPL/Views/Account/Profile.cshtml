@model LaborBLL.ModelVM.UserProfileDisplayViewModel
@{
    ViewData["Title"] = Model.FirstName + " " + Model.LastName + " - Profile";
    Layout = "_Layout";
}

<div class="container-fluid px-0 fade-in">
    <!-- Premium Profile Header -->
    <div class="profile-header mb-5">
        <div class="profile-avatar-wrapper">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Profile" class="profile-avatar-lg shadow-sm" />
            }
            else
            {
                <div class="profile-avatar-placeholder-lg shadow-sm">
                    <span>@(Model.FirstName?.FirstOrDefault())@(Model.LastName?.FirstOrDefault())</span>
                </div>
            }
        </div>
    </div>

    <div class="container mt-n4">
        <div class="row g-4">
            <!-- Left Column: User Context -->
            <div class="col-lg-4">
                <div class="lm-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h4>
                            <p class="text-muted small mb-0"><i class="bi bi-patch-check-fill text-primary me-1"></i>Verified Member</p>
                        </div>
                        @if (Model.IDVerified)
                        {
                            <span class="badge lm-status--success" title="ID Verified">
                                <i class="bi bi-shield-check"></i>
                            </span>
                        }
                    </div>

                    @if (Model.AverageRating.HasValue)
                    {
                        <div class="d-flex align-items-center mb-4">
                            <div class="text-warning me-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star-fill @(i <= Math.Round(Model.AverageRating.Value) ? "" : "text-muted opacity-25")"></i>
                                }
                            </div>
                            <span class="fw-bold me-1">@Model.AverageRating?.ToString("0.0")</span>
                            <span class="text-muted small">(@Model.TotalRatingsCount)</span>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Index", "Chat", new { userId = Model.Id })" class="btn btn-primary">
                            <i class="bi bi-chat-dots me-2"></i>Send Message
                        </a>
                        @if (Model.IsWorker)
                        {
                            <button class="btn btn-outline-primary">
                                <i class="bi bi-calendar-event me-2"></i>Book Now
                            </button>
                        }
                    </div>

                    <div class="border-top pt-3 mt-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Location</span>
                            <span class="fw-bold small">@(Model.Location ?? Model.Country ?? "Global")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Member Since</span>
                            <span class="fw-bold small">@Model.MemberSince.ToString("MMM yyyy")</span>
                        </div>
                    </div>
                </div>

                <!-- Quick Stats Grid -->
                <div class="row g-2">
                    @if (Model.IsWorker)
                    {
                        <div class="col-6">
                            <div class="profile-stat-item">
                                <span class="profile-stat-value">@Model.CompletedJobsAsWorker</span>
                                <span class="profile-stat-label">Jobs Done</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="profile-stat-item">
                                <span class="profile-stat-value text-warning">@Model.TotalRatingsCount</span>
                                <span class="profile-stat-label">Reviews</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column: Details & Reviews -->
            <div class="col-lg-8">
                <div class="lm-card p-4 mb-4">
                    <h5 class="fw-bold mb-3">About</h5>
                    <p class="text-secondary leading-relaxed mb-4">
                        @(Model.Bio ?? "No bio provided by the user.")
                    </p>

                    @if (!string.IsNullOrEmpty(Model.Skills))
                    {
                        <h6 class="fw-bold small text-uppercase text-muted mb-3">Expertise</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skill in Model.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-light text-primary border px-3 py-2">@skill.Trim()</span>
                            }
                        </div>
                    }
                </div>

                <!-- Reviews Section -->
                @if (Model.RecentRatings != null && Model.RecentRatings.Any())
                {
                    <h5 class="fw-bold mb-3 px-1">Recent Reviews</h5>
                    <div class="row g-3">
                        @foreach (var rating in Model.RecentRatings.OrderByDescending(r => r.CreatedAt).Take(6))
                        {
                            <div class="col-md-6">
                                <div class="lm-card p-3 h-100 shadow-sm border-0 bg-light-subtle">
                                    <div class="d-flex justify-content-between mb-2">
                                        <div class="text-warning small">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi bi-star@(i <= rating.Score ? "-fill" : "")"></i>
                                            }
                                        </div>
                                        <span class="text-muted smaller">@rating.CreatedAt.ToString("MMM yyyy")</span>
                                    </div>
                                    <p class="small text-secondary mb-2 fst-italic">"@rating.comment"</p>
                                    @if (!string.IsNullOrEmpty(rating.RaterName))
                                    {
                                        <div class="text-end fw-bold smaller">— @rating.RaterName</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
