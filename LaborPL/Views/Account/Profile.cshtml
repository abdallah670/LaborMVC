@model LaborBLL.ModelVM.ProfileViewModel
@{
    ViewData["Title"] = Model.FirstName + " " + Model.LastName + " - Profile";
    Layout = "_Layout";
}

<div class="profile-container fade-in">
    <div class="row">
        <!-- Profile Sidebar -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow profile-sidebar">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="Profile Picture" class="profile-avatar" />
                    }
                    else
                    {
                        <div class="profile-avatar-placeholder">    
                            <span>@(Model.FirstName?.FirstOrDefault())@(Model.LastName?.FirstOrDefault())</span>
                        </div>
                    }
                    
                    <h4 class="profile-name">@Model.FirstName @Model.LastName</h4>
                    <p class="profile-email">@Model.Email</p>
                    
                    @if (Model.IDVerified)
                    {
                        <span class="profile-badge verified">
                            <i class="bi bi-patch-check-fill me-1"></i>ID Verified
                        </span>
                    }
                    else
                    {
                        <span class="profile-badge not-verified">
                            <i class="bi bi-exclamation-triangle me-1"></i>ID Not Verified
                        </span>
                    }

                    @if (Model.AverageRating.HasValue)
                    {
                        <div class="profile-rating mt-3">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star-fill star @(i <= Math.Round(Model.AverageRating.Value) ? "filled" : "empty")"></i>
                            }
                            <span class="ms-2 text-muted">(@Model.AverageRating?.ToString("0.0"))</span>
                        </div>
                        <small class="text-muted">@Model.TotalRatingsReceived reviews</small>
                    }

                    <p class="profile-member-since mt-3">
                        <i class="bi bi-calendar3 me-1"></i>
                        Member since: @Model.CreatedAt.ToString("MMM dd, yyyy")
                    </p>

                    <!-- Contact Button -->
                    <a href="@Url.Action("Index", "Chat", new { userId = Model.Id })" class="btn btn-primary mt-3">
                        <i class="bi bi-chat-dots me-2"></i>Contact
                    </a>
                </div>
            </div>
        </div>

        <!-- Profile Details -->
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary-gradient text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person me-2"></i>@Model.FirstName's Profile
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-1"><i class="bi bi-phone me-1"></i>Phone</h6>
                            <p class="mb-3">@(Model.PhoneNumber ?? "Not provided")</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>Location</h6>
                            <p class="mb-3">@(Model.Location ?? Model.Country ?? "Not provided")</p>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h6 class="text-muted mb-1"><i class="bi bi-text-paragraph me-1"></i>Bio</h6>
                        <p class="mb-3">@(Model.Bio ?? "No bio provided")</p>
                    </div>
                    
                    <div class="mb-4">
                        <h6 class="text-muted mb-1"><i class="bi bi-tools me-1"></i>Skills</h6>
                        @if (!string.IsNullOrEmpty(Model.Skills))
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var skill in Model.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-primary">@skill.Trim()</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="mb-0 text-muted">No skills listed</p>
                        }
                    </div>
                </div>
            </div>

            <!-- User Statistics -->
            @if (Model.IsWorker)
            {
                <div class="card shadow-sm mb-4 mt-4">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Worker Statistics</h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4">
                                <h3 class="text-primary">@Model.CompletedJobsAsWorker</h3>
                                <small class="text-muted">Completed Jobs</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-success">$@Model.TotalEarnings.ToString("N2")</h3>
                                <small class="text-muted">Total Earnings</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-warning">@Model.TotalRatingsReceived</h3>
                                <small class="text-muted"> Reviews</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.IsPoster)
            {
                <div class="card shadow-sm mb-4 mt-4">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-clipboard-plus me-2"></i>Poster Statistics</h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4">
                                <h3 class="text-primary">@Model.TasksPosted</h3>
                                <small class="text-muted">Tasks Posted</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-info">@Model.TotalHires</h3>
                                <small class="text-muted">Total Hires</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-danger">$@Model.TotalSpent.ToString("N2")</h3>
                                <small class="text-muted">Total Spent</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Reviews -->
            @if (Model.Ratings != null && Model.Ratings.Any())
            {
                <div class="card shadow-sm mt-4">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-star me-2"></i>Reviews</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var rating in Model.Ratings.OrderByDescending(r => r.CreatedAt).Take(10))
                        {
                            <div class="border-bottom pb-2 mb-2">
                                <div class="d-flex justify-content-between">
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi bi-star@(i <= rating.Score ? "-fill" : "")"></i>
                                        }
                                    </div>
                                    <small class="text-muted">@rating.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                @if (!string.IsNullOrEmpty(rating.comment))
                                {
                                    <p class="mb-1 small">@rating.comment</p>
                                }
                                @if (rating.RaterId != null)
                                {
                                    <small class="text-muted">- @rating.RaterName</small>
                                }
                            </div>
                        }
                        @if (Model.Ratings.Count > 10)
                        {
                            <div class="text-center mt-3">
                                <span class="text-muted">And @((Model.Ratings.Count - 10)) more reviews...</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
