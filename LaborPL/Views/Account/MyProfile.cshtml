@model LaborBLL.ModelVM.ProfileViewModel
@using LaborDAL.Enums
@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";

    string GetTierBadgeClass(VerificationTier tier) => tier switch
    {
        VerificationTier.IDVerified => "bg-success",
        VerificationTier.PhoneVerified => "bg-info",
        VerificationTier.EmailVerified => "bg-primary",
        _ => "bg-secondary"
    };
}

<div class="profile-container fade-in">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Profile Sidebar -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow profile-sidebar">
                <div class="card-body">
                    <div class="profile-picture-container">
                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl" alt="Profile Picture" class="profile-avatar" />
                        }
                        else
                        {
                            <div class="profile-avatar-placeholder">    
                                <span>@(Model.FirstName?.FirstOrDefault())@(Model.LastName?.FirstOrDefault())</span>
                            </div>
                        }
                        <a href="@Url.Action("UploadProfilePicture", "Account")" class="profile-picture-edit-btn" title="Change Profile Picture">
                            <i class="bi bi-camera-fill"></i>
                        </a>
                    </div>
                    
                    <h4 class="profile-name">@Model.FirstName @Model.LastName</h4>
                    <p class="profile-email">@Model.Email</p>
                    
                    @if (Model.IDVerified)
                    {
                        <span class="profile-badge verified">
                            <i class="bi bi-patch-check-fill me-1"></i>ID Verified
                        </span>
                    }
                    else
                    {
                        <span class="profile-badge not-verified">
                            <i class="bi bi-exclamation-triangle me-1"></i>ID Not Verified
                        </span>
                    }

                    @if (Model.AverageRating.HasValue)
                    {
                        <div class="profile-rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star-fill star @(i <= Math.Round(Model.AverageRating.Value) ? "filled" : "empty")"></i>
                            }
                            <span class="ms-2 text-muted">(@Model.AverageRating?.ToString("0.0"))</span>
                        </div>
                        <small class="text-muted">@Model.TotalRatingsReceived reviews</small>
                    }

                    <p class="profile-member-since">
                        <i class="bi bi-calendar3 me-1"></i>
                        Member since: @Model.CreatedAt.ToString("MMM dd, yyyy")
                    </p>

                    <!-- Verification Status -->
                    <div class="verification-status mt-3">
                        <h6 class="text-muted mb-2">Verification Status</h6>
                        
                        <!-- Email Verification -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-envelope me-2"></i>
                                <small>Email</small>
                            </div>
                            @if (Model.IsEmailConfirmed)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Verified
                                </span>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-warning">
                                        <i class="bi bi-exclamation-circle"></i> Not Verified
                                    </span>
                                    <form asp-action="ResendEmailConfirmation" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2">
                                            <small>Resend</small>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>

                        <!-- Phone Verification -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-phone me-2"></i>
                                <small>Phone</small>
                            </div>
                            @if (Model.PhoneNumberVerified)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Verified
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(Model.PhoneNumber))
                            {
                                <a href="@Url.Action("VerifyPhone", "Account")" class="badge bg-warning text-decoration-none">
                                    <i class="bi bi-exclamation-circle"></i> Verify Now
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-dash-circle"></i> Not Set
                                </span>
                            }
                        </div>

                        <!-- ID Verification -->
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-person-badge me-2"></i>
                                <small>ID</small>
                            </div>
                            @if (Model.IDVerified)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Verified
                                </span>
                            }
                            else
                            {
                                <a href="@Url.Action("IdVerification", "Account")" class="badge bg-warning text-decoration-none">
                                    <i class="bi bi-exclamation-circle"></i> Verify Now
                                </a>
                            }
                        </div>

                        <!-- Verification Tier Badge -->
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="text-muted small">Tier:</span>
                                <span class="badge @GetTierBadgeClass(Model.VerificationTier)">
                                    @Model.VerificationTier
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Form -->
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary-gradient text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Edit My Profile
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="MyProfile" method="post" class="profile-form">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="IDVerified" />
                        <input type="hidden" asp-for="AverageRating" />

                        <div asp-validation-summary="All" class="validation-summary-errors"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">
                                    <i class="bi bi-person me-1"></i>@Html.DisplayNameFor(m => m.FirstName)
                                </label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">
                                    <i class="bi bi-person me-1"></i>@Html.DisplayNameFor(m => m.LastName)
                                </label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">
                                <i class="bi bi-phone me-1"></i>@Html.DisplayNameFor(m => m.PhoneNumber)
                            </label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                        </div>

                        <!-- Location Section with Map Picker -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Location Settings</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-crosshair me-1"></i>Auto-Detect Location
                                        </label>
                                        <div class="d-grid gap-2">
                                            <button type="button" id="detectLocationBtn" class="btn btn-outline-primary">
                                                <i class="bi bi-geo-alt-fill me-1"></i>Detect My Location
                                            </button>
                                        </div>
                                        <div id="locationStatus" class="mt-2 small"></div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-map me-1"></i>Select on Map
                                        </label>
                                        <div id="mapPicker" class="map-picker-container"></div>
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Location" class="form-label">
                                            <i class="bi bi-geo-alt me-1"></i>@Html.DisplayNameFor(m => m.Location)
                                        </label>
                                        <input asp-for="Location" class="form-control" placeholder="Your address or area" />
                                        <span asp-validation-for="Location" class="field-validation-error"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Country" class="form-label">
                                            <i class="bi bi-globe me-1"></i>@Html.DisplayNameFor(m => m.Country)
                                        </label>
                                        <input asp-for="Country" class="form-control" placeholder="Your country" />
                                        <span asp-validation-for="Country" class="field-validation-error"></span>
                                    </div>
                                </div>
                                
                                <!-- Hidden fields for coordinates -->
                                <input type="hidden" asp-for="Latitude" id="latitudeInput" />
                                <input type="hidden" asp-for="Longitude" id="longitudeInput" />
                                <input type="hidden" asp-for="LocationUrl" id="locationUrlInput" />
                                
                                <!-- Location preview -->
                                <div id="locationPreview" class="mt-3" style="display: none;">
                                    <div class="alert alert-info d-flex align-items-center" role="alert">
                                        <i class="bi bi-info-circle-fill me-2"></i>
                                        <div>
                                            <strong>Your Location:</strong>
                                            <span id="coordinatesDisplay"></span>
                                            <a id="viewOnMapLink" href="#" target="_blank" class="ms-2">
                                                <i class="bi bi-box-arrow-up-right"></i> View on Google Maps
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label">
                                <i class="bi bi-text-paragraph me-1"></i>@Html.DisplayNameFor(m => m.Bio)
                            </label>
                            <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell us about yourself, your experience, and what makes you unique..."></textarea>
                            <span asp-validation-for="Bio" class="field-validation-error"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Skills" class="form-label">
                                <i class="bi bi-tools me-1"></i>@Html.DisplayNameFor(m => m.Skills)
                            </label>
                            <input asp-for="Skills" class="form-control" placeholder="e.g., Plumbing, Electrical, Cleaning, Moving, Gardening" />
                            <small class="text-muted">Separate skills with commas</small>
                            <span asp-validation-for="Skills" class="field-validation-error"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="MyProfile" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>

                    @if (Model.IsWorker)
                    {
                        <!-- Stripe Connect Section for Workers -->
                        <div class="card mt-4 border-primary">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0"><i class="bi bi-credit-card me-2"></i>Payment Settings</h5>
                            </div>
                            <div class="card-body">
                                <div id="stripeConnectSection">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="bi bi-stripe fs-1 me-3 text-primary"></i>
                                        <div>
                                            <h6 class="mb-1">Receive Payments via Stripe</h6>
                                            <p class="mb-0 text-muted small">Connect your Stripe account to receive payments directly to your bank account.</p>
                                        </div>
                                    </div>
                                    
                                    <div id="stripeStatusContainer" class="mb-3">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <span class="ms-2 text-muted">Checking connection status...</span>
                                    </div>

                                    <a href="/Account/ConnectStripe" class="btn btn-primary" id="connectStripeBtn">
                                        <i class="bi bi-link me-1"></i>Connect Stripe Account
                                    </a>
                                </div>
                            </div>
                        </div>

                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                // Handle Connect Stripe button click explicitly
                                document.getElementById('connectStripeBtn').addEventListener('click', function(e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    window.location.href = '/Account/ConnectStripe';
                                });

                                // Check Stripe connection status
                                fetch('/Account/StripeStatus')
                                    .then(response => response.json())
                                    .then(data => {
                                        const container = document.getElementById('stripeStatusContainer');
                                        const btn = document.getElementById('connectStripeBtn');
                                        
                                        if (data.connected && data.enabled) {
                                            container.innerHTML = `
                                                <div class="alert alert-success d-flex align-items-center mb-0" role="alert">
                                                    <i class="bi bi-check-circle-fill me-2"></i>
                                                    <div>
                                                        <strong>Connected!</strong> Your Stripe account is active and ready to receive payments.
                                                        <div class="small text-muted mt-1">Account ID: ${data.accountId}</div>
                                                    </div>
                                                </div>
                                            `;
                                            btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Reconnect Stripe Account';
                                            btn.classList.remove('btn-primary');
                                            btn.classList.add('btn-outline-primary');
                                        } else if (data.connected && !data.enabled) {
                                            container.innerHTML = `
                                                <div class="alert alert-warning d-flex align-items-center mb-0" role="alert">
                                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                    <div>
                                                        <strong>Pending Verification</strong> Your Stripe account is connected but pending verification.
                                                        <div class="small text-muted mt-1">Account ID: ${data.accountId}</div>
                                                    </div>
                                                </div>
                                            `;
                                            btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Complete Stripe Setup';
                                        } else {
                                            container.innerHTML = `
                                                <div class="alert alert-info d-flex align-items-center mb-0" role="alert">
                                                    <i class="bi bi-info-circle-fill me-2"></i>
                                                    <div>
                                                        <strong>Not Connected</strong> Connect your Stripe account to start receiving payments.
                                                    </div>
                                                </div>
                                            `;
                                        }
                                    })
                                    .catch(error => {
                                        console.error('Error checking Stripe status:', error);
                                        document.getElementById('stripeStatusContainer').innerHTML = `
                                            <div class="alert alert-secondary d-flex align-items-center mb-0" role="alert">
                                                <i class="bi bi-question-circle-fill me-2"></i>
                                                <div>Unable to check Stripe status. Please try again later.</div>
                                            </div>
                                        `;
                                    });
                            });
                        </script>
                    }
                </div>
            </div>

            <!-- My Statistics -->
            @if (Model.IsWorker)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-tools me-2"></i>My Worker Statistics</h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4">
                                <h3 class="text-primary">@Model.CompletedJobsAsWorker</h3>
                                <small class="text-muted">Completed Jobs</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-success">$@Model.TotalEarnings.ToString("N2")</h3>
                                <small class="text-muted">Total Earnings</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-warning">@Model.TotalRatingsReceived</h3>
                                <small class="text-muted">Reviews</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.IsPoster)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-clipboard-plus me-2"></i>My Poster Statistics</h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4">
                                <h3 class="text-primary">@Model.TasksPosted</h3>
                                <small class="text-muted">Tasks Posted</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-info">@Model.TotalHires</h3>
                                <small class="text-muted">Total Hires</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-danger">$@Model.TotalSpent.ToString("N2")</h3>
                                <small class="text-muted">Total Spent</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- My Reviews -->
            @if (Model.Ratings != null && Model.Ratings.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0"><i class="bi bi-star me-2"></i>My Reviews</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var rating in Model.Ratings.OrderByDescending(r => r.CreatedAt).Take(5))
                        {
                            <div class="border-bottom pb-2 mb-2">
                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi bi-star@(i <= rating.Score ? "-fill" : "")"></i>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(rating.comment))
                                {
                                    <p class="mb-1 small">@rating.comment</p>
                                }
                                <small class="text-muted">@rating.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </div>
                        }
                        @if (Model.Ratings.Count > 5)
                        {
                            <a href="@Url.Action("GetMyRate", "Rating")" class="btn btn-sm btn-outline-primary">
                                View All @Model.Ratings.Count Reviews
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
          crossorigin="" />
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" 
            crossorigin=""></script>
    
    <!-- Location Service -->
    <script src="~/js/locationService.js"></script>
    <!-- Map Picker -->
    <script src="~/js/mapPicker.js"></script>
    
    <script>
        let mapPicker = null;
        let mapInitialized = false;
        
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM Content Loaded - Initializing map...');
            
            // Get initial coordinates from model or use defaults (Cairo)
            const initialLat = @(Model.Latitude?.ToString() ?? "null") || 30.0444;
            const initialLng = @(Model.Longitude?.ToString() ?? "null") || 31.2357;
            const hasExistingLocation = @(Model.Latitude.HasValue.ToString().ToLower());
            
            console.log('Initial coordinates:', initialLat, initialLng, 'Has existing:', hasExistingLocation);
            
            // Check if Leaflet is loaded
            if (typeof L === 'undefined') {
                console.error('Leaflet library not loaded!');
                document.getElementById('mapPicker').innerHTML = 
                    '<div class="alert alert-warning m-3"><i class="bi bi-exclamation-triangle"></i> Map library failed to load. Please refresh the page.</div>';
                return;
            }
            
            // Check if MapPicker is available
            if (typeof MapPicker === 'undefined') {
                console.error('MapPicker class not loaded!');
                document.getElementById('mapPicker').innerHTML = 
                    '<div class="alert alert-warning m-3"><i class="bi bi-exclamation-triangle"></i> Map component failed to load. Please refresh the page.</div>';
                return;
            }
            
            // Initialize map picker with delay to ensure container is ready
            setTimeout(function() {
                try {
                    const container = document.getElementById('mapPicker');
                    if (!container) {
                        console.error('Map container not found!');
                        return;
                    }
                    
                    console.log('Container dimensions:', container.offsetWidth, 'x', container.offsetHeight);
                    
                    // Initialize map picker
                    mapPicker = new MapPicker('mapPicker', {
                        defaultLat: initialLat,
                        defaultLng: initialLng,
                        defaultZoom: hasExistingLocation ? 15 : 12,
                        onLocationChange: function(data) {
                            console.log('Location changed:', data);
                            updateLocationFields(data);
                        }
                    });
                    
                    mapInitialized = true;
                    console.log('MapPicker initialized successfully');
                    
                    // Force multiple invalidateSize calls to ensure proper rendering
                    setTimeout(function() {
                        if (mapPicker && mapPicker.invalidateSize) {
                            console.log('Calling invalidateSize (1st attempt)');
                            mapPicker.invalidateSize();
                        }
                    }, 100);
                    
                    setTimeout(function() {
                        if (mapPicker && mapPicker.invalidateSize) {
                            console.log('Calling invalidateSize (2nd attempt)');
                            mapPicker.invalidateSize();
                        }
                    }, 500);
                    
                } catch (error) {
                    console.error('Error initializing map:', error);
                    document.getElementById('mapPicker').innerHTML = 
                        '<div class="alert alert-danger m-3"><i class="bi bi-exclamation-circle"></i> Error loading map: ' + error.message + '</div>';
                }
            }, 100);
            
            // Show existing location if available
            if (hasExistingLocation) {
                showLocationPreview(initialLat, initialLng);
            }
            
            // Auto-detect button handler
            document.getElementById('detectLocationBtn').addEventListener('click', async function() {
                const btn = this;
                const statusEl = document.getElementById('locationStatus');
                
                // Check if map is ready
                if (!mapInitialized || !mapPicker) {
                    statusEl.innerHTML = '<span class="text-warning"><i class="bi bi-exclamation-circle"></i> Please wait for the map to load...</span>';
                    return;
                }
                
                // Disable button and show loading
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Detecting...';
                statusEl.innerHTML = '<span class="text-muted"><i class="bi bi-arrow-repeat spin"></i> Getting your location...</span>';
                
                try {
                    // Check if geolocation is available
                    if (!LocationService.isGeolocationAvailable()) {
                        throw new Error('Geolocation is not supported by your browser.');
                    }
                    
                    // Get current position (returns {latitude, longitude, accuracy} directly)
                    const position = await LocationService.getCurrentPosition();
                    const { latitude, longitude } = position;
                    
                    // Reverse geocode to get address
                    const geoResult = await LocationService.reverseGeocode(latitude, longitude);
                    const address = geoResult.success ? geoResult.address : `${latitude.toFixed(6)}, ${longitude.toFixed(6)}`;
                    
                    // Update form fields
                    updateLocationFields({
                        latitude: latitude,
                        longitude: longitude,
                        address: address,
                        locationUrl: LocationService.generateGoogleMapsUrl(latitude, longitude)
                    });
                    
                    // Update map
                    if (mapPicker && mapPicker.setLocation) {
                        mapPicker.setLocation(latitude, longitude);
                        // Force map refresh after location update
                        setTimeout(function() {
                            if (mapPicker && mapPicker.invalidateSize) {
                                mapPicker.invalidateSize();
                            }
                        }, 100);
                    }
                    
                    // Show success
                    statusEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Location detected: ' + address + '</span>';
                } catch (error) {
                    console.error('Error detecting location:', error);
                    statusEl.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle"></i> ' + error.message + '</span>';
                } finally {
                    // Re-enable button
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-geo-alt-fill me-1"></i>Detect My Location';
                }
            });
        });
        
        function updateLocationFields(data) {
            document.getElementById('latitudeInput').value = data.latitude;
            document.getElementById('longitudeInput').value = data.longitude;
            document.getElementById('locationUrlInput').value = data.locationUrl || '';
            
            // Update or create location input - check both 'Location' and 'Location' (case insensitive)
            let locationInput = document.getElementById('Location') || document.querySelector('input[name="Location"]');
            if (locationInput && data.address) {
                locationInput.value = data.address;
            }
            
            // Debug log
            console.log('Updating location fields:', data);
            
            // Show preview
            showLocationPreview(data.latitude, data.longitude, data.address);
        }
        
        function showLocationPreview(lat, lng, address) {
            const preview = document.getElementById('locationPreview');
            const coordsDisplay = document.getElementById('coordinatesDisplay');
            const mapLink = document.getElementById('viewOnMapLink');
            
            if (preview && coordsDisplay && mapLink) {
                coordsDisplay.textContent = address || (lat.toFixed(6) + ', ' + lng.toFixed(6));
                mapLink.href = `https://www.google.com/maps?q=${lat},${lng}`;
                preview.style.display = 'block';
            }
        }
    </script>
}
