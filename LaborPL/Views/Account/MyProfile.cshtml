@model LaborBLL.ModelVM.UserProfileDisplayViewModel
@using LaborDAL.Enums
@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";

    string GetTierBadgeClass(VerificationTier tier) => tier switch
    {
        VerificationTier.IDVerified => "bg-success",
        VerificationTier.PhoneVerified => "bg-info",
        VerificationTier.EmailVerified => "bg-primary",
        _ => "bg-secondary"
    };
}

<div class="container-fluid px-0 fade-in">
    <!-- Premium Profile Header -->
    <div class="profile-header mb-5">
        <div class="profile-avatar-wrapper">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Profile" class="profile-avatar-lg shadow-sm" />
            }
            else
            {
                <div class="profile-avatar-placeholder-lg shadow-sm">
                    <span>@(Model.FirstName?.FirstOrDefault())@(Model.LastName?.FirstOrDefault())</span>
                </div>
            }
            <a href="@Url.Action("UploadProfilePicture", "Account")" class="btn btn-sm btn-light position-absolute bottom-0 end-0 rounded-circle p-2 shadow-sm border" title="Change Avatar">
                <i class="bi bi-camera-fill text-primary"></i>
            </a>
        </div>
    </div>

    <div class="container mt-n4">
        <div class="row g-4">
            <!-- Left Column: User Info & Quick Stats -->
            <div class="col-lg-4">
                <div class="lm-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h4>
                            <p class="text-muted small mb-0"><i class="bi bi-envelope me-1"></i>@Model.Email</p>
                        </div>
                        @if (Model.IDVerified)
                        {
                            <span class="badge lm-status--success" title="ID Verified">
                                <i class="bi bi-patch-check-fill"></i>
                            </span>
                        }
                    </div>

                    @if (Model.AverageRating.HasValue)
                    {
                        <div class="d-flex align-items-center mb-3">
                            <div class="text-warning me-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star-fill @(i <= Math.Round(Model.AverageRating.Value) ? "" : "text-muted opacity-25")"></i>
                                }
                            </div>
                            <span class="fw-bold me-1">@Model.AverageRating?.ToString("0.0")</span>
                            <span class="text-muted small">(@Model.TotalRatingsCount)</span>
                        </div>
                    }

                    <div class="border-top pt-3 mt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Verification Tier</span>
                            <span class="badge @GetTierBadgeClass(Model.VerificationTier)">@Model.VerificationTier</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Member Since</span>
                            <span class="fw-bold small">@Model.MemberSince.ToString("MMM yyyy")</span>
                        </div>
                    </div>
                </div>

                <!-- Quick Stats Grid -->
                <div class="row g-2">
                    @if (Model.IsWorker)
                    {
                        <div class="col-6">
                            <div class="profile-stat-item">
                                <span class="profile-stat-value">@Model.CompletedJobsAsWorker</span>
                                <span class="profile-stat-label">Jobs</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="profile-stat-item">
                                <span class="profile-stat-value text-success">$@Model.TotalEarnings.ToString("N0")</span>
                                <span class="profile-stat-label">Earnings</span>
                            </div>
                        </div>
                    }
                    @if (Model.IsPoster)
                    {
                        <div class="col-6">
                            <div class="profile-stat-item">
                                <span class="profile-stat-value">@Model.TasksPosted</span>
                                <span class="profile-stat-label">Posts</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="profile-stat-item">
                                <span class="profile-stat-value text-primary">$@Model.TotalSpent.ToString("N0")</span>
                                <span class="profile-stat-label">Spent</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column: Tabs Content -->
            <div class="col-lg-8">
                <div class="lm-card p-0 overflow-hidden">
                    <nav class="profile-nav nav nav-tabs border-bottom px-3">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general">
                            <i class="bi bi-person-lines-fill me-2"></i>General
                        </button>
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-professional">
                            <i class="bi bi-patch-check me-2"></i>Professional
                        </button>
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-security">
                            <i class="bi bi-shield-lock me-2"></i>Security
                        </button>
                    </nav>

                    <form asp-action="MyProfile" method="post" class="tab-content">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="MemberSince" />
                        <input type="hidden" asp-for="IDVerified" />
                        <input type="hidden" asp-for="AverageRating" />

                        <!-- Tab: General Info -->
                        <div class="tab-pane fade show active p-4" id="tab-general">
                            <h5 class="fw-bold mb-4">Basic Information</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label text-uppercase small fw-bold">First Name</label>
                                    <input asp-for="FirstName" class="form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label text-uppercase small fw-bold">Last Name</label>
                                    <input asp-for="LastName" class="form-control" />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Bio" class="form-label text-uppercase small fw-bold">Bio</label>
                                    <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell us about yourself..."></textarea>
                                    <span asp-validation-for="Bio" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Skills" class="form-label text-uppercase small fw-bold">Skills</label>
                                    <input asp-for="Skills" class="form-control" placeholder="e.g., Plumbing, Electrical, Cleaning" />
                                    <small class="text-muted">Comma separated</small>
                                </div>
                            </div>
                        </div>

                        <!-- Tab: Professional & Stripe -->
                        <div class="tab-pane fade p-4" id="tab-professional">
                            <h5 class="fw-bold mb-4">Verification & Payments</h5>
                            
                            <!-- Email/Phone Verification status -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="p-3 border rounded d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-envelope-check fs-4 text-primary me-3"></i>
                                            <div>
                                                <div class="fw-bold small">Email Verification</div>
                                                <div class="text-muted small">@(Model.IsEmailConfirmed ? "Verified" : "Action Required")</div>
                                            </div>
                                        </div>
                                        @if (Model.IsEmailConfirmed) { <i class="bi bi-check-circle-fill text-success"></i> }
                                        else { 
                                            <button formaction="@Url.Action("ResendEmailConfirmation")" class="btn btn-sm btn-outline-primary">Resend</button>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-shield-check fs-4 text-primary me-3"></i>
                                            <div>
                                                <div class="fw-bold small">ID Verification</div>
                                                <div class="text-muted small">@(Model.IDVerified ? "Verified" : "Not Verified")</div>
                                            </div>
                                        </div>
                                        @if (Model.IDVerified) { <i class="bi bi-check-circle-fill text-success"></i> }
                                        else { 
                                            <a href="@Url.Action("IdVerification")" class="btn btn-sm btn-primary">Verify</a>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (Model.IsWorker)
                            {
                                <div class="lm-card bg-light border-0">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="bi bi-stripe text-primary fs-1 me-3"></i>
                                        <h6 class="mb-0 fw-bold">Stripe Payouts</h6>
                                    </div>
                                    <div id="stripeStatusContainer" class="mb-3">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        <span class="ms-2 text-muted small">Checking status...</span>
                                    </div>
                                    <a href="/Account/ConnectStripe" class="btn btn-primary btn-sm" id="connectStripeBtn">Connect Account</a>
                                </div>
                            }
                        </div>

                        <!-- Tab: Security & Location -->
                        <div class="tab-pane fade p-4" id="tab-security">
                            <h5 class="fw-bold mb-4">Location & Security</h5>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label text-uppercase small fw-bold">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control" />
                                </div>
                                <div class="col-md-6 d-flex align-items-end">
                                    @if (!Model.PhoneNumberVerified && !string.IsNullOrEmpty(Model.PhoneNumber))
                                    {
                                        <a href="@Url.Action("VerifyPhone")" class="btn btn-outline-warning w-100">Verify Phone Now</a>
                                    }
                                </div>
                            </div>

                            <div class="lm-card border-0 bg-light p-3">
                                <h6 class="fw-bold mb-3"><i class="bi bi-geo-alt me-2 text-primary"></i>Service Areas</h6>
                                <div class="mb-3">
                                    <div id="mapPicker" class="rounded border" style="height: 200px; z-index: 1;"></div>
                                    <div class="d-flex justify-content-between mt-2">
                                        <button type="button" id="detectLocationBtn" class="btn btn-sm btn-primary">
                                            <i class="bi bi-crosshair"></i> Detect Location
                                        </button>
                                        <span id="locationStatus" class="small text-muted align-self-center"></span>
                                    </div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-8">
                                        <input asp-for="Location" class="form-control form-control-sm" placeholder="Address" />
                                    </div>
                                    <div class="col-4">
                                        <input asp-for="Country" class="form-control form-control-sm" placeholder="Country" />
                                    </div>
                                </div>
                                <input type="hidden" asp-for="Latitude" id="latitudeInput" />
                                <input type="hidden" asp-for="Longitude" id="longitudeInput" />
                                <input type="hidden" asp-for="LocationUrl" id="locationUrlInput" />
                            </div>
                        </div>

                        <div class="p-4 bg-light border-top d-flex justify-content-between align-items-center">
                            <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> Changes will be saved globally</p>
                            <button type="submit" class="btn btn-primary px-4">Save Profile</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
          crossorigin="" />
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" 
            crossorigin=""></script>
    
    <!-- Location Service -->
    <script src="~/js/locationService.js"></script>
    <!-- Map Picker -->
    <script src="~/js/mapPicker.js"></script>
    
    <script>
        let mapPicker = null;
        let mapInitialized = false;
        
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM Content Loaded - Initializing map...');
            
            // Stripe status check
            const stripeStatusContainer = document.getElementById('stripeStatusContainer');
            const connectStripeBtn = document.getElementById('connectStripeBtn');
            
            if (stripeStatusContainer) {
                fetch('/Account/StripeStatus')
                    .then(response => response.json())
                    .then(data => {
                        if (data.connected && data.enabled) {
                            stripeStatusContainer.innerHTML = `
                                <div class="alert alert-success d-flex align-items-center mb-0 p-2 small" role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <div>
                                        <strong>Connected!</strong> Ready to receive payments.
                                        <div class="opacity-75">ID: ${data.accountId}</div>
                                    </div>
                                </div>
                            `;
                            connectStripeBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Reconnect Stripe';
                            connectStripeBtn.classList.replace('btn-primary', 'btn-outline-primary');
                        } else if (data.connected && !data.enabled) {
                            stripeStatusContainer.innerHTML = `
                                <div class="alert alert-warning d-flex align-items-center mb-0 p-2 small" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <div>
                                        <strong>Pending Verification</strong> Check your Stripe dashboard.
                                    </div>
                                </div>
                            `;
                            connectStripeBtn.innerHTML = 'Complete Stripe Setup';
                        } else {
                            stripeStatusContainer.innerHTML = `
                                <div class="alert alert-info d-flex align-items-center mb-0 p-2 small" role="alert">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <div>Connect Stripe to receive payments.</div>
                                </div>
                            `;
                        }
                    })
                    .catch(error => {
                        console.error('Error checking Stripe status:', error);
                        stripeStatusContainer.innerHTML = '<span class="text-danger small">Unable to verify Stripe status.</span>';
                    });
            }

            // Get initial coordinates from model or use defaults (Cairo)
            const initialLat = @(Model.Latitude?.ToString() ?? "null") || 30.0444;
            const initialLng = @(Model.Longitude?.ToString() ?? "null") || 31.2357;
            const hasExistingLocation = @(Model.Latitude.HasValue.ToString().ToLower());
            
            console.log('Initial coordinates:', initialLat, initialLng, 'Has existing:', hasExistingLocation);
            
            // Check if Leaflet is loaded
            if (typeof L === 'undefined') {
                console.error('Leaflet library not loaded!');
                document.getElementById('mapPicker').innerHTML = 
                    '<div class="alert alert-warning m-3"><i class="bi bi-exclamation-triangle"></i> Map library failed to load. Please refresh the page.</div>';
                return;
            }
            
            // Check if MapPicker is available
            if (typeof MapPicker === 'undefined') {
                console.error('MapPicker class not loaded!');
                document.getElementById('mapPicker').innerHTML = 
                    '<div class="alert alert-warning m-3"><i class="bi bi-exclamation-triangle"></i> Map component failed to load. Please refresh the page.</div>';
                return;
            }
            
            // Initialize map picker with delay to ensure container is ready
            setTimeout(function() {
                try {
                    const container = document.getElementById('mapPicker');
                    if (!container) {
                        console.error('Map container not found!');
                        return;
                    }
                    
                    console.log('Container dimensions:', container.offsetWidth, 'x', container.offsetHeight);
                    
                    // Initialize map picker
                    mapPicker = new MapPicker('mapPicker', {
                        defaultLat: initialLat,
                        defaultLng: initialLng,
                        defaultZoom: hasExistingLocation ? 15 : 12,
                        onLocationChange: function(data) {
                            console.log('Location changed:', data);
                            updateLocationFields(data);
                        }
                    });
                    
                    mapInitialized = true;
                    console.log('MapPicker initialized successfully');
                    
                    // Force multiple invalidateSize calls to ensure proper rendering
                    setTimeout(function() {
                        if (mapPicker && mapPicker.invalidateSize) {
                            console.log('Calling invalidateSize (1st attempt)');
                            mapPicker.invalidateSize();
                        }
                    }, 100);
                    
                    setTimeout(function() {
                        if (mapPicker && mapPicker.invalidateSize) {
                            console.log('Calling invalidateSize (2nd attempt)');
                            mapPicker.invalidateSize();
                        }
                    }, 500);
                    
                } catch (error) {
                    console.error('Error initializing map:', error);
                    document.getElementById('mapPicker').innerHTML = 
                        '<div class="alert alert-danger m-3"><i class="bi bi-exclamation-circle"></i> Error loading map: ' + error.message + '</div>';
                }
            }, 100);
            
            // Show existing location if available
            if (hasExistingLocation) {
                showLocationPreview(initialLat, initialLng);
            }
            
            // Auto-detect button handler
            document.getElementById('detectLocationBtn').addEventListener('click', async function() {
                const btn = this;
                const statusEl = document.getElementById('locationStatus');
                
                // Check if map is ready
                if (!mapInitialized || !mapPicker) {
                    statusEl.innerHTML = '<span class="text-warning"><i class="bi bi-exclamation-circle"></i> Please wait for the map to load...</span>';
                    return;
                }
                
                // Disable button and show loading
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Detecting...';
                statusEl.innerHTML = '<span class="text-muted"><i class="bi bi-arrow-repeat spin"></i> Getting your location...</span>';
                
                try {
                    // Check if geolocation is available
                    if (!LocationService.isGeolocationAvailable()) {
                        throw new Error('Geolocation is not supported by your browser.');
                    }
                    
                    // Get current position (returns {latitude, longitude, accuracy} directly)
                    const position = await LocationService.getCurrentPosition();
                    const { latitude, longitude } = position;
                    
                    // Reverse geocode to get address
                    const geoResult = await LocationService.reverseGeocode(latitude, longitude);
                    const address = geoResult.success ? geoResult.address : `${latitude.toFixed(6)}, ${longitude.toFixed(6)}`;
                    
                    // Update form fields
                    updateLocationFields({
                        latitude: latitude,
                        longitude: longitude,
                        address: address,
                        locationUrl: LocationService.generateGoogleMapsUrl(latitude, longitude)
                    });
                    
                    // Update map
                    if (mapPicker && mapPicker.setLocation) {
                        mapPicker.setLocation(latitude, longitude);
                        // Force map refresh after location update
                        setTimeout(function() {
                            if (mapPicker && mapPicker.invalidateSize) {
                                mapPicker.invalidateSize();
                            }
                        }, 100);
                    }
                    
                    // Show success
                    statusEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Location detected: ' + address + '</span>';
                } catch (error) {
                    console.error('Error detecting location:', error);
                    statusEl.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle"></i> ' + error.message + '</span>';
                } finally {
                    // Re-enable button
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-geo-alt-fill me-1"></i>Detect My Location';
                }
            });
        });
        
        function updateLocationFields(data) {
            document.getElementById('latitudeInput').value = data.latitude;
            document.getElementById('longitudeInput').value = data.longitude;
            document.getElementById('locationUrlInput').value = data.locationUrl || '';
            
            // Update or create location input - check both 'Location' and 'Location' (case insensitive)
            let locationInput = document.getElementById('Location') || document.querySelector('input[name="Location"]');
            if (locationInput && data.address) {
                locationInput.value = data.address;
            }
            
            // Debug log
            console.log('Updating location fields:', data);
            
            // Show preview
            showLocationPreview(data.latitude, data.longitude, data.address);
        }
        
        function showLocationPreview(lat, lng, address) {
            const preview = document.getElementById('locationPreview');
            const coordsDisplay = document.getElementById('coordinatesDisplay');
            const mapLink = document.getElementById('viewOnMapLink');
            
            if (preview && coordsDisplay && mapLink) {
                coordsDisplay.textContent = address || (lat.toFixed(6) + ', ' + lng.toFixed(6));
                mapLink.href = `https://www.google.com/maps?q=${lat},${lng}`;
                preview.style.display = 'block';
            }
        }
    </script>
}
