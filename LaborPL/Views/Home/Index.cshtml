@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section id="hero" class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <div class="hero-content">
                    <div class="hero-badge animate-fade-in">
                        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>
                        <span>Quick & Reliable Service</span>
                    </div>
                    <h1 class="hero-title animate-slide-up">Find Local Labor, <span class="text-primary gradient-text">Get Things Done</span></h1>
                    <p class="hero-subtitle animate-slide-up delay-1">Connect with skilled workers for cleaning, moving, repairs, gardening, and more. Safe, secure, and simple.</p>
                    <div class="hero-buttons animate-slide-up delay-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Poster"))
                            {
                                <a asp-controller="Task" asp-action="Create" class="btn btn-primary btn-lg me-3 btn-pulse">
                                    <i class="bi bi-plus-circle me-2"></i>Post a Task
                                </a>
                            }
                            @if (User.IsInRole("Worker"))
                            {
                                <a asp-controller="Task" asp-action="Index" class="btn btn-outline-primary btn-lg btn-hover-slide">
                                    <i class="bi bi-search me-2"></i>Find Work
                                </a>
                            }
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-3 btn-pulse">
                                <i class="bi bi-person-plus me-2"></i>Get Started
                            </a>
                            <a asp-controller="Task" asp-action="Index" class="btn btn-outline-primary btn-lg btn-hover-slide">
                                <i class="bi bi-search me-2"></i>Browse Tasks
                            </a>
                        }
                    </div>
                    <div class="hero-stats mt-5 animate-fade-in delay-3">
                        <div class="row">
                            <div class="col-4">
                                <div class="stat-item bounce-on-hover">
                                    <div class="stat-icon bg-primary-light">
                                        <i class="bi bi-clipboard-check text-primary"></i>
                                    </div>
                                    <h3 class="stat-number counter" data-target="10000">10K+</h3>
                                    <p class="stat-label">Tasks Posted</p>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-item bounce-on-hover">
                                    <div class="stat-icon bg-success-light">
                                        <i class="bi bi-people-fill text-success"></i>
                                    </div>
                                    <h3 class="stat-number counter" data-target="5000">5K+</h3>
                                    <p class="stat-label">Verified Workers</p>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-item bounce-on-hover">
                                    <div class="stat-icon bg-warning-light">
                                        <i class="bi bi-heart-fill text-warning"></i>
                                    </div>
                                    <h3 class="stat-number counter" data-target="98">98%</h3>
                                    <p class="stat-label">Satisfaction</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image animate-float">
                    <div class="hero-illustration">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="floating-icons">
                        <div class="float-icon icon-1"><i class="bi bi-tools"></i></div>
                        <div class="float-icon icon-2"><i class="bi bi-house-door"></i></div>
                        <div class="float-icon icon-3"><i class="bi bi-star-fill"></i></div>
                        <div class="float-icon icon-4"><i class="bi bi-check-circle-fill"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-shape">
        <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="white"/>
        </svg>
    </div>
</section>

<!-- Categories Section -->
<section id="categories" class="categories-section py-5">
    <div class="container">
        <div class="section-header text-center mb-5 animate-fade-in">
            <div class="section-icon">
                <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
            </div>
            <h2 class="section-title">Popular Categories</h2>
            <p class="section-subtitle">Find workers for any task you need</p>
        </div>
        <div class="row g-4">
            <div class="col-6 col-md-4 col-lg-3 animate-fade-in-up">
                <a href="/Task?category=1" class="category-card">
                    <div class="category-icon bg-success-light">
                        <i class="bi bi-stars text-success"></i>
                    </div>
                    <h5 class="category-name">Cleaning</h5>
                    <p class="category-count">500+ tasks</p>
                    <div class="card-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 animate-fade-in-up delay-1">
                <a href="/Task?category=2" class="category-card">
                    <div class="category-icon bg-primary-light">
                        <i class="bi bi-truck text-primary"></i>
                    </div>
                    <h5 class="category-name">Moving</h5>
                    <p class="category-count">300+ tasks</p>
                    <div class="card-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 animate-fade-in-up delay-2">
                <a href="/Task?category=3" class="category-card">
                    <div class="category-icon bg-warning-light">
                        <i class="bi bi-tools text-warning"></i>
                    </div>
                    <h5 class="category-name">Repairs</h5>
                    <p class="category-count">400+ tasks</p>
                    <div class="card-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 animate-fade-in-up delay-3">
                <a href="/Task?category=4" class="category-card">
                    <div class="category-icon bg-info-light">
                        <i class="bi bi-tree text-info"></i>
                    </div>
                    <h5 class="category-name">Gardening</h5>
                    <p class="category-count">200+ tasks</p>
                    <div class="card-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 animate-fade-in-up">
                <a href="/Task?category=5" class="category-card">
                    <div class="category-icon bg-danger-light">
                        <i class="bi bi-palette text-danger"></i>
                    </div>
                    <h5 class="category-name">Painting</h5>
                    <p class="category-count">150+ tasks</p>
                    <div class="card-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 animate-fade-in-up delay-1">
                <a href="/Task?category=6" class="category-card">
                    <div class="category-icon bg-primary-light">
                        <i class="bi bi-droplet text-primary"></i>
                    </div>
                    <h5 class="category-name">Plumbing</h5>
                    <p class="category-count">250+ tasks</p>
                    <div class="card-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 animate-fade-in-up delay-2">
                <a href="/Task?category=7" class="category-card">
                    <div class="category-icon bg-warning-light">
                        <i class="bi bi-lightning text-warning"></i>
                    </div>
                    <h5 class="category-name">Electrical</h5>
                    <p class="category-count">180+ tasks</p>
                    <div class="card-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 animate-fade-in-up delay-3">
                <a href="/Task?category=16" class="category-card">
                    <div class="category-icon bg-success-light">
                        <i class="bi bi-calendar-event text-success"></i>
                    </div>
                    <h5 class="category-name">Event Help</h5>
                    <p class="category-count">120+ tasks</p>
                    <div class="card-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section id="how-it-works" class="how-it-works-section py-5 bg-light">
    <div class="container">
        <div class="section-header text-center mb-5 animate-fade-in">
            <div class="section-icon">
                <i class="bi bi-lightbulb-fill text-warning"></i>
            </div>
            <h2 class="section-title">How It Works</h2>
            <p class="section-subtitle">Get your tasks done in 4 simple steps</p>
        </div>
        <div class="row g-4">
            <div class="col-md-3 animate-fade-in-up">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <div class="step-icon animate-bounce-slow">
                        <i class="bi bi-clipboard-plus"></i>
                    </div>
                    <h4 class="step-title">Post a Task</h4>
                    <p class="step-description">Describe what you need, set your budget, and choose a category.</p>
                    <div class="step-connector"></div>
                </div>
            </div>
            <div class="col-md-3 animate-fade-in-up delay-1">
                <div class="step-card">
                    <div class="step-number">2</div>
                    <div class="step-icon animate-bounce-slow delay-1">
                        <i class="bi bi-people"></i>
                    </div>
                    <h4 class="step-title">Get Offers</h4>
                    <p class="step-description">Verified workers will apply with their proposals and rates.</p>
                    <div class="step-connector"></div>
                </div>
            </div>
            <div class="col-md-3 animate-fade-in-up delay-2">
                <div class="step-card">
                    <div class="step-number">3</div>
                    <div class="step-icon animate-bounce-slow delay-2">
                        <i class="bi bi-hand-thumbs-up"></i>
                    </div>
                    <h4 class="step-title">Choose Worker</h4>
                    <p class="step-description">Review profiles, ratings, and pick the best worker for your task.</p>
                    <div class="step-connector"></div>
                </div>
            </div>
            <div class="col-md-3 animate-fade-in-up delay-3">
                <div class="step-card">
                    <div class="step-number">4</div>
                    <div class="step-icon animate-bounce-slow delay-3">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <h4 class="step-title">Get It Done</h4>
                    <p class="step-description">Worker completes the task, you release payment when satisfied.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="features-section py-5">
    <div class="container">
        <div class="section-header text-center mb-5 animate-fade-in">
            <div class="section-icon">
                <i class="bi bi-gem text-danger"></i>
            </div>
            <h2 class="section-title">Why Choose Us</h2>
            <p class="section-subtitle">Safe, secure, and reliable labor marketplace</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4 animate-fade-in-up">
                <div class="feature-card hover-lift">
                    <div class="feature-icon animate-rotate-on-hover">
                        <i class="bi bi-shield-check text-primary"></i>
                    </div>
                    <h4 class="feature-title">Verified Workers</h4>
                    <p class="feature-description">All workers go through ID verification and background checks for your safety.</p>
                </div>
            </div>
            <div class="col-md-4 animate-fade-in-up delay-1">
                <div class="feature-card hover-lift">
                    <div class="feature-icon animate-rotate-on-hover">
                        <i class="bi bi-lock text-success"></i>
                    </div>
                    <h4 class="feature-title">Secure Payments</h4>
                    <p class="feature-description">Your payment is held in escrow until the job is completed to your satisfaction.</p>
                </div>
            </div>
            <div class="col-md-4 animate-fade-in-up delay-2">
                <div class="feature-card hover-lift">
                    <div class="feature-icon animate-rotate-on-hover">
                        <i class="bi bi-star-fill text-warning"></i>
                    </div>
                    <h4 class="feature-title">Rating System</h4>
                    <p class="feature-description">Transparent ratings and reviews help you choose the right worker every time.</p>
                </div>
            </div>
            <div class="col-md-4 animate-fade-in-up">
                <div class="feature-card hover-lift">
                    <div class="feature-icon animate-rotate-on-hover">
                        <i class="bi bi-chat-dots text-info"></i>
                    </div>
                    <h4 class="feature-title">In-App Messaging</h4>
                    <p class="feature-description">Communicate directly with workers through our secure messaging system.</p>
                </div>
            </div>
            <div class="col-md-4 animate-fade-in-up delay-1">
                <div class="feature-card hover-lift">
                    <div class="feature-icon animate-rotate-on-hover">
                        <i class="bi bi-geo-alt text-danger"></i>
                    </div>
                    <h4 class="feature-title">Location Based</h4>
                    <p class="feature-description">Find workers near you with our location-based search and map integration.</p>
                </div>
            </div>
            <div class="col-md-4 animate-fade-in-up delay-2">
                <div class="feature-card hover-lift">
                    <div class="feature-icon animate-rotate-on-hover">
                        <i class="bi bi-headset text-secondary"></i>
                    </div>
                    <h4 class="feature-title">24/7 Support</h4>
                    <p class="feature-description">Our support team is always here to help with any issues or disputes.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section id="get-started" class="cta-section py-5 bg-primary-gradient text-white">
    <div class="container text-center">
        <div class="cta-icon animate-pulse">
            <i class="bi bi-rocket-takeoff-fill"></i>
        </div>
        <h2 class="cta-title mb-3 animate-fade-in">Ready to Get Started?</h2>
        <p class="cta-subtitle mb-4 animate-fade-in delay-1">Join thousands of satisfied users on Labor Marketplace</p>
        <div class="cta-buttons animate-fade-in delay-2">
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg me-3 btn-hover-scale">
                    <i class="bi bi-person-plus me-2"></i>Create Free Account
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg btn-hover-scale">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </a>
            }
            else
            {
                @if (User.IsInRole("Poster"))
                {
                    <a asp-controller="Task" asp-action="Create" class="btn btn-light btn-lg me-3 btn-hover-scale">
                        <i class="bi bi-plus-circle me-2"></i>Post a Task
                    </a>
                }
                <a asp-controller="Task" asp-action="Index" class="btn btn-outline-light btn-lg btn-hover-scale">
                    <i class="bi bi-search me-2"></i>Browse Tasks
                </a>
            }
        </div>
    </div>
</section>

<!-- Add this to your site.css file -->
<style>
    /* Animations */
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }
    
    .animate-fade-in-up {
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
    }
    
    .animate-slide-up {
        opacity: 0;
        animation: slideUp 0.8s ease-out forwards;
    }
    
    .animate-float {
        animation: float 6s ease-in-out infinite;
    }
    
    .animate-bounce-slow {
        animation: bounceSlow 2s ease-in-out infinite;
    }
    
    .animate-pulse {
        animation: pulse 2s ease-in-out infinite;
    }
    
    .animate-rotate-on-hover:hover i {
        animation: rotate 0.6s ease-in-out;
    }
    
    /* Delay classes */
    .delay-1 { animation-delay: 0.2s; }
    .delay-2 { animation-delay: 0.4s; }
    .delay-3 { animation-delay: 0.6s; }
    
    /* Keyframes */
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-20px); }
    }
    
    @@keyframes bounceSlow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
    
    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }
    
    @@keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    
    /* Hero Section Enhancements */
    .hero-badge {
        display: inline-flex;
        align-items: center;
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3);
    }
    
    .gradient-text {
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 10px;
        transition: all 0.3s ease;
    }
    
    .bounce-on-hover:hover .stat-icon {
        animation: bounce 0.5s ease;
    }
    
    .bounce-on-hover:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
    }
    
    /* Floating Icons */
    .floating-icons {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        pointer-events: none;
    }
    
    .float-icon {
        position: absolute;
        width: 50px;
        height: 50px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        animation: floatIcon 4s ease-in-out infinite;
    }
    
    .float-icon.icon-1 {
        top: 10%;
        left: 10%;
        animation-delay: 0s;
        color: #28a745;
    }
    
    .float-icon.icon-2 {
        top: 20%;
        right: 15%;
        animation-delay: 1s;
        color: #007bff;
    }
    
    .float-icon.icon-3 {
        bottom: 30%;
        left: 5%;
        animation-delay: 2s;
        color: #ffc107;
    }
    
    .float-icon.icon-4 {
        bottom: 20%;
        right: 10%;
        animation-delay: 3s;
        color: #17a2b8;
    }
    
    @@keyframes floatIcon {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(5deg); }
    }
    
    /* Hero Shape */
    .hero-shape {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
    }
    
    .hero-section {
        position: relative;
        overflow: hidden;
    }
    
    /* Section Icons */
    .section-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        display: inline-block;
        animation: pulse 2s ease-in-out infinite;
    }
    
    /* Category Cards */
    .category-card {
        position: relative;
        overflow: hidden;
    }
    
    .category-card .card-arrow {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%) translateX(20px);
        opacity: 0;
        transition: all 0.3s ease;
        color: #007bff;
    }
    
    .category-card:hover .card-arrow {
        transform: translateY(-50%) translateX(0);
        opacity: 1;
    }
    
    .category-card:hover .category-icon {
        transform: scale(1.1) rotate(5deg);
    }
    
    .category-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        transition: all 0.3s ease;
    }
    
    .category-icon i {
        font-size: 2rem;
    }
    
    /* Feature Icons */
    .feature-icon {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    
    .feature-icon i {
        font-size: 2.5rem;
    }
    
    /* Step Icons */
    .step-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
        color: white;
        box-shadow: 0 10px 30px rgba(0,123,255,0.3);
    }
    
    .step-icon i {
        font-size: 2.5rem;
    }
    
    /* Step Cards */
    .step-card {
        position: relative;
    }
    
    .step-connector {
        position: absolute;
        top: 50px;
        right: -30px;
        width: 60px;
        height: 2px;
        background: linear-gradient(90deg, #007bff, transparent);
        display: none;
    }
    
    @@media (min-width: 768px) {
        .step-connector {
            display: block;
        }
        .col-md-3:last-child .step-connector {
            display: none;
        }
    }
    
    /* Feature Cards */
    .feature-card {
        transition: all 0.3s ease;
    }
    
    .hover-lift:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    
    /* Buttons */
    .btn-pulse {
        animation: pulse 2s ease-in-out infinite;
    }
    
    .btn-pulse:hover {
        animation: none;
    }
    
    .btn-hover-slide {
        position: relative;
        overflow: hidden;
    }
    
    .btn-hover-slide::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
        transition: left 0.5s ease;
    }
    
    .btn-hover-slide:hover::before {
        left: 100%;
    }
    
    .btn-hover-scale {
        transition: transform 0.3s ease;
    }
    
    .btn-hover-scale:hover {
        transform: scale(1.05);
    }
    
    /* CTA Icon */
    .cta-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        display: inline-block;
    }
    
