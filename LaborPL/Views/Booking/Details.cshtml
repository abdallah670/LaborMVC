@model BookingDetailViewModel
@using LaborDAL.Enums
@using System.Security.Claims

@{
    Layout = "_Layout";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewData["Title"] = "Booking Details";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (Model == null)
    {
        <div class="alert alert-danger m-5 text-center p-5">
            <i class="bi bi-exclamation-triangle-fill display-1 text-danger"></i>
            <h2 class="mt-4">Booking Not Found</h2>
            <p class="lead">The booking details you're looking for don't exist or you don't have permission to view them.</p>
            <a asp-action="Dashboard" class="btn btn-primary btn-lg mt-3">
                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
        return;
    }

    bool isPoster = currentUserId == Model.PosterId;
    bool isWorker = currentUserId == Model.WorkerId;
}

<!-- Container متجاوب مثل الصورة الأصلية -->
<div class="container-fluid px-3 px-lg-4 py-4" style="background-color: #f8f9fa; min-height: 100vh;">
    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 fw-bold">
            <i class="bi bi-calendar-check me-2 text-primary"></i>
            Booking Details
        </h4>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <!-- Grid System متجاوب 3 أعمدة -->
    <div class="row g-4">
        <!-- العمود الأيسر: Booking Information (مثل الصورة) -->
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2 text-primary"></i>
                        Booking Information
                    </h6>
                </div>
                <div class="card-body">
                    <!-- Poster/Worker Info -->
                    @if (!isPoster)
                    {
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="text-muted d-block mb-1">Poster Name</small>
                            <strong>
                                <a href="@Url.Action("ProfilePoster", "Booking", new { id = Model.PosterId })"
                                   class="text-decoration-none text-dark">
                                    <i class="bi bi-person-circle me-1"></i>@Model.PosterName
                                </a>
                            </strong>
                        </div>
                    }

                    @if (isPoster)
                    {
                        <div class="mb-3 pb-2 border-bottom">
                            <small class="text-muted d-block mb-1">Worker Name</small>
                            <strong>
                                <a href="@Url.Action("ProfilePoster", "Booking", new { id = Model.WorkerId })"
                                   class="text-decoration-none text-dark">
                                    <i class="bi bi-person-badge me-1"></i>@Model.WorkerName
                                </a>
                            </strong>
                        </div>
                    }

                    <!-- Time Info -->
                    <div class="mb-3 pb-2 border-bottom">
                        <small class="text-muted d-block mb-1">Start Time</small>
                        <strong class="d-flex align-items-center">
                            <i class="bi bi-clock me-2 text-warning"></i>
                            @(Model.StartTime?.ToString("MMM dd, yyyy HH:mm") ?? "Not Scheduled Yet")
                        </strong>
                    </div>

                    <div class="mb-3 pb-2 border-bottom">
                        <small class="text-muted d-block mb-1">End Time</small>
                        <strong class="d-flex align-items-center">
                            <i class="bi bi-clock-fill me-2 text-warning"></i>
                            @(Model.EndTime?.ToString("MMM dd, yyyy HH:mm") ?? "Not Scheduled Yet")
                        </strong>
                    </div>

                    <!-- Rate & Status -->
                    <div class="mb-3 pb-2 border-bottom">
                        <small class="text-muted d-block mb-1">Agreed Rate</small>
                        <strong class="text-primary fs-5">
                            <i class="bi bi-currency-dollar me-1"></i>
                            $@Model.AgreedRate.ToString("N2")
                        </strong>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Status</small>
                        <span class="badge @GetStatusBadgeClass(Model.Status) px-3 py-2">
                            @Model.Status
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- العمود الأوسط: Quick Actions (Tasks & Bookings زي الصورة) -->
        <div class="col-lg-4">
            <!-- Tasks Section -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-list-task me-2 text-primary"></i>
                        Tasks
                    </h6>
                </div>
                <div class="card-body">
                    <!-- Action Buttons حسب حالة الحجز -->
                    @if (Model.Status == BookingStatus.Scheduled && (isWorker || isPoster))
                    {
                        <div class="d-grid gap-2">
                            <button type="button" data-bs-toggle="modal" data-bs-target="#cancelModal"
                                    class="btn btn-outline-danger">
                                <i class="bi bi-x-circle me-2"></i>Cancel Booking
                            </button>
                        </div>
                    }

                    @if (Model.Status == BookingStatus.Scheduled && isWorker && !isPoster)
                    {
                        <form asp-controller="Booking" asp-action="Start" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-play-circle me-2"></i>Start Work
                                </button>
                            </div>
                        </form>
                    }

                    @if (Model.Status == BookingStatus.InProgress && isWorker && !isPoster)
                    {
                        <form asp-controller="Booking" asp-action="Complete" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="d-grid">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check-circle me-2"></i>Mark as Completed
                                </button>
                            </div>
                        </form>
                    }

                    @if (Model.Status == BookingStatus.CompletedfromWorker && isPoster)
                    {
                        <form asp-controller="Booking" asp-action="ConfirmCompletion" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check2-all me-2"></i>Confirm Completion
                                </button>
                            </div>
                        </form>
                    }

                    @if (Model.Status == BookingStatus.Disputed)
                    {
                        <div class="alert alert-warning d-flex align-items-center mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
                            <div>This booking is under dispute review.</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Rating Section -->
            @if (Model.Status == BookingStatus.Completed || Model.Status == BookingStatus.Cancelled)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-transparent border-bottom py-3">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-star me-2 text-primary"></i>
                            Rate the @(isPoster ? "Worker" : "Poster")
                        </h6>
                    </div>
                    <div class="card-body">
                        <form asp-action="Rate" asp-controller="Booking" method="post">
                            <input type="hidden" name="bookingId" value="@Model.Id" />
                            <input type="hidden" name="RatedId" value="@ViewBag.RatedId" />

                            <!-- Star Rating -->
                            <div class="star-rating mb-3">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" name="Score" value="@i" id="star_@i"
                                           @(ViewBag.ExistingScore == i ? "checked" : "") />
                                    <label for="star_@i" title="@i stars">&#9733;</label>
                                }
                            </div>

                            <!-- Comment -->
                            <div class="mb-3">
                                <textarea name="Comment" class="form-control" rows="2"
                                      placeholder="Write your comment here...">@ViewBag.ExistingComment</textarea>
                                <small class="text-muted">Optional: Share your experience</small>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-warning w-100">
                                <i class="bi bi-send me-2"></i>
                                @(ViewBag.ExistingScore > 0 ? "Update Rating" : "Submit Rating")
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <!-- العمود الأيمن: Privacy & Chat (زي الصورة) -->
        <div class="col-lg-5">
            <!-- Privacy Section -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-shield-lock me-2 text-primary"></i>
                        Privacy
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <i class="bi bi-shield-check text-success me-2"></i>
                            <span>Your data is secure</span>
                        </div>
                        @if (Model.Status == BookingStatus.Completed && (isWorker || isPoster))
                        {
                            <a asp-action="RaiseDispute" asp-route-bookingId="@Model.Id"
                               class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-exclamation-triangle me-1"></i>Raise Dispute
                            </a>
                        }
                    </div>
                    @if (Model.Status == BookingStatus.Completed)
                    {
                        <small class="text-muted d-block mt-2">
                            <i class="bi bi-info-circle me-1"></i>
                            Disputes must be raised within 48 hours of completion
                        </small>
                    }
                </div>
            </div>

            <!-- Chat Section -->
            <!-- Chat Section - نسخة محسنة -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-chat-dots fs-5 text-primary"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Messages</h6>
                                <small class="text-muted">
                                    Chatting with
                                    <span class="fw-semibold text-dark">
                                        @if (!isPoster)
                                        {
                                            @Model.PosterName
                                        }
                                        else
                                        {
                                            @Model.WorkerName
                                        }
                                    </span>
                                </small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success" id="onlineStatus">Online</span>
                            @if (!isPoster)
                            {
                                <a href="@Url.Action("ProfilePoster", "Booking", new { id = Model.PosterId })"
                                   class="btn btn-sm btn-outline-primary rounded-circle p-1"
                                   style="width: 32px; height: 32px;"
                                   title="View Profile">
                                    <i class="bi bi-person"></i>
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("ProfilePoster", "Booking", new { id = Model.WorkerId })"
                                   class="btn btn-sm btn-outline-primary rounded-circle p-1"
                                   style="width: 32px; height: 32px;"
                                   title="View Profile">
                                    <i class="bi bi-person"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body p-0" style="height: 350px; overflow-y: auto; background-color: #f8fafc;" id="messagesList">
                    <!-- Messages will appear here -->
                    <div class="no-messages text-center py-5">
                        <div class="mb-3">
                            <i class="bi bi-chat-dots fs-1 text-muted"></i>
                        </div>
                        <p class="fw-semibold mb-1">No messages yet</p>
                        <small class="text-muted">
                            Start the conversation with
                            <span class="fw-semibold">
                                @if (!isPoster)
                                {
                                    @Model.PosterName
                                }
                                else
                                {
                                    @Model.WorkerName
                                }
                            </span>
                        </small>
                    </div>
                </div>

                <div class="card-footer bg-white border-top p-3">
                    <div class="input-group">
                        <input type="text" id="messageInput" class="form-control"
                               placeholder="Type your message..."
                               autocomplete="off"
                               aria-label="Message input">
                        <button id="sendButton" class="btn btn-primary" type="button">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                    <small class="text-muted d-block mt-2 text-end">
                        <i class="bi bi-info-circle me-1"></i>
                        Press Enter to send
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancel Booking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to cancel this booking?</p>
                <small class="text-muted">This action cannot be undone.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* تنسيق النجوم */
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 0.5rem;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            font-size: 2rem;
            color: #ddd;
            cursor: pointer;
            transition: color 0.2s;
        }

            .star-rating label:hover,
            .star-rating label:hover ~ label,
            .star-rating input:checked ~ label {
                color: #ffc107;
            }

    /* تنسيق الشات */
    .message-container {
        margin-bottom: 1rem;
        display: flex;
        flex-direction: column;
        padding: 0 1rem;
    }

        .message-container.outgoing {
            align-items: flex-end;
        }

        .message-container.incoming {
            align-items: flex-start;
        }

    .message-sender {
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
        color: #6c757d;
    }

    .message-bubble {
        max-width: 80%;
        padding: 0.5rem 1rem;
        border-radius: 1rem;
        position: relative;
        word-wrap: break-word;
    }

        .message-bubble.outgoing {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-bottom-right-radius: 0.25rem;
        }

        .message-bubble.incoming {
            background-color: white;
            border: 1px solid #dee2e6;
            border-bottom-left-radius: 0.25rem;
        }

    .message-time {
        font-size: 0.7rem;
        color: #adb5bd;
        margin-top: 0.2rem;
    }

    /* Scrollbar */
    #messagesList::-webkit-scrollbar {
        width: 6px;
    }

    #messagesList::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    #messagesList::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

        #messagesList::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .star-rating label {
            font-size: 1.8rem;
        }

        .message-bubble {
            max-width: 90%;
        }
    }
</style>

@functions {
    string GetStatusBadgeClass(BookingStatus status) => status switch
    {
        BookingStatus.Scheduled => "bg-warning text-dark",
        BookingStatus.InProgress => "bg-info text-dark",
        BookingStatus.CompletedfromWorker => "bg-info text-dark",
        BookingStatus.Completed => "bg-success",
        BookingStatus.Cancelled => "bg-danger",
        BookingStatus.Disputed => "bg-dark",
        _ => "bg-secondary"
    };
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var bookingId = @Model.Id;
            var currentUserId = "@userId";
            var otherUserId = "@(isPoster? Model.WorkerId: Model.PosterId)";

            var messagesList = document.getElementById('messagesList');
            var messageInput = document.getElementById('messageInput');
            var sendButton = document.getElementById('sendButton');

            function displayMessage(message) {
                var noMessages = messagesList.querySelector('.no-messages');
                if (noMessages) noMessages.remove();

                var isOutgoing = message.senderId === currentUserId;
                var timeString = new Date(message.sentAt).toLocaleTimeString('ar-EG', {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false,
                    timeZone: 'Africa/Cairo'
                });
                var senderName = isOutgoing ? 'You' : (message.senderName || 'User');

                var wrapper = document.createElement('div');
                wrapper.className = `message-container ${isOutgoing ? 'outgoing' : 'incoming'}`;
                wrapper.innerHTML = `
                    <div class="message-sender">${senderName}</div>
                    <div class="message-bubble ${isOutgoing ? 'outgoing' : 'incoming'}">${escapeHtml(message.content)}</div>
                    <div class="message-time">${timeString}</div>
                `;
                messagesList.appendChild(wrapper);
                messagesList.scrollTop = messagesList.scrollHeight;
            }

            function escapeHtml(str) {
                return str.replace(/&/g,"&amp;")
                         .replace(/</g,"&lt;")
                         .replace(/>/g,"&gt;")
                         .replace(/"/g,"&quot;")
                         .replace(/'/g,"&#039;");
            }

            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMessage", function(message) {
                // تجاهل لو الرسالة أنا بعتها (بتتعرض محلياً)
                if (message.senderId === currentUserId) return;
                displayMessage(message);
            });

            connection.start()
                .then(() => connection.invoke("JoinBookingGroup", bookingId))
                .then(loadMessages);

            function loadMessages() {
                fetch(`/Message/GetMessages?bookingId=${bookingId}`)
                    .then(r => r.json())
                    .then(data => {
                        if (data.success && data.messages && data.messages.length > 0) {
                            messagesList.innerHTML = '';
                            data.messages.forEach(displayMessage);
                        }
                    });
            }

            function sendMessage() {
                var content = messageInput.value.trim();
                if (!content) return;

                // عرض الرسالة محلياً فوراً
                displayMessage({
                    senderId: currentUserId,
                    content: content,
                    sentAt: new Date().toISOString(),
                    senderName: 'You'
                });

                messageInput.value = '';
                messageInput.focus();

                fetch('/Message/SendMessage', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({bookingId: bookingId, content: content})
                })
                .then(r => r.json())
                .then(data => {
                    if (!data.success) {
                        console.error('❌ Failed to send message');
                    }
                });
            }

            sendButton.addEventListener('click', sendMessage);
            messageInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    sendMessage();
                }
            });

            // ===== الأونلاين =====
            async function checkUserStatus() {
                try {
                    const response = await fetch(`/Chat/GetUserStatus?userId=${otherUserId}`);
                    const data = await response.json();
                    const badge = document.getElementById('onlineStatus');

                    if (data.isOnline) {
                        badge.textContent = 'Online';
                        badge.className = 'badge bg-success';
                    } else {
                        badge.textContent = 'Offline';
                        badge.className = 'badge bg-secondary';
                    }
                } catch (e) {
                    console.error('❌ Status error:', e);
                }
            }

            checkUserStatus();
        setInterval(checkUserStatus, 5000);        });
    </script>
}