@model BookingDetailViewModel
@using LaborDAL.Enums
@using System.Security.Claims

@{
    Layout = "_Layout";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewData["Title"] = "Booking Details";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (Model == null)
    {
        <div class="alert alert-danger m-5 text-center p-5">
            <i class="bi bi-exclamation-triangle-fill display-1 text-danger"></i>
            <h2 class="mt-4">Booking Not Found</h2>
            <p class="lead">The booking details you're looking for don't exist or you don't have permission to view them.</p>
            <a asp-action="Dashboard" class="btn btn-primary btn-lg mt-3">
                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
        return;
    }

    bool isPoster = currentUserId == Model.PosterId;
    bool isWorker = currentUserId == Model.WorkerId;
}

<div class="booking-dashboard-container d-flex gap-4">
    <!-- Left Column: Booking Info (ثابتة) -->
    <div class="left-column flex-shrink-0" style="width:600px; height:400px">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-transparent">
                <h5 class="mb-0">Booking Information</h5>
            </div>
            <div class="card-body">
                @if (!isPoster)
                {
                    <div class="mb-3">
                        <strong>Poster Name</strong>
                        <p class="text-muted mb-0">
                            <a href="@Url.Action("ProfilePoster", "Booking", new { id = Model.PosterId })">@Model.PosterName</a>
                        </p>
                    </div>
                }
                @if (isPoster)
                {
                    <div class="mb-3">
                        <strong>Worker Name</strong>
                        <p class="text-muted mb-0">
                            <a href="@Url.Action("ProfilePoster", "Booking", new { id = Model.WorkerId })">@Model.WorkerName</a>
                        </p>
                    </div>
                }
                <div class="mb-3">
                    <strong>Start Time</strong>
                    <p class="text-muted mb-0">@(Model.StartTime?.ToString("MMM dd, yyyy HH:mm") ?? "Not Scheduled Yet")</p>
                </div>
                <div class="mb-3">
                    <strong>End Time</strong>
                    <p class="text-muted mb-0">@(Model.EndTime?.ToString("MMM dd, yyyy HH:mm") ?? "Not Scheduled Yet")</p>
                </div>
                <div class="mb-3">
                    <strong>Agreed Rate</strong>
                    <p class="text-primary fs-5 mb-0">$@Model.AgreedRate.ToString("N2")</p>
                </div>
                <div class="mb-3">
                    <strong>Status</strong>
                    <p class="mb-0">@Model.Status</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Quick Actions + Chat (معاً) -->
    <div class="right-column flex-shrink-0 d-flex flex-column" style="width: 520px; height: 100%;">
        <!-- Quick Actions Card -->
        <div class="card shadow-sm border-0 rounded-3 mb-3" style="height: 450px;">
            <div class="card-header bg-transparent">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                @* Rating Section *@
                @if (Model.Status == BookingStatus.Completed || Model.Status == BookingStatus.Cancelled)
                {
                        <div class="mb-4">
                            <h6>Rate the @(isPoster ? "Worker" : "Poster")</h6>
                        <form asp-action="Rate" asp-controller="Booking" method="post">
                            <input type="hidden" name="bookingId" value="@Model.Id" />
                            <input type="hidden" name="RatedId" value="@ViewBag.RatedId" />

                            <!-- حقل التقييم بالنجوم -->
                            <div class="star-rating mb-3">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" name="Score" value="@i" id="star_@i"
                                           @(ViewBag.ExistingScore == i ? "checked" : "") />
                                    <label for="star_@i" title="@i stars">&#9733;</label>
                                }
                            </div>

                            <!-- رسالة خطأ للتقييم -->
                            <span class="text-danger" id="scoreError"></span>

                            <!-- حقل التعليق -->
                            <div class="mb-3">
                                <label  class="form-label">Comment</label>
                                <textarea name="Comment" class="form-control" rows="3"
                                      placeholder="Write your comment here...">@ViewBag.ExistingComment</textarea>
                                <span class="text-danger" id="commentError"></span>
                                <small class="text-muted">Optional: You can leave a comment about your experience</small>
                            </div>

                            <!-- زر الإرسال -->
                            <button type="submit" class="btn btn-warning w-100" id="submitBtn">
                                @(ViewBag.ExistingScore > 0 ? "Update Rating" : "Submit Rating")
                            </button>
                        </form>
                    </div>
                }

                @* Action Buttons *@
                @if (Model.Status == BookingStatus.Scheduled && (isWorker || isPoster))
                {
                    <button type="button" data-bs-toggle="modal" data-bs-target="#cancelModal" class="btn btn-danger w-100 mb-2">Cancel Booking</button>
                }
                @if (Model.Status == BookingStatus.Scheduled && isWorker && !isPoster)
                {
                    <form asp-controller="Booking" asp-action="Start" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100 mb-2">Start Work</button>
                    </form>
                }
                @if (Model.Status == BookingStatus.InProgress && isWorker && !isPoster)
                {
                    <form asp-controller="Booking" asp-action="Complete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100 mb-2">Mark as Completed</button>
                    </form>
                }
                @if (Model.Status == BookingStatus.CompletedfromWorker && isPoster)
                {
                    <form asp-controller="Booking" asp-action="ConfirmCompletion" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100 mb-2">Confirm Completion</button>
                    </form>
                }
                @if (Model.Status == BookingStatus.Completed && (isWorker || isPoster))
                {
                    <div class="mt-3">
                        <a asp-action="RaiseDispute" asp-route-bookingId="@Model.Id" class="btn btn-outline-danger w-100 mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>Raise Dispute
                        </a>
                        <small class="text-muted d-block text-center">Disputes must be raised within 48 hours of completion</small>
                    </div>
                }
                @if (Model.Status == BookingStatus.Disputed)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        This booking is under dispute review.
                    </div>
                }
            </div>
        </div>

        <!-- Chat Box - تحت Quick Actions مباشرة -->
        <div class="card shadow-sm border-0 rounded-3 flex-grow-1 d-flex flex-column" style="height: calc(100% - 250px);">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 d-flex align-items-center">
                    <i class="bi bi-chat-dots text-primary me-2 fs-4"></i>
                    <span>Messages</span>
                    <span class="badge bg-success ms-3" id="onlineStatus">● Online</span>
                </h5>
            </div>

            <div class="card-body p-0 flex-grow-1 overflow-auto" style="background-color: #f8fafc;">
                <div id="messagesList" class="chat-messages p-3">
                    <div class="no-messages text-center py-5">
                        <i class="bi bi-chat fs-1 text-muted"></i>
                        <p class="mt-2 mb-1 fw-semibold">No messages yet</p>
                        <small class="text-muted">Start the conversation</small>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white border-top p-3">
                <div class="d-flex gap-2">
                    <input type="text" id="messageInput" class="form-control form-control-lg"
                           placeholder="Type a message..." autocomplete="off">
                    <button id="sendButton" class="btn btn-primary rounded-circle p-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-send"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>

    .card-body {
        overflow: auto;
    }

    .booking-dashboard-container {
        height: calc(100vh - 60px);
        overflow: hidden;
        padding: 20px;
    }

    .left-column {
        flex-shrink: 0;
    }

    .right-column {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        width: 320px;
    }

        .right-column .card:last-child {
            min-height: 0; /* مهم جداً للـ flexbox */
            height: 100%;
        }

    .chat-messages {
        height: 100%;
        overflow-y: auto;
        background-color: #f8fafc;
    }

    /* تنسيق فقاعات الشات */
    .message-container {
        margin-bottom: 1rem;
        display: flex;
        flex-direction: column;
    }

        .message-container.outgoing {
            align-items: flex-end;
        }

        .message-container.incoming {
            align-items: flex-start;
        }

    .message-sender {
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
        color: #6c757d;
    }

    .message-bubble {
        max-width: 70%;
        padding: 0.75rem 1rem;
        border-radius: 1rem;
        position: relative;
        word-wrap: break-word;
    }

        .message-bubble.outgoing {
            background-color: #0d6efd;
            color: white;
            border-bottom-right-radius: 0.25rem;
        }

        .message-bubble.incoming {
            background-color: white;
            border: 1px solid #dee2e6;
            border-bottom-left-radius: 0.25rem;
        }

    .message-time {
        font-size: 0.75rem;
        color: #adb5bd;
        margin-top: 0.25rem;
    }

    /* تنسيق النجوم */
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 0.5rem;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            font-size: 1.8rem;
            color: #ddd;
            cursor: pointer;
            transition: color 0.2s;
        }

            .star-rating label:hover,
            .star-rating label:hover ~ label,
            .star-rating input:checked ~ label {
                color: #ffc107;
            }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .booking-dashboard-container {
            flex-direction: column;
            height: auto;
            overflow: auto;
        }

        .left-column {
            width: 100% !important;
        }

        .right-column {
            height: 600px;
        }
    }
</style>

@functions {
    string GetStatusBadgeClass(BookingStatus status) => status switch
    {
        BookingStatus.Scheduled => "bg-warning",
        BookingStatus.InProgress => "bg-info",
        BookingStatus.CompletedfromWorker => "bg-info",
        BookingStatus.Completed => "bg-success",
        BookingStatus.Cancelled => "bg-danger",
        BookingStatus.Disputed => "bg-dark",
        _ => "bg-secondary"
    };
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var bookingId = @Model.Id;
            var currentUserId = "@userId";

            var messagesList = document.getElementById('messagesList');
            var messageInput = document.getElementById('messageInput');
            var sendButton = document.getElementById('sendButton');

            function displayMessage(message) {
                var noMessages = messagesList.querySelector('.no-messages');
                if(noMessages) noMessages.remove();

                var isOutgoing = message.senderId === currentUserId;
                var messageTime = message.sentAt ? new Date(message.sentAt).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) : '';
                var senderName = isOutgoing ? 'You' : (message.senderName || 'User');

                var wrapper = document.createElement('div');
                wrapper.className = `message-container ${isOutgoing ? 'outgoing' : 'incoming'}`;
                wrapper.innerHTML = `
                    <div class="message-sender">${senderName}</div>
                    <div class="message-bubble ${isOutgoing ? 'outgoing' : 'incoming'}">${escapeHtml(message.content)}</div>
                    <div class="message-time">${messageTime}</div>
                `;
                messagesList.appendChild(wrapper);
                messagesList.scrollTop = messagesList.scrollHeight;
            }

            function escapeHtml(str) {
                return str.replace(/&/g,"&amp;")
                         .replace(/</g,"&lt;")
                         .replace(/>/g,"&gt;")
                         .replace(/"/g,"&quot;")
                         .replace(/'/g,"&#039;");
            }

            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMessage", displayMessage);

            connection.start()
                .then(() => connection.invoke("JoinBookingGroup", bookingId))
                .then(loadMessages);

            function loadMessages() {
                fetch(`/Message/GetMessages?bookingId=${bookingId}`)
                    .then(r => r.json())
                    .then(data => {
                        if(data.success && data.messages && data.messages.length > 0) {
                            messagesList.innerHTML = '';
                            data.messages.forEach(displayMessage);
                        }
                    });
            }

            function sendMessage() {
                var content = messageInput.value.trim();
                if(!content) return;

                fetch('/Message/SendMessage', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({bookingId: bookingId, content: content})
                })
                .then(r => r.json())
                .then(data => {
                    if(data.success) {
                        messageInput.value = '';
                    }
                });
            }

            sendButton.addEventListener('click', sendMessage);
            messageInput.addEventListener('keypress', function(e) {
                if(e.key === 'Enter') {
                    e.preventDefault();
                    sendMessage();
                }
            });
        });
    </script>
}
