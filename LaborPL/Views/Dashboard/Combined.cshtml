@model dynamic
@{
    ViewData["Title"] = "Universal Dashboard";
    var workerBookings = ViewBag.WorkerBookings as List<LaborBLL.ModelVM.BookingDashboardViewModel> ?? new List<LaborBLL.ModelVM.BookingDashboardViewModel>();
    var workerApplications = ViewBag.WorkerApplications as List<LaborBLL.ModelVM.TaskApplicationViewModel> ?? new List<LaborBLL.ModelVM.TaskApplicationViewModel>();
    var posterTasks = ViewBag.PosterTasks as List<LaborBLL.ModelVM.TaskListViewModel> ?? new List<LaborBLL.ModelVM.TaskListViewModel>();
    var posterApplications = ViewBag.PosterApplications as List<LaborBLL.ModelVM.TaskApplicationViewModel> ?? new List<LaborBLL.ModelVM.TaskApplicationViewModel>();
    var posterBookings = ViewBag.PosterBookings as List<LaborBLL.ModelVM.BookingDashboardViewModel> ?? new List<LaborBLL.ModelVM.BookingDashboardViewModel>();
}

<div class="dashboard-container fade-in py-4">
    <!-- Premium Dashboard Header -->
    <div class="lm-dashboard-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary text-white text-uppercase fs-xs fw-bold px-2 py-1">Dual Mode</span>
                <span class="badge bg-light-soft text-muted text-uppercase fs-xs fw-bold px-2 py-1">Universal Control</span>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Admin" class="badge bg-danger-soft text-danger text-uppercase fs-xs fw-bold px-2 py-1 text-decoration-none hover-danger">Switch to Admin</a>
                }
            </div>
            <h1 class="lm-dashboard-title">Unified Dashboard</h1>
            <p class="text-muted mb-0">Seamlessly manage your activity as both a service provider and a client.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Task" asp-action="Create" class="btn btn-outline-success border shadow-sm smaller fw-bold px-3">
                <i class="bi bi-plus-circle me-2"></i>Post Task
            </a>
            <a asp-controller="Task" asp-action="Index" class="btn btn-primary lg shadow-sm px-4">
                <i class="bi bi-search me-2"></i>Find Work
            </a>
        </div>
    </div>

    <!-- Tabbed Navigation -->
    <ul class="nav nav-pills lm-nav-pills mb-4" id="combinedDashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold px-4 py-2" id="worker-tab" data-bs-toggle="pill" data-bs-target="#worker-view" type="button" role="tab">
                <i class="bi bi-person-workspace me-2"></i>Worker Profile
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4 py-2" id="poster-tab" data-bs-toggle="pill" data-bs-target="#poster-view" type="button" role="tab">
                <i class="bi bi-clipboard-data me-2"></i>Poster Profile
            </button>
        </li>
    </ul>

    <div class="tab-content" id="combinedDashboardTabsContent">
        <!-- Worker View Tab -->
        <div class="tab-pane fade show active" id="worker-view" role="tabpanel">
            <div class="lm-stat-grid mb-4">
                @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("My Bookings", ViewBag.WorkerTotalBookings?.ToString() ?? "0", "bi-calendar3", "primary"))
                @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Applications", ViewBag.WorkerPendingApplications?.ToString() ?? "0", "bi-file-earmark-text", "warning"))
                @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Active Roles", "Worker", "bi-person-badge", "info"))
                @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Completed", ViewBag.TotalCompleted?.ToString() ?? "0", "bi-check-circle", "success"))
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="lm-card lm-chart-card">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold mb-0">Work Earnings Trend</h5>
                            <span class="badge bg-primary-soft text-primary fs-xxs fw-bold">7 DAYS</span>
                        </div>
                        <div class="lm-chart-container">
                            <canvas id="workerEarningsChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="lm-card h-100 p-0 overflow-hidden">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light-soft">
                            <h5 class="fw-bold mb-0">Upcoming Bookings</h5>
                            <a asp-controller="Booking" asp-action="Dashboard" class="text-primary smaller fw-bold text-decoration-none">View All</a>
                        </div>
                        <div class="list-group list-group-flush">
                            @if (workerBookings.Any())
                            {
                                @foreach (var booking in workerBookings.Take(4))
                                {
                                    <div class="list-group-item bg-transparent px-3 py-3 border-0 border-bottom-dashed hover-light transition">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-0 fw-bold fs-sm">#@booking.Id</h6>
                                                <p class="text-muted fs-xxs mb-0">@(booking.StartTime?.ToString("MMM dd, HH:mm") ?? "Pending Schedule")</p>
                                            </div>
                                            <span class="badge bg-@(GetBookingStatusColor(booking.Status))-soft text-@(GetBookingStatusColor(booking.Status)) fs-xxs">@booking.Status</span>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-calendar-x fs-2 text-muted opacity-25"></i>
                                    <p class="text-muted smaller mt-2">No upcoming bookings.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="lm-card p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Recent Applications</h5>
                    <a asp-controller="Application" asp-action="ByWorker" class="text-primary smaller fw-bold text-decoration-none">Monitor Progress</a>
                </div>
                @if (workerApplications.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light-soft">
                                <tr>
                                    <th class="ps-3 border-0 smaller fw-bold text-muted">TASK</th>
                                    <th class="border-0 smaller fw-bold text-muted">BID</th>
                                    <th class="border-0 smaller fw-bold text-muted">STATUS</th>
                                    <th class="text-end pe-3 border-0 smaller fw-bold text-muted">DATE</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in workerApplications.Take(5))
                                {
                                    <tr class="transition">
                                        <td class="ps-3 py-3 border-0">
                                            <div class="fw-bold fs-sm text-dark line-clamp-1" style="max-width: 250px;">@app.TaskTitle</div>
                                        </td>
                                        <td class="py-3 border-0">
                                            <span class="fw-bold text-primary fs-sm">@app.ProposedBudget.ToString("C0")</span>
                                        </td>
                                        <td class="py-3 border-0">
                                            <span class="badge bg-@(GetApplicationStatusColor(app.Status))-soft text-@(GetApplicationStatusColor(app.Status)) fs-xxs">@app.Status</span>
                                        </td>
                                        <td class="text-end pe-3 py-3 border-0 text-muted fs-xxs">@app.CreatedAt.ToString("MMM dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted smaller">You haven't applied to any tasks yet.</div>
                }
            </div>
        </div>

        <!-- Poster View Tab -->
        <div class="tab-pane fade" id="poster-view" role="tabpanel">
            <div class="lm-stat-grid mb-4">
                @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Posted Tasks", ViewBag.PosterTotalTasks.ToString(), "bi-clipboard-check", "primary"))
                @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Active Bookings", ViewBag.TotalActiveBookings.ToString(), "bi-calendar-check", "success"))
                @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Received Apps", ViewBag.PosterPendingApplications.ToString(), "bi-person-plus", "info"))
                @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Total Spend", posterBookings.Sum(b => b.AgreedRate).ToString("C0"), "bi-wallet2", "danger"))
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="lm-card lm-chart-card">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold mb-0">Poster Engagement</h5>
                            <span class="badge bg-success-soft text-success fs-xxs fw-bold">ACTIVE TASKS</span>
                        </div>
                        <div class="lm-chart-container">
                            <canvas id="posterEngagementChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="lm-card h-100 p-0 overflow-hidden">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light-soft">
                            <h5 class="fw-bold mb-0">Pending Hire Reviews</h5>
                            <span class="badge bg-info-soft text-info rounded-pill fs-xxs">@posterApplications.Count</span>
                        </div>
                        <div class="list-group list-group-flush">
                            @if (posterApplications.Any())
                            {
                                @foreach (var app in posterApplications.Take(4))
                                {
                                    <div class="list-group-item bg-transparent px-3 py-3 border-0 border-bottom-dashed hover-light transition">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-info-soft text-info rounded-circle d-flex align-items-center justify-content-center fw-bold fs-xs" style="width: 32px; height: 32px;">
                                                @app.WorkerName[0]
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0 fw-bold fs-sm">@app.WorkerName</h6>
                                                <p class="text-muted fs-xxs mb-0 line-clamp-1">for @app.TaskTitle</p>
                                            </div>
                                            <a asp-controller="Application" asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-light border-0 px-2 py-0"><i class="bi bi-chevron-right fs-xs"></i></a>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted smaller">No new applications to review.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="lm-card p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Manage Posted Tasks</h5>
                    <a asp-controller="Task" asp-action="MyTasks" class="text-primary smaller fw-bold text-decoration-none">Control Panel</a>
                </div>
                @if (posterTasks.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light-soft">
                                <tr>
                                    <th class="ps-3 border-0 smaller fw-bold text-muted">TASK</th>
                                    <th class="border-0 smaller fw-bold text-muted">BUDGET</th>
                                    <th class="border-0 smaller fw-bold text-muted">STATUS</th>
                                    <th class="text-end pe-3 border-0 smaller fw-bold text-muted">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in posterTasks.Take(5))
                                {
                                    <tr class="transition">
                                        <td class="ps-3 py-3 border-0">
                                            <div class="fw-bold fs-sm text-dark line-clamp-1" style="max-width: 250px;">@task.Title</div>
                                        </td>
                                        <td class="py-3 border-0">
                                            <span class="fw-bold text-success fs-sm">@task.Budget.ToString("C0")</span>
                                        </td>
                                        <td class="py-3 border-0">
                                            <span class="badge bg-@(GetTaskStatusColor(task.Status))-soft text-@(GetTaskStatusColor(task.Status)) fs-xxs">@task.Status</span>
                                        </td>
                                        <td class="text-end pe-3 py-3 border-0">
                                            <a asp-controller="Task" asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-white border px-3 fw-bold fs-xxs">Manage</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <p class="text-muted smaller mb-3">You haven't posted any tasks yet.</p>
                        <a asp-controller="Task" asp-action="Create" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm">Post Your First Task</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBookingStatusColor(LaborDAL.Enums.BookingStatus status) => status switch {
        LaborDAL.Enums.BookingStatus.Scheduled => "primary",
        LaborDAL.Enums.BookingStatus.InProgress => "warning",
        LaborDAL.Enums.BookingStatus.Completed => "success",
        LaborDAL.Enums.BookingStatus.Cancelled => "danger",
        _ => "secondary"
    };

    string GetApplicationStatusColor(LaborDAL.Enums.ApplicationStatus status) => status switch {
        LaborDAL.Enums.ApplicationStatus.Pending => "warning",
        LaborDAL.Enums.ApplicationStatus.Accepted => "success",
        LaborDAL.Enums.ApplicationStatus.Rejected => "danger",
        _ => "secondary"
    };

    string GetTaskStatusColor(LaborDAL.Enums.TaskStatus status) => status switch {
        LaborDAL.Enums.TaskStatus.Open => "success",
        LaborDAL.Enums.TaskStatus.Assigned => "info",
        LaborDAL.Enums.TaskStatus.InProgress => "warning",
        _ => "secondary"
    };
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Worker Chart
            const workerCtx = document.getElementById('workerEarningsChart').getContext('2d');
            new Chart(workerCtx, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Earnings',
                        data: [120, 150, 80, 200, 180, 250, 220],
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.05)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 4,
                        pointBackgroundColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)', drawBorder: false }, ticks: { font: { size: 10 } } },
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });

            // Poster Chart
            let posterChart = null;
            document.getElementById('poster-tab').addEventListener('shown.bs.tab', function () {
                if (posterChart) return;
                const posterCtx = document.getElementById('posterEngagementChart').getContext('2d');
                posterChart = new Chart(posterCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            label: 'Applications',
                            data: [5, 12, 8, 15, 10, 20, 14],
                            backgroundColor: 'rgba(46, 213, 115, 0.4)',
                            borderColor: '#2ed573',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)', drawBorder: false }, ticks: { font: { size: 10 } } },
                            x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                        }
                    }
                });
            });
        });
    </script>
}
