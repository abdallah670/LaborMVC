@model dynamic
@{
    ViewData["Title"] = "Admin Dashboard";
    var recentUsers = ViewBag.RecentUsers as List<LaborDAL.Entities.AppUser> ?? new List<LaborDAL.Entities.AppUser>();
    var recentTasks = ViewBag.RecentTasks as List<LaborBLL.ModelVM.TaskListViewModel> ?? new List<LaborBLL.ModelVM.TaskListViewModel>();
    bool isWorker = User.IsInRole("Worker");
    bool isPoster = User.IsInRole("Poster");
}

@section Styles {
    <style>
        .hover-primary:hover {
            background-color: var(--lm-primary) !important;
            color: white !important;
            border-color: var(--lm-primary) !important;
        }
    </style>
}

<div class="dashboard-container fade-in py-4">
    <!-- Premium Dashboard Header -->
    <div class="lm-dashboard-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger-soft text-danger text-uppercase fs-xs fw-bold px-2 py-1">System Administration</span>
                @if (isWorker && isPoster)
                {
                    <a asp-action="Combined" class="badge bg-light text-muted text-uppercase fs-xs fw-bold px-2 py-1 text-decoration-none hover-primary">Switch to Combined</a>
                }
                else if (isWorker)
                {
                    <a asp-action="Worker" class="badge bg-light text-muted text-uppercase fs-xs fw-bold px-2 py-1 text-decoration-none hover-primary">Switch to Worker</a>
                }
                else if (isPoster)
                {
                    <a asp-action="Poster" class="badge bg-light text-muted text-uppercase fs-xs fw-bold px-2 py-1 text-decoration-none hover-primary">Switch to Poster</a>
                }
            </div>
            <h1 class="lm-dashboard-title">Platform Overview</h1>
            <p class="text-muted mb-0">Monitor system health, user activity, and financial performance.</p>
        </div>
    </div>

    <!-- Platform Stats Grid (2x4) -->
    <div class="lm-stat-grid mb-4" style="grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));">
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Total Users", ViewBag.TotalUsers?.ToString() ?? "0", "bi-people", "primary"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Workers", ViewBag.TotalWorkers?.ToString() ?? "0", "bi-person-workspace", "info"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Posters", ViewBag.TotalPosters?.ToString() ?? "0", "bi-person-up", "success"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Active Tasks", ViewBag.ActiveTasks?.ToString() ?? "0", "bi-clipboard-check", "warning"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Pending Verification", ViewBag.PendingVerifications?.ToString() ?? "0", "bi-shield-check", "danger"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Total Bookings", ViewBag.TotalBookings?.ToString() ?? "0", "bi-calendar3", "primary"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Revenue", ((decimal?)(ViewBag.TotalRevenue ?? 0m))?.ToString("C0") ?? "$0", "bi-currency-dollar", "success"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Completed", ViewBag.CompletedBookings?.ToString() ?? "0", "bi-check-circle", "info"))
    </div>

    <div class="row g-4 mb-4">
        <!-- Platform Growth Chart -->
        <div class="col-lg-8">
            <div class="lm-card lm-chart-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Platform Growth</h5>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-light-soft text-primary fw-bold px-3 border-0 active">Users</button>
                        <button class="btn btn-light px-3 border-0">Revenue</button>
                    </div>
                </div>
                <div class="lm-chart-container">
                    <canvas id="growthChart"></canvas>
                </div>
            </div>
        </div>

        <!-- System Management / Quick Actions -->
        <div class="col-lg-4">
            <div class="lm-card h-100">
                <h5 class="fw-bold mb-4">System Management</h5>
                <div class="row g-2">
                    <div class="col-6">
                        <a asp-controller="Admin" asp-action="Users" class="btn btn-light w-100 py-3 d-flex flex-column align-items-center gap-2 border-0 hover-primary-soft transition">
                            <i class="bi bi-people fs-4 text-primary"></i>
                            <span class="smaller fw-bold">Manage Users</span>
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-controller="Admin" asp-action="Verifications" class="btn btn-light w-100 py-3 d-flex flex-column align-items-center gap-2 border-0 hover-danger-soft transition position-relative">
                            <i class="bi bi-shield-check fs-4 text-danger"></i>
                            <span class="smaller fw-bold">Verifications</span>
                            @if (ViewBag.PendingVerifications > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 10px;">
                                    @ViewBag.PendingVerifications
                                </span>
                            }
                        </a>
                    </div>
                   
                    <div class="col-6">
                        <a asp-controller="Task" asp-action="Index" class="btn btn-light w-100 py-3 d-flex flex-column align-items-center gap-2 border-0 hover-warning-soft transition">
                            <i class="bi bi-clipboard fs-4 text-warning"></i>
                            <span class="smaller fw-bold">Monitor Tasks</span>
                        </a>
                    </div>
                </div>
                
                <div class="mt-4 p-3 bg-light-soft rounded-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-info-circle-fill text-primary"></i>
                        <span class="fw-bold fs-xs">System Health</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center smaller mb-1">
                        <span class="text-muted">Database</span>
                        <span class="text-success fw-bold"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Operational</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center smaller">
                        <span class="text-muted">Payment Gateway</span>
                        <span class="text-success fw-bold"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Operational</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Users -->
        <div class="col-lg-6">
            <div class="lm-card p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light-soft">
                    <h5 class="fw-bold mb-0">New Registrations</h5>
                    <a asp-controller="Admin" asp-action="Users" class="text-primary smaller fw-bold text-decoration-none">Review All</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (recentUsers.Any())
                    {
                        @foreach (var user in recentUsers)
                        {
                            <div class="list-group-item bg-transparent px-3 py-3 hover-light transition border-0 border-bottom-dashed">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary-soft text-primary rounded-circle me-3 d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                            @(user.FirstName?[0] ?? '?')
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold fs-sm">@user.FirstName @user.LastName</h6>
                                            <p class="text-muted fs-xxs mb-0">@user.Email</p>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-@(user.IDVerified ? "success" : "warning")-soft text-@(user.IDVerified ? "success" : "warning") fs-xxs">
                                            @(user.IDVerified ? "Verified" : "Pending")
                                        </span>
                                        <div class="text-muted fs-xxs mt-1">@user.CreatedAt.ToString("MMM dd")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted smaller">No recent users.</div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Tasks -->
        <div class="col-lg-6">
            <div class="lm-card p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light-soft">
                    <h5 class="fw-bold mb-0">Platform Activity</h5>
                    <a asp-controller="Task" asp-action="Index" class="text-primary smaller fw-bold text-decoration-none">Monitor All</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (recentTasks.Any())
                    {
                        @foreach (var task in recentTasks)
                        {
                            <div class="list-group-item bg-transparent px-3 py-3 hover-light transition border-0 border-bottom-dashed">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="d-flex flex-column">
                                        <h6 class="mb-1 fw-bold fs-sm">@task.Title</h6>
                                        <p class="text-muted fs-xxs mb-0"><i class="bi bi-tag me-1"></i>@task.Category | <strong class="text-primary">@task.Budget.ToString("C")</strong></p>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-@(GetTaskStatusColor(task.Status))-soft text-@(GetTaskStatusColor(task.Status)) fs-xxs">@task.Status</span>
                                        <div class="text-muted fs-xxs mt-1">@task.CreatedAt.ToString("MMM dd")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted smaller">No recent tasks.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetTaskStatusColor(LaborDAL.Enums.TaskStatus status)
    {
        return status switch
        {
            LaborDAL.Enums.TaskStatus.Open => "success",
            LaborDAL.Enums.TaskStatus.Accepted => "info",
            LaborDAL.Enums.TaskStatus.InProgress => "warning",
            LaborDAL.Enums.TaskStatus.Completed => "primary",
            _ => "secondary"
        };
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('growthChart').getContext('2d');
            
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [{
                        label: 'New Users',
                        data: [50, 120, 180, 240, 310, 450],
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.05)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 0
                    }, {
                        label: 'Tasks Posted',
                        data: [30, 80, 150, 200, 280, 400],
                        borderColor: '#2ed573',
                        backgroundColor: 'transparent',
                        fill: false,
                        tension: 0.4,
                        borderWidth: 3,
                        borderDash: [5, 5],
                        pointRadius: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, font: { size: 11 } } }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)', drawBorder: false }, ticks: { font: { size: 10 } } },
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        });
    </script>
}
