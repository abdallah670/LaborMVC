@{
    ViewData["Title"] = "Poster Dashboard";
    var tasks = ViewBag.Tasks as List<LaborBLL.ModelVM.TaskListViewModel> ?? new List<LaborBLL.ModelVM.TaskListViewModel>();
    var applications = ViewBag.Applications as List<LaborBLL.ModelVM.TaskApplicationViewModel> ?? new List<LaborBLL.ModelVM.TaskApplicationViewModel>();
    var bookings = ViewBag.Bookings as List<LaborBLL.ModelVM.BookingDashboardViewModel> ?? new List<LaborBLL.ModelVM.BookingDashboardViewModel>();
}

<div class="dashboard-container fade-in">
    <!-- Welcome Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-clipboard-data me-2"></i>Poster Dashboard</h2>
            <p class="text-muted mb-0">Manage your tasks, review applications, and track bookings</p>
        </div>
        <a asp-controller="Task" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Post New Task
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">@ViewBag.TotalTasks</h3>
                            <small>Total Tasks</small>
                        </div>
                        <i class="bi bi-clipboard-list fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">@ViewBag.ActiveTasks</h3>
                            <small>Active Tasks</small>
                        </div>
                        <i class="bi bi-lightning fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">@ViewBag.PendingApplications</h3>
                            <small>Pending Applications</small>
                        </div>
                        <i class="bi bi-person-plus fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">@ViewBag.ActiveBookings</h3>
                            <small>Active Bookings</small>
                        </div>
                        <i class="bi bi-calendar-check fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- My Tasks Section -->
        <div class="col-lg-6">
            <div class="card shadow h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-clipboard me-2"></i>My Tasks</h5>
                    <a asp-controller="Task" asp-action="MyTasks" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (tasks.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var task in tasks)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <h6 class="mb-0">@task.Title</h6>
                                                <span class="badge bg-@(GetTaskStatusColor(task.Status))">@task.Status</span>
                                            </div>
                                            <p class="mb-1 text-muted small">
                                                <i class="bi bi-cash me-1"></i>@task.Budget.ToString("C")
                                                <span class="mx-1">|</span>
                                                <i class="bi bi-geo-alt me-1"></i>@task.Location
                                            </p>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <a asp-controller="Task" asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Details
                                        </a>
                                        @if (task.Status == LaborDAL.Enums.TaskStatus.Open)
                                        {
                                            <a asp-controller="Application" asp-action="ByPoster" asp-route-taskId="@task.Id" class="btn btn-sm btn-outline-success ms-1">
                                                <i class="bi bi-people me-1"></i>Applications
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-clipboard-x fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No tasks posted yet</p>
                            <a asp-controller="Task" asp-action="Create" class="btn btn-primary btn-sm">Post Your First Task</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Pending Applications Section -->
        <div class="col-lg-6">
            <div class="card shadow h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Pending Applications</h5>
                    <a asp-controller="Application" asp-action="ByPoster" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (applications.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var app in applications)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@app.TaskTitle</h6>
                                            <p class="mb-1 text-muted small">
                                                <i class="bi bi-person me-1"></i>@app.WorkerName
                                                <span class="mx-1">|</span>
                                                <i class="bi bi-cash me-1"></i>@app.ProposedBudget.ToString("C")
                                            </p>
                                            @if (!string.IsNullOrEmpty(app.Message))
                                            {
                                                <p class="mb-1 text-muted small text-truncate">
                                                    <i class="bi bi-chat-left-text me-1"></i>@app.Message
                                                </p>
                                            }
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <a asp-controller="Application" asp-action="ByPoster" asp-route-taskId="@app.TaskId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-check-circle me-1"></i>Review
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No pending applications</p>
                            <p class="text-muted small">Applications from workers will appear here</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Active Bookings Section -->
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-calendar3 me-2"></i>Active Bookings</h5>
                    <a asp-controller="Booking" asp-action="Dashboard" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (bookings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>User</th>
                                        <th>Agreed Rate</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in bookings)
                                    {
                                        <tr>
                                            <td>#@booking.Id</td>
                                            <td>@booking.UserName</td>
                                            <td>@booking.AgreedRate.ToString("C")</td>
                                            <td>@(booking.StartTime?.ToString("MMM dd, yyyy") ?? "Not set")</td>
                                            <td>
                                                <span class="badge bg-@(GetBookingStatusColor(booking.Status))">@booking.Status</span>
                                            </td>
                                            <td>
                                                <a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye me-1"></i>Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-calendar-x fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No active bookings</p>
                            <p class="text-muted small">Bookings will appear when you accept worker applications</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetTaskStatusColor(LaborDAL.Enums.TaskStatus status)
    {
        return status switch
        {
            LaborDAL.Enums.TaskStatus.Open => "success",
            LaborDAL.Enums.TaskStatus.Assigned => "info",
            LaborDAL.Enums.TaskStatus.InProgress => "warning",
            LaborDAL.Enums.TaskStatus.Completed => "primary",
            LaborDAL.Enums.TaskStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    string GetBookingStatusColor(LaborDAL.Enums.BookingStatus status)
    {
        return status switch
        {
            LaborDAL.Enums.BookingStatus.Scheduled => "primary",
            LaborDAL.Enums.BookingStatus.InProgress => "warning",
            LaborDAL.Enums.BookingStatus.Completed => "success",
            LaborDAL.Enums.BookingStatus.Cancelled => "danger",
            LaborDAL.Enums.BookingStatus.Disputed => "dark",
            _ => "secondary"
        };
    }
}
