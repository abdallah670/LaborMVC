@{
    ViewData["Title"] = "Worker Dashboard";
    var bookings = ViewBag.Bookings as List<LaborBLL.ModelVM.BookingDashboardViewModel> ?? new List<LaborBLL.ModelVM.BookingDashboardViewModel>();
    var applications = ViewBag.Applications as List<LaborBLL.ModelVM.TaskApplicationViewModel> ?? new List<LaborBLL.ModelVM.TaskApplicationViewModel>();
    var availableTasks = ViewBag.AvailableTasks as List<LaborBLL.ModelVM.TaskListViewModel> ?? new List<LaborBLL.ModelVM.TaskListViewModel>();
}

<div class="dashboard-container fade-in">
    <!-- Welcome Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-person-workspace me-2"></i>Worker Dashboard</h2>
            <p class="text-muted mb-0">Manage your work, applications, and bookings</p>
        </div>
        <a asp-controller="Task" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-search me-1"></i>Browse Tasks
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">@ViewBag.TotalBookings</h3>
                            <small>Total Bookings</small>
                        </div>
                        <i class="bi bi-calendar-check fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">@ViewBag.ActiveBookings</h3>
                            <small>Active</small>
                        </div>
                        <i class="bi bi-clock-history fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">@ViewBag.CompletedBookings</h3>
                            <small>Completed</small>
                        </div>
                        <i class="bi bi-check-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">@ViewBag.PendingApplications</h3>
                            <small>Pending Applications</small>
                        </div>
                        <i class="bi bi-file-earmark-text fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- My Bookings Section -->
        <div class="col-lg-6">
            <div class="card shadow h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-calendar3 me-2"></i>My Bookings</h5>
                    <a asp-controller="Booking" asp-action="Dashboard" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (bookings.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var booking in bookings)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">Booking #@booking.Id</h6>
                                            <p class="mb-1 text-muted small">
                                                <i class="bi bi-calendar me-1"></i>@booking.StartTime?.ToString("MMM dd, yyyy")
                                            </p>
                                        </div>
                                        <span class="badge bg-@(GetBookingStatusColor(booking.Status))">@booking.Status</span>
                                    </div>
                                    <div class="mt-2">
                                        <a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Details
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No bookings yet</p>
                            <a asp-controller="Task" asp-action="Index" class="btn btn-primary btn-sm">Find Tasks</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- My Applications Section -->
        <div class="col-lg-6">
            <div class="card shadow h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>My Applications</h5>
                    <a asp-controller="Application" asp-action="ByWorker" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (applications.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var app in applications)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@app.TaskTitle</h6>
                                            <p class="mb-1 text-muted small">
                                                <i class="bi bi-cash me-1"></i>@app.ProposedBudget.ToString("C")
                                                <span class="mx-1">|</span>
                                                <i class="bi bi-clock me-1"></i>@app.CreatedAt.ToString("MMM dd")
                                            </p>
                                        </div>
                                        <span class="badge bg-@(GetApplicationStatusColor(app.Status))">@app.Status</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-file-earmark-x fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No applications yet</p>
                            <a asp-controller="Task" asp-action="Index" class="btn btn-primary btn-sm">Browse Tasks</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Available Tasks Section -->
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Available Tasks</h5>
                    <a asp-controller="Task" asp-action="Index" class="btn btn-sm btn-outline-primary">Browse All</a>
                </div>
                <div class="card-body">
                    @if (availableTasks.Any())
                    {
                        <div class="row g-3">
                            @foreach (var task in availableTasks)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="badge bg-@(GetTaskCategoryColor(task.Category))">@task.Category</span>
                                                @if (task.IsUrgent)
                                                {
                                                    <span class="badge bg-danger">Urgent</span>
                                                }
                                            </div>
                                            <h6 class="card-title">@task.Title</h6>
                                            <p class="card-text text-muted small text-truncate">@task.Description</p>
                                            <div class="d-flex justify-content-between align-items-center mt-3">
                                                <span class="text-primary fw-bold">@task.Budget.ToString("C")</span>
                                                <a asp-controller="Task" asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-primary">View</a>
                                            </div>
                                        </div>
                                        <div class="card-footer bg-transparent border-0 text-muted small">
                                            <i class="bi bi-geo-alt me-1"></i>@task.Location
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-search fs-1 text-muted"></i>
                            <p class="text-muted mt-2">No tasks available at the moment</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBookingStatusColor(LaborDAL.Enums.BookingStatus status)
    {
        return status switch
        {
            LaborDAL.Enums.BookingStatus.Scheduled => "primary",
            LaborDAL.Enums.BookingStatus.InProgress => "warning",
            LaborDAL.Enums.BookingStatus.Completed => "success",
            LaborDAL.Enums.BookingStatus.Cancelled => "danger",
            LaborDAL.Enums.BookingStatus.Disputed => "dark",
            _ => "secondary"
        };
    }

    string GetApplicationStatusColor(LaborDAL.Enums.ApplicationStatus status)
    {
        return status switch
        {
            LaborDAL.Enums.ApplicationStatus.Pending => "warning",
            LaborDAL.Enums.ApplicationStatus.Accepted => "success",
            LaborDAL.Enums.ApplicationStatus.Rejected => "danger",
            LaborDAL.Enums.ApplicationStatus.Withdrawn => "secondary",
            _ => "secondary"
        };
    }

    string GetTaskCategoryColor(LaborDAL.Enums.TaskCategory category)
    {
        return category switch
        {
            LaborDAL.Enums.TaskCategory.Cleaning => "success",
            LaborDAL.Enums.TaskCategory.Moving => "primary",
            LaborDAL.Enums.TaskCategory.Repair => "warning",
            LaborDAL.Enums.TaskCategory.Gardening => "info",
            LaborDAL.Enums.TaskCategory.Painting => "danger",
            LaborDAL.Enums.TaskCategory.Plumbing => "primary",
            LaborDAL.Enums.TaskCategory.Electrical => "warning",
            _ => "secondary"
        };
    }
}
