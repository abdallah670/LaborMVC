@model LaborBLL.ModelVM.WorkerDashboardViewModel
@{
    ViewData["Title"] = "Worker Dashboard";
    bool isPoster = User.IsInRole("Poster");
}

<div class="dashboard-container fade-in py-4">
    <!-- Premium Dashboard Header -->
    <div class="lm-dashboard-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-soft text-primary text-uppercase fs-xs fw-bold px-2 py-1">Worker Mode</span>
                @if (isPoster)
                {
                    <a asp-action="Poster" class="badge bg-light text-muted text-uppercase fs-xs fw-bold px-2 py-1 text-decoration-none hover-primary">Switch to Poster</a>
                }
            </div>
            <h1 class="lm-dashboard-title">Welcome back, @User.Identity.Name!</h1>
            <p class="text-muted mb-0">Here's your work overview and upcoming schedule.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Task" asp-action="Index" class="btn btn-primary lg shadow-sm">
                <i class="bi bi-search me-2"></i>Find New Tasks
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="lm-stat-grid mb-4">
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Total Bookings", Model.TotalBookings.ToString(), "bi-calendar-check", "primary"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Active Now", Model.ActiveBookings.ToString(), "bi-clock-history", "warning"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Completed", Model.CompletedBookings.ToString(), "bi-check-circle", "success"))
        @await Html.PartialAsync("_StatCard", new LaborPL.Models.StatCardViewModel("Pending Apps", Model.PendingApplications.ToString(), "bi-file-earmark-text", "info"))
    </div>

    <div class="row g-4 mb-4">
        <!-- Work Activity Chart -->
        <div class="col-lg-8">
            <div class="lm-card lm-chart-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Work Activity</h5>
                    <div class="dropdown">
                        <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                            <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                        </ul>
                    </div>
                </div>
                <div class="lm-chart-container">
                    <canvas id="workActivityChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Quick Notifications / Recent Feed -->
        <div class="col-lg-4">
            <div class="lm-card h-100 p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Upcoming Tasks</h5>
                    <a asp-controller="Booking" asp-action="Dashboard" class="text-primary smaller fw-bold text-decoration-none">View All</a>
                </div>
                <div class="p-0">
                    @if (Model.RecentBookings.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var booking in Model.RecentBookings.Take(4))
                            {
                                <div class="list-group-item bg-transparent border-0 px-3 py-3 hover-light transition">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="mb-0 fw-bold">Booking #@booking.Id</h6>
                                        <span class="badge bg-@booking.Status.GetBadgeColor()-soft text-@booking.Status.GetBadgeColor() fs-xxs">@booking.Status</span>
                                    </div>
                                    <p class="text-muted smaller mb-2">
                                        <i class="bi bi-calendar-event me-1"></i> @(booking.StartTime?.ToString("MMM dd, hh:mm tt") ?? "TBD")
                                    </p>
                                    <a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-light w-100 fs-xxs fw-bold py-1">
                                        Open Details
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="bg-light rounded-circle d-inline-flex p-3 mb-3">
                                <i class="bi bi-calendar-x text-muted fs-3"></i>
                            </div>
                            <p class="text-muted smaller mb-0 px-4">No upcoming bookings. Start applying to tasks!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- My Applications Section -->
        <div class="col-lg-12">
            <div class="lm-card p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light-soft">
                    <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2"></i>My Recent Applications</h5>
                    <a asp-controller="Application" asp-action="ByWorker" class="btn btn-white btn-sm border fw-bold px-3">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted smaller uppercase fw-bold">
                            <tr>
                                <th class="ps-3">Task Title</th>
                                <th>Proposed Budget</th>
                                <th>Date Applied</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="smaller">
                            @if (Model.RecentApplications.Any())
                            {
                                @foreach (var app in Model.RecentApplications)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">@app.TaskTitle</td>
                                        <td><span class="text-primary fw-bold">@app.ProposedBudget.ToString("C")</span></td>
                                        <td class="text-muted">@app.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge bg-@app.Status.GetBadgeColor()-soft text-@app.Status.GetBadgeColor()">@app.Status</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <button class="btn btn-link text-primary p-0 fw-bold decoration-none">View</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No applications found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Available Tasks Section -->
        <div class="col-12 mt-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Recommended for You</h4>
                <a asp-controller="Task" asp-action="Index" class="text-primary fw-bold text-decoration-none">Explore More <i class="bi bi-arrow-right"></i></a>
            </div>
            @if (Model.AvailableTasks.Any())
            {
                <div class="row g-3">
                    @foreach (var task in Model.AvailableTasks.Take(3))
                    {
                        <div class="col-md-6 col-lg-4">
                            @await Html.PartialAsync("_TaskCard", task)
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="lm-card text-center py-5">
                    <i class="bi bi-search fs-1 text-muted opacity-25"></i>
                    <p class="text-muted mt-2">Check back later for new tasks!</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('workActivityChart').getContext('2d');
            
            // Generate some dummy data for the chart based on the model if needed
            // For now using placeholder distribution
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Earnings ($)',
                        data: [45, 90, 60, 120, 80, 150, 100],
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.05)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 4,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#0d6efd',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.05)', drawBorder: false },
                            ticks: { font: { size: 11 }, color: '#999' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11 }, color: '#999' }
                        }
                    }
                }
            });
        });
    </script>
}

